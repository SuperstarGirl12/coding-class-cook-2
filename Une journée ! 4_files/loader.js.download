oogleana-G3mMR3TH","name":"Google Analytics","policyUrl":"https://policies.google.com/privacy?hl=en-US","purposeIds":["cookies"],"legIntPurposeIds":[],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[],"namespaces":{"num":9106}},{"id":"atinterne-GwxdBPZj","didomiId":"atinterne-GwxdBPZj","name":"AT Internet","policyUrl":"https://www.atinternet.com/rgpd-et-vie-privee/","purposeIds":[],"legIntPurposeIds":["lescookie-MUeBLLTH"],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[],"namespaces":{"num":10820}},{"id":"ab-tasty-limited","didomiId":"abtastyt-6AkzzHiJ","name":"AB Tasty","policyUrl":"https://www.abtasty.com/terms-of-use/","purposeIds":["select_personalized_content"],"legIntPurposeIds":[],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[],"namespaces":{"num":11041}}],"google":{"fullATP":false}},"privacyPolicyURL":"http://www.tv5monde.com/cms/chaine-francophone/tv5monde/p-26356-Mentions-legales-et-Conditions-generales-d-utilisation.htm","essentialPurposes":["lescookie-MUeBLLTH"],"gdprAppliesGlobally":true,"gdprAppliesWhenUnknown":false,"apiKey":"15c76611-8405-4583-89f6-d419ebe34df8","customPurposes":[{"id":"audiencem-xedeU2gQ","name":{"ar":"قياس الجمهور","bg":"Измерването на аудиторията","ca":"Mesura de l'audiència","cs":"Měření návštěvnosti","da":"Publikumsmåling","de":"Reichweitenmessung","el":"Μέτρηση κοινού","en":"Audience Measurement","es":"Medición de la audiencia","et":"Külastajaskonna mõõtmine","fi":"Yleisön mittaus","fr":"Mesure d'audience","he":"מדידת קהל","hr":"Procjena publike","hu":"Közönségmérés","id":"Asesmen Audiens","it":"Misurazione del pubblico.","ja":"オーディエンス測定","ko":"시청자 측정","lt":"Auditorijos matavimas","lv":"Auditorijas mērījumi","ms":"Pengukuran Audiens","nl":"Publieksmeting","no":"Publikumsmålinger","pl":"Pomiar audytorium","pt":"Medição de públicos-alvo","ro":"Măsurarea audienței","ru":"Измерение показателей аудитории","sk":"Meranie publika","sl":"Merjenje občinstva","sr":"Мерење публике","sv":"Användarmätning","sw":"Kipimo cha Hadhira","th":"การวัดผลผู้ชม","tr":"İzleyici Ölçümü","uk":"Вимірювання показників аудиторії","vi":"Đo lường Đối tượng","fil":"Pagsukat ng Audience","ar-JO":"قياس الجمهور","az-AZ":"İzləyici Ölçümü","bn-IN":"অডিয়েন্স মেজারমেন্ট","de-AT":"Zielgruppenmessung","de-CH":"Zielgruppenmessung","en-NZ":"Audience Measurement","fr-BE":"Mesure de l'audience","fr-CA":"Audimétrie","hi-IN":"ऑडियंस का मापन","mk-MK":"Мерење на бројот на посетители","nl-BE":"Publieksmetingen","pt-BR":"Análise do público-alvo","zh-CN":"受众测量","zh-TW":"受眾計量"},"description":{"ar":"يتيح لك قياس الجمهور جمع المعلومات الإحصائية عن بيانات زيارات الموقع لتحسين تجربة المستخدم وأداء الموقع.","bg":"Измерването на аудиторията позволява да събирате статистическа информация за данните за трафика с цел подобряване на потребителското изживяване и ефективността на сайта.","ca":"La mesura de l'audiència us permet recollir informació estadística sobre el trànsit de dades per poder millorar l'experiència de l'usuari i el rendiment del lloc.","cs":"Měření návštěvnosti vám umožňuje shromažďovat statistické informace týkající se údajů o provozu za účelem zlepšení uživatelské zkušenosti a výkonu webu.","da":"Publikumsmåling giver dig mulighed for at indsamle statistiske oplysninger om trafikdata for at forbedre brugeroplevelsen og sitets præstationer.","de":"Reichweitenmessung ermöglicht es statistische Informationen über Datenflüsse zu sammeln, um damit das Benutzererlebnis auf einer Webseite und die Performanz derselben zu verbessern.","el":"Η μέτρηση κοινού σάς επιτρέπει τη συγκέντρωση στατιστικών στοιχείων για τα δεδομένα κίνησης προκειμένου να βελτιωθεί η εμπειρία χρήστη και οι επιδόσεις του ιστότοπου.","en":"Audience measurement enables you to collect statistical information on traffic data in order to improve user experience and site performance.","es":"El seguimiento de la audiencia permite recoger datos estadísticos sobre el tráfico para mejorar la experiencia del usuario y las performancias del sitio.","et":"Külastajaskonna mõõtmine lubab koguda statistilist teavet liiklusandmete kohta, et parandada kasutuskogemust ja saidi toimivust","fi":"Yleisön mittauksen avulla voit kerätä tilastotietoja kävijädatasta parantaaksesi käyttökokemusta sekä sivuston tehokkuutta.","fr":"Le suivi d'audience permet de collecter des données statistiques de fréquentation afin d'améliorer l'expérience utilisateur et les performances du site.","he":"מדידת הקהל מאפשרת לך לאסוף מידע סטטיסטי על נתוני התעבורה על מנת לשפר את חוויית המשתמש וביצועי האתר.","hr":"Procjena publike omogućuje vam prikupljanje statističkih podataka o prometu radi unaprjeđenja korisničkog iskustva i performansi web-stranice.","hu":"A közönségmérés lehetővé teszi önnek az adatforgalomra vonatkozó statisztikai adatok gyűjtését a felhasználói élmény és a teljesítmény fokozása érdekében.","id":"Dengan asesmen audiens, Anda dapat menghimpun informasi statistik tentang data lalu lintas untuk meningkatkan pengalaman pengguna dan performa situs.","it":"La misurazione del pubblico consente di raccogliere informazioni statistiche sui dati di traffico per il miglioramento dell'esperienza di utilizzo e delle prestazioni del sito.","ja":"オーディエンス測定を使用すると、トラフィックデータに関する統計情報を収集して、ユーザーエクスペリエンスとサイトのパフォーマンスを向上させることができます。","ko":"시청자 측정을 통해 트래픽 데이터에 대한 통계 정보를 수집하여 사용자 경험과 사이트 성능을 향상시킬 수 있습니다.","lt":"Naudodamiesi auditorijos matavimu, galėsite rinkti statistinę informaciją apie eismo duomenis, kad pagerintumėte naudotojo patirtį ir svetainės veikimo savybes.","lv":"Auditorijas mērījumi ļauj jums ievākt statistikas datums par datu plūsmu, lai uzlabotu lietotāju pieredzi un vietnes veiktspēju.","ms":"Pengukuran audiens membolehkan anda untuk mengumpul maklumat statistik mengenai data trafik untuk menambah baik pengalaman pengguna dan prestasi laman.","nl":"Met publieksmeting kunt u statistische verkeersgegevens verzamelen om de gebruikservaring en de prestaties van de website te verbeteren.","no":"Publikumsmålinger lar deg samle statistikk om trafikken på nettstedet og i appen, og kan være nyttig for å gjøre brukeropplevelsen og ytelsen bedre.","pl":"Pomiar audytorium pozwala na zbieranie informacji statystycznych o ruchu. Pomaga to w ulepszaniu działania strony oraz poprawiania wrażeń z jej użytkowania.","pt":"A medição de públicos-alvo permite-lhe recolher informações estatísticas sobre os dados de tráfego para melhorar a experiência do utilizador e o desempenho do site.","ro":"Măsurarea audienței vă permite să colectați informații statistice despre traficul de date pentru a îmbunătăți experiența utilizatorilor și performanța site-ului.","ru":"Измерение показателей аудитории позволяет собирать статистические данные о трафике и совершенствовать интерфейс и производительность сайта.","sk":"Meranie publika vám umožňuje zhromažďovať štatistické informácie týkajúce sa údajov o návštevnosti a zlepšovať tak dojem používateľa a výkonnosť webu.","sl":"Merjenje občinstva vam omogoča zbiranje statističnih informacij o podatkih prometa za izboljšanje uporabniške izkušnje in delovanja strani.","sr":"Мерење публике вам омогућује прукупљање статистичких информација везаних за податке о саобраћају у циљу побољшања корисничког искуства и перформанси сајта.","sv":"Användarmätning gör att du kan inhämta statistiska uppgifter om trafikdata för att kunna förbättra användarupplevelsen och webbplatsens prestanda.","sw":"Kipimo cha hadhira kinakuwezesha ukusanye maelezo ya kitakwimu kuhusu data ya wanaotembelea ili uboreshe hali ya utumiaji na utendaji wa tovuti.","th":"การวัดผลผู้ชมช่วยให้คุณสามารถรวบรวมข้อมูลทางสถิติเกี่ยวกับข้อมูลการเข้าชม เพื่อปรับปรุงประสบการณ์ของผู้ใช้และประสิทธิภาพของไซต์","tr":"İzleyici ölçümü, kullanıcı deneyimini ve site performansını geliştirebilmeniz için trafik verileri ile ilgili istatistiksel bilgileri toplamanıza imkan tanır.","uk":"Вимірювання показників аудиторії дає змогу збирати статистичні відомості про трафік та вдосконалювати інтерфейс і продуктивність сайту.","vi":"Đo lường đối tượng cho phép bạn thu thập thông tin thống kê về dữ liệu lưu lượng truy cập để cải thiện trải nghiệm người dùng và hiệu suất trang web.","fil":"Nagbibigay-daan sa iyo ang pagsukat ng audience na mangolekta ng estadistikang impormasyon sa traffic data para pahusayin ang experience ng user at performance ng site.","ar-JO":"يساعدك قياس الجمهور على جمع المعلومات الإحصائية حول بيانات المرور لتحسين تجربة المستخدم وأداء الموقع.","az-AZ":"İzləyici ölçümü, istifadəçi təcrübəsini və saytın performansını yaxşılaşdırmaq üçün trafik məlumatları haqqında statistik məlumat toplamağa imkan verir.","bn-IN":"ব্যবহারকারীর অভিজ্ঞতা এবং সাইটের পারফরমেন্স উন্নত করার জন্য অডিয়েন্স মেজারমেন্ট আপনাকে ট্রাফিক ডেটার পরিসংখ্যানগত তথ্য সংগ্রহ করতে সাহায্য করে।","de-AT":"Mithilfe der Zielgruppenmessung lassen sich statistische Informationen über den Datenverkehr sammeln, um das Benutzererlebnis und die Leistung der Website zu verbessern.","de-CH":"Mithilfe der Zielgruppenmessung lassen sich statistische Informationen über den Datenverkehr sammeln, um das Benutzererlebnis und die Leistung der Website zu verbessern.","en-NZ":"Audience measurement enables you to collect statistical information on traffic data in order to improve user experience and site performance.","fr-BE":"Grâce à la mesure d'audience, vous pouvez recueillir des données statistiques sur les données afin d'améliorer l'expérience utilisateur et les performances du site","fr-CA":"L'audimétrie vous permet de recueillir des renseignements statistiques sur les données de trafic afin d'améliorer l'expérience de l'utilisateur et les performances du site.","hi-IN":"ऑडियंस मापन आपको ट्रैफिक डेटा पर स्टैटिस्टिकल जानकारी इकट्ठा करने में सक्षम बनाता है ताकि यूज़र के अनुभव और साइट परफॉर्मेंस में सुधार किया जा सके।","mk-MK":"Мерењето на бројот на посетители ви овозможува да собирате статистички информации за податоците за посетеноста со цел да се подобрат корисничкото искуство и перформансите на страницата.","nl-BE":"Met behulp van publieksmetingen kan u statistische informatie over verkeersgegevens verzamelen om de gebruikerservaring en websiteprestaties te verbeteren.","pt-BR":"A análise do público-alvo permite coletar informações estatísticas sobre os dados de tráfego para melhorar a experiência do usuário e o desempenho do site.","zh-CN":"受众测量让您可以收集流量数据的统计信息，从而优化用户体验和网站性能。","zh-TW":"「受眾計量」能為你收集有關流量數據的統計資訊，可協助改善用戶體驗及網站效能。"},"namespaces":{"num":8600}},{"id":"lescookie-MUeBLLTH","name":{"ar":"الميزات الأساسية","de":"Grundlegende Funktionen","en":"Essential features","es":"Funcionalidades esenciales","fr":"Fonctionnalités essentielles","ja":"必須機能","ko":"핵심 기능","pt":"Funcionalidades essenciais","ru":"Основные функции","vi":"Các chức năng chính"},"description":{"ar":"إنَّ ملفات تعريف الارتباط هذه ضرورية لتشغيل مواقع TV5MONDE الإلكترونية وتطبيقاتها على نحو سليم. وتشمل ملفات تعريف الارتباط وأدوات التتبُّع هذه، على سبيل المثال، ملفات تعريف الارتباط \"AT Internet\" التي تستفيد من استثناء الموافقة وتتيح قياس الزيارات لهذه المواقع الإلكترونية والتطبيقات؛ وملفات تعريف الارتباط الخاصة بأمان الكمبيوتر؛ وملفات تعريف الارتباط للمصادقة المطلوبة على المواقع الإلكترونية والتطبيقات التي تقدم هذه الميزات؛ وملفات تعريف الارتباط التي تتيح حفظ تفضيلاتك ذات الصلة بأدوات التتبُّع.","de":"Diese Cookies sind notwendig, damit die Webseiten und Anwendungen von TV5MONDE ordnungsgemäß funktionieren.  Diese Cookies und Tracker umfassen unter anderem: AT-Internet-Cookies, die keine ausdrückliche Zustimmung des Nutzers erfordern und die Messung der Besucherzahlen der jeweiligen Webseiten und Anwendungen ermöglichen; Sicherheitscookies; Authentifizierungscookies, die auf Webseiten und für Anwendungen benötigt werden, die eine solche Funktion anbieten und Cookies, die Ihre bevorzugten Einstellungen in Bezug auf das Webtracking speichern. ","en":"These cookies are needed for TV5MONDE websites and apps to work properly. These cookies and trackers include AT Internet cookies (which measure traffic to these websites and apps and don't need consent), IT security cookies, authentication cookies required by websites and apps that use authentication, and the cookie that stores your tracker preferences.","es":"Estas «cookies» son necesarias para el correcto funcionamiento de los sitios y las aplicaciones de TV5MONDE. Estas «cookies» y rastreadores incluyen, por ejemplo, las «cookies» de AT Internet, que están exentas de consentimiento y permiten medir el tráfico en estos sitios y aplicaciones, las «cookies» de seguridad informática, las «cookies» de autenticación necesarias en los sitios y aplicaciones que ofrecen esta funcionalidad, y la «cookie» que nos permite recordar sus preferencias relativas a los rastreadores.","fr":"Ces cookies sont nécessaires pour le bon fonctionnement des sites et applications de TV5MONDE. Ces cookies et traceurs incluent par exemple les cookies AT Internet, qui bénéficient d'une exemption de consentement et permettent de mesurer la fréquentation sur ces sites et applications, les cookies de sécurité informatique, les cookies d'authentification nécessaires sur les sites et applications proposant cette fonctionnalité et le cookie qui permet la mémorisation de vos préférences relatives aux traceurs. ","ja":"TV5MONDEのサイトおよびアプリケーションが正常に機能するために必要なCookieです。 これらのCookieとトラッキング機能には、たとえば、同意が免除され、これらのサイトとアプリケーションのトラフィックの測定を可能にするAT Internet Cookie、情報セキュリティCookie、この機能を提供するサイトとアプリケーション上で必要な認証Cookie、およびトラッキングに関連するあなたの設定を記憶するCookieが含まれます。","ko":"이 쿠키는 TV5MONDE 사이트와 앱을 정상적으로 이용하는 데 필요합니다. 이러한 쿠키 및 트래커에는 AT 인터넷 쿠키 등이 포함되어 있으며, 사용자 동의 면제의 혜택을 받습니다. 이와 같은 쿠키 및 트래커를 사용하면 당사 사이트 및 응용 프로그램 사용 빈도, 컴퓨터 보안 쿠키, 이러한 기능을 제공하는 사이트 및 응용 프로그램에 필요한 인증 쿠키 및 트래커와 관련된 사용자 설정을 기억하는 쿠키를 측정할 수 있습니다.","pt":"Os cookies são necessários para o bom funcionamento dos sites e aplicativos da TV5MONDE. Esses cookies e rastreadores incluem, por exemplo, cookies AT internos, que desfrutam de isenção de consentimento e permitem mensurar a frequência nesses sites e aplicativos, cookies de segurança digital, cookies de autenticação necessários nos sites e aplicativos que ofereçam essa funcionalidade, e cookies que permitem a memorização das suas preferências relativas aos rastreadores.","ru":"Файлы «cookie» необходимы для надлежащего функционирования сайтов и приложений TV5MONDE. Эти файлы «cookie» или идентификационные файлы включают, например, файлы «cookie» компании «AT Internet», для которых не требуется запрашивать согласие, и которые служат для анализа посещаемости сайтов и приложений, файлы «cookie» информационной безопасности, файлы «cookie» для аутентификации, необходимые на сайтах и приложениях, которые предлагают эту функцию, а также файлы «cookie», которые позволяют сохранить Ваши предпочтения в отношении идентификационных файлов.","vi":"Những cookie này là cần thiết cho các trang web và ứng dụng của TV5MONDE được hoạt động bình thường. Các cookie và thiết bị bao gồm như: cookie AT Internet mang ích lợi từ  việc miễn chấp thuận và cho phép tính toán lượng truy cập trên các trang web và ứng dụng, cookie bảo mật thông tin, cookie xác thực quan trọng trên các trang web và ứng dụng đề xuất sử dụng chức năng này và cookie cho phép lưu trữ các tùy chọn của bạn liên quan đến thiết bị."},"namespaces":{"num":3091}}],"deploymentId":"FMCCVDHZ","consentDuration":15811200,"deniedConsentDuration":5184000},"user":{"bots":{"consentRequired":false},"country":"SA","region":"02"},"theme":{"css":"#didomi-notice .didomi-notice__interior-border {\n    max-width: 1080px!important; margin: 0 auto!important; }\n\n#didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice.bottom, #didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice.bottom .didomi-notice__interior-border {\n    border-color: white !important;\n}\n\n\n#didomi-host #didomi-notice.didomi-regular-notice.shape-banner {\n    padding: 2em 2em; }\n\n#didomi-host h1, #didomi-host h2 {\n    margin-bottom: -8px; line-height: 1.3em !important ;\n}\n\n#didomi-host .didomi-notice-text b {\n    font-weight: 700;\n    font-size: 13px;\n    line-height: 22px;\n}\n\n#didomi-host #didomi-notice.didomi-regular-notice { font-size: 11px; }\ndidomi-notice-data-processing-title { font-size:11px !important; font-weight: 700; }\n\n#didomi-host .didomi-notice-data-processing-container {\n    padding-top: 0;\n    text-align: justify;\n    font-size: 11px;\n    line-height: 140%;\n}\n\n#didomi-host .didomi-notice-data-processing-container .didomi-notice-data-processing-list {\n    font-weight: normal;\n    color: #000;\n}\n\n#didomi-host #didomi-notice.didomi-regular-notice.shape-banner #buttons.multiple button { margin-right: 0; }\n\n#didomi-notice-agree-button span { color:white; text-transform: uppercase; }\n\n#didomi-host h2 { font-family: Roboto, Arial, sans-serif;     color: #000;\n}\n\n#didomi-notice-learn-more-button { text-transform: uppercase !important; margin-bottom: 0.5rem !important; }\n\n#didomi-notice-agree-button { border-radius: 6px !important; border-color: #005CA8 !important; border-width: 1px !important; margin-bottom: 0.5rem !important; }\n\n#didomi-notice-disagree-button { margin-bottom: 0.5rem !important; }\n\n.didomi-button-standard, .standard-button {\n    border-radius: 6px !important;\n    border-color: #005CA8 !important;\n    border-width: 2px;\n    background-color: #005CA8 !important;\n    color: #ffffff !important;\n    font-size: 13px !important;\n    text-transform: uppercase !important;\n}\n\n#didomi-notice-learn-more-button {                   \n    border-radius: 6px !important;\n    border-color: #666666 !important;\n    border: solid 2px #252B2C !important; \n    background-color: white !important;\n    color: #252B2C !important;\n    font-size: 13px !important;\n    text-transform: uppercase !important;\n    } \n\n#didomi-notice #buttons {\n    flex-direction: column-reverse !important;\n    align-items: stretch !important;\n}\n#didomi-host #didomi-notice.didomi-regular-notice #buttons button {\n    padding: .4em 1.5em !important;}\n\n.didomi-button-standard, .standard-button {\n    border-radius: 6px !important;\n    border-width: 1px;\n    font-size: 13px !important;\n    text-transform: uppercase !important;\n}\n\n.didomi-components-button--color, .didomi-button-highlight highlight-button {\n    color: white !important;\n    background-color: #005CA8 !important;\n    border-radius: 6px !important;\n    border-color: #005CA8 !important;\n    font-size: 13px !important;\n    text-transform: uppercase !important; }\n\n#didomi-host .didomi-consent-popup-body {\n    padding: 0px 20px 10px;\n}\n#didomi-host :focus {\n    outline: none;\n}","font":"Roboto, Arial, sans-serif","color":"#005ca8","linkColor":"#005ca8"},"notice":{"content":{"popup":{"ar":"<h2>يُمثِّل احترام خصوصيتك أولوية قصوى لدى TV5MONDE</h2><br />بموجب موافقتك, نحن و<a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\"> {numberOfPartners} من شركائنا</a> نستخدم ملفات تعريف الارتباط أو التقنيات المشابهة لتخزين البيانات الشخصية والوصول إليها ومعالجتها مثل زيارتك لهذا الموقع الإلكتروني وعناوين IP ومعرفات ملفات تعريف الارتباط. لا يطلب بعض الشركاء موافقتك على معالجة بياناتك ويعتمدون على مصلحتهم التجارية المشروعة. يمكنك سحب موافقتك أو الاعتراض على معالجة البيانات بناءً على المصلحة المشروعة في أي وقت عن طريق النقر فوق \"معرفة المزيد\" أو في سياسة الخصوصية الخاصة بنا على هذا الموقع الإلكتروني.","de":"<h2>Der Schutz Ihrer Privatsphäre besitzt für TV5MONDE höchste Priorität</h2><br />Mit Ihrer Zustimmung verwenden wir und <a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\">unsere {numberOfPartners} Partner</a>  Cookies oder ähnliche Techniken, um personenbezogene Daten wie Ihren Besuch auf dieser Website, IP-Adressen und Cookie-Identifikatoren zu speichern, darauf zuzugreifen und zu verarbeiten. Einige Partner bitten Sie nicht um Ihre Zustimmung zur Datenverarbeitung, sondern stützen sich auf ihr berechtigtes geschäftliches Interesse. Sie können jederzeit Ihre Zustimmung widerrufen oder der Datenverarbeitung aufgrund berechtigter Interessen widersprechen, indem Sie auf „Mehr erfahren\" klicken oder in unserer Datenschutzrichtlinie auf dieser Website.","en":"<h2>For TV5MONDE, your privacy is a priority</h2><br />With your agreement, we and <a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\">our {numberOfPartners} partners</a> use cookies or similar technologies to store, access, and process personal data like your visit on this website, IP addresses and cookie identifiers. Some partners do not ask for your consent to process your data and rely on their legitimate business interest. You can withdraw your consent or object to data processing based on legitimate interest at any time by clicking on “Learn More” or in our Privacy Policy on this website.","es":"<h2>El respeto de su privacidad es una prioridad para TV5MONDE</h2><br />Con tu consentimiento, nosotros y <a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\"> nuestros {numberOfPartners} socios</a> usamos cookies o tecnologías similares para almacenar, acceder y procesar datos personales, como tus visitas a esta página web, las direcciones IP y los identificadores de cookies. Algunos socios no te piden consentimiento para procesar tus datos y se amparan en su legítimo interés comercial. Puedes retirar tu consentimiento u oponerte al procesamiento de datos según el interés legítimo en cualquier momento haciendo clic en ''Obtener más información'' o en la política de privacidad de esta página web.","fr":"<h2>Le respect de votre vie privée est une priorité pour TV5MONDE</h2><br />Avec votre accord, nous et <a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\">nos {numberOfPartners} partenaires</a> utilisons des cookies ou technologies similaires pour stocker, consulter et traiter des données personnelles telles que votre visite sur ce site internet, les adresses IP et les identifiants de cookie. Certains partenaires ne demandent pas votre consentement pour traiter vos données et se fondent sur leur intérêt commercial légitime. À tout moment, vous pouvez retirer votre consentement ou vous opposer au traitement des données fondé sur l'intérêt légitime en cliquant sur « En savoir plus » ou en allant dans notre politique de confidentialité sur ce site internet.","ja":"<h2>TV5MONDEはあなたのプライバシーを尊重します</h2><br />お客様の同意に基づき,当社と<a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\">当社の{numberOfPartners}のパートナー</a> は,Cookieまたは同様のテクノロジーを使用して,このWebサイトへのアクセス,IPアドレス,Cookie識別子などの個人データを保存,アクセス,処理します。一部のパートナーは,お客様のデータを処理するためにお客様の同意を求めず,正当なビジネス上の利益に依存しています。「詳細」をクリックするかこのWebサイトのプライバシーポリシーをクリックすることで,いつでも同意を撤回したり,正当な利益に基づいてデータ処理に異議を唱えたりすることができます。","ko":"<h2>TV5MONDE는 개인정보 보호를 최우선으로 생각합니다</h2><br />귀하의 동의에 따라 당사와 <a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\">당사의 {numberOfPartners}개 파트너사</a>는 쿠키 또는 유사한 기술을 사용하여 본 웹사이트 방문, IP 주소 및 쿠키 식별자와 같은 개인 데이터를 저장, 액세스 및 처리합니다. 일부 파트너사는 귀하의 데이터를 처리하기 위해 귀하의 동의를 구하지 않고 정당한 사업상의 이익에 의존합니다. 귀하는 '자세히 알아보기'를 클릭하거나 본 웹사이트의 개인 정보 보호 정책을 클릭하여 언제든지 정당한 이익에 따른 데이터 처리에 대한 동의 또는 반대를 철회할 수 있습니다.","pt":"<h2>O respeito a sua vida privada é uma prioridade para a TV5MONDE</h2><br />Com o seu consentimento, nós e <a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\"> os nossos {numberOfPartners} parceiros</a> usamos cookies ou tecnologias semelhantes para armazenar, aceder e processar dados pessoais como a sua visita a este sítio web, endereços IP e identificadores de cookies. Alguns parceiros não pedem o seu consentimento para processar os seus dados e baseiam-se nos seus interesses comerciais legítimos. Pode retirar o seu consentimento ou opor-se ao processamento de dados com base no seu interesse legítimo em qualquer altura, clicando em \"Saiba mais\" ou na nossa Política de Privacidade neste sítio web.","ru":"<h2>Защита вашей личной жизни является приоритетом для TV5MONDE</h2><br />С вашего согласия мы и <a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\">наши {numberOfPartners} партнера(-ов)</a> используем файлы cookie или аналогичные технологии для хранения, доступа и обработки персональных данных, таких как ваше посещение этого веб-сайта, IP-адреса и идентификаторы файлов cookie. Некоторые партнеры не запрашивают вашего согласия на обработку ваших данных и полагаются на свой законный коммерческий интерес. Вы можете в любое время отозвать свое согласие или возразить против обработки данных на основании законного интереса, нажав \"Подробнее\" или в нашей Политике конфиденциальности на этом веб-сайте.","vi":"<h2>Tôn trọng cuộc sống riêng tư của bạn là điều tiên quyết của TV5MONDE</h2><br />Dưới sự đồng ý của bạn, chúng tôi và <a role=\"button\" href=\"javascript:Didomi.preferences.show('vendors')\" class=\"didomi-notice-view-partners-link-in-text\"> {numberOfPartners} đối tác của chúng tôi</a> sẽ sử dụng cookie hoặc công nghệ tương tự để lưu trữ, truy cập và xử lý dữ liệu cá nhân, chẳng hạn như phiên truy cập của bạn trên trang web này, địa chỉ IP và mã nhận dạng cookie. Một số đối tác có thể xử lý dữ liệu của bạn mà không cần bạn đồng ý và điều này dựa trên lợi ích kinh doanh hợp pháp của họ. Bạn có thể rút lại sự đồng ý hoặc phản đối việc xử lý dữ liệu dựa trên lợi ích hợp pháp bất cứ lúc nào bằng cách nhấp vào nút \"Tìm hiểu thêm\" hoặc trong Chính sách quyền riêng tư của chúng tôi trên trang web này."},"activeElements":["learnMore","deny","dismiss"],"learnMore":{"ar":"إدارة اختياراتي","de":"Meine Einstellungen verwalten","en":"Manage My Choices","es":"Gestionar mis elecciones","fr":"Gérer mes choix","ja":"選択内容を管理する","ko":"사용자 개인 설정 관리","pt":"Gerenciar as minhas escolhas","ru":"Управлять моим выбором","vi":"Quản lý các lựa chọn"}},"position":"popup","closeOnClick":false,"closeOnScroll":false,"showDataProcessing":true,"closeOnScrollThreshold":0,"daysBeforeShowingAgain":30,"closeOnScrollThresholdType":"","closeOnClickNavigationDelay":0,"enableBulkActionOnPurposes":true,"partnersLink":{"enabled":true},"enable":true,"type":"optin","denyOptions":{"button":"primary"},"denyAsPrimary":true,"denyAppliesToLI":true},"languages":{"default":"fr","enabled":["ru","ar","en","fr","de","ja","ko","pt","es","vi"]},"tagManager":{"provider":"commandersact"},"preferences":{"content":{"text":{"ar":"نستخدم نحن وشركاؤنا ملفات تعريف الارتباط، ونستخدم المعلومات غير الحساسة من جهازك لتحسين منتجاتنا ونشر محتوى مخصَّص. ويمكنك قبول هذه العمليات المختلفة أو رفضها. لمعرفة المزيد من المعلومات حول ملفات تعريف الارتباط، والبيانات التي نستخدمها، وعمليات مراجعة البيانات التي ننفذها، والشركاء الذين نعمل معهم، يمكنك الاطلاع على <a href=\"{privacyPolicyURL}\" target=\"_blank\">\"سياسة الخصوصية\"</a> و<a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">\"سياسة ملفات تعريف الارتباط\"</a> المعمول بهما.","de":"Wir und unsere Partner verwenden Cookies und nutzen nicht-vertrauliche Informationen Ihres Endgeräts, um unsere Produkte zu verbessern und Ihnen personalisierte Inhalte anzuzeigen.  Sie haben die Möglichkeit, sich mit diesen Vorgängen einverstanden zu erklären oder aber Ihre Zustimmung zu verweigern.  Um mehr über Cookies, die Daten, die wir erfassen, deren Verarbeitung und die Partner zu erfahren, mit denen wir zusammenarbeiten, können Sie sich unsere <a href=\"{privacyPolicyURL}\" target=\"_blank\">Datenschutzerklärung</a> und unsere <a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">Cookie-Richtlinie</a> durchlesen.","en":"We and our partners use cookies and non-sensitive device information to improve our products and show you personalised content. You can accept or decline these different operations. To find out more about cookies, the data we use, the processing we carry out and our partners, please see our <a href=\"{privacyPolicyURL}\" target=\"_blank\">Privacy Policy</a> and <a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">Cookie Policy</a>.","es":"Nosotros y nuestros socios depositamos «cookies» y utilizamos información no sensible de su dispositivo para mejorar nuestros productos y mostrar contenidos personalizados. Puede aceptar o rechazar estas diferentes operaciones. Para obtener más información sobre las «cookies», los datos que utilizamos, el tratamiento que hacemos y los socios con los que trabajamos, puede consultar nuestra <a href=\"{privacyPolicyURL}\" target=\"_blank\">política de privacidad </a>y <a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">nuestra política de «cookies»</a>.","fr":"Nos partenaires et nous déposons des cookies et utilisons des informations non sensibles de votre appareil pour améliorer nos produits et afficher des contenus personnalisés. Vous pouvez accepter ou refuser ces différentes opérations. Pour en savoir plus sur les cookies, les données que nous utilisons, les traitements que nous réalisons et les partenaires avec qui nous travaillons, vous pouvez consulter notre <a href=\"{privacyPolicyURL}\" target=\"_blank\">charte de confidentialité</a> et notre <a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">charte des cookies</a>.","ja":"当社および当社のパートナーは、当社の製品の改善とパーソナライズされたコンテンツの表示のため、Cookieを設置してあなたのデバイスの非機密情報を利用します。 あなたは、これらの操作を認めることも拒否することもできます。 Cookie、当社が利用するデータ、当社が行う処理、当社のパートナーについての詳細は、当社の<a href=\"{privacyPolicyURL}\" target=\"_blank\">個人情報保護ポリシー</a>、ならびに、当社の<a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">Cookieポリシー</a>を参照してください。","ko":"당사와 당사의 파트너는 쿠키를 설정하고 사용자의 장치에서 민감하지 않은 정보를 사용하여 당사의 제품/서비스를 개선하고 맞춤형 콘텐츠를 표시합니다. 사용자는 당사의 다양한 작업을 수락하거나 거부할 수 있습니다. 쿠키, 당사가 사용하는 데이터, 당사가 수행하는 데이터 처리와 당사의 파트너에 대한 세부 정보는 <a href=\"{privacyPolicyURL}\" target=\"_blank\">기밀 유지 헌장</a> 및 <a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">쿠키 헌장</a>을 참조하시기 바랍니다.","pt":"Nós e os nossos parceiros instalamos cookies e utilizamos informações não sensíveis do seu dispositivo para aprimorar os nossos produtos e apresentar conteúdos personalizados. Você pode aceitar ou recusar essas diferentes operações. Para saber mais sobre os cookies, dados que utilizamos, processamentos que fazemos e parceiros com os quais trabalhamos você pode consultar a nossa <a href=\"{privacyPolicyURL}\" target=\"_blank\">política de confidencialidade</a> e a nossa <a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">política de cookies</a>.","ru":"Наши партнеры и мы размещаем файлы «cookie» и используем нечувствительную информацию Вашего устройства для улучшения нашей продукции и персонализации предлагаемого контента. Вы можете принять или отказаться от различных операций. Для получения дополнительной информации о файлах «cookie», используемых нами данных, проводимой нами и нашими партнерами обработке, Вы можете ознакомиться с нашей <a href=\"{privacyPolicyURL}\" target=\"_blank\">политикой безопасности</a> и нашей <a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">политикой относительно файлов «cookie»</a>.","vi":"Chúng tôi cùng các đối tác giữ cookie và sử dụng những dữ liệu không mang tính cá nhân từ thiết bị của bạn nhằm cải thiện sản phẩm và giúp hiển thị những nội dung phù hợp nhất đến với bạn. Bạn có thể chấp nhận hay từ chối qua những thao tác khác nhau. Để tìm hiểu thêm về cookie, những dữ liệu mà chúng tôi sử dụng, những xử lý mà chúng tôi thực hiện cùng các đối tác làm việc chung, bạn có thể tham khảo <a href=\"{privacyPolicyURL}\" target=\"_blank\">điều lệ bảo mật </a> và <a href=\"http://www.tv5monde.com/cms/chaine-francophone/p-34001-Charte-des-cookies.htm\" target=\"_blank\">điều lệ về cookie</a> của chúng tôi."},"title":{"ar":"التفضيلات","de":"Einstellungen","en":"Preferences","es":"Preferencias","fr":"Préférences","ja":"設定","ko":"사용자 선호 사항","pt":"Preferências","ru":"Предпочтения","vi":"Sự ưu tiên"},"textVendors":{"ar":"يُمكنك تعيين تفضيلات الموافقة لكل شريك مدرج أدناه على حدة. اضغط على اسم الشريك للحصول على مزيد من المعلومات بخصوص طبيعة عمله والبيانات التي يجمعها وكيف يستخدمها.","de":"Sie können für jeden aufgeführten Partner Ihre Zustimmungspräferenzen festlegen. Klicken Sie auf einen Partnernamen, um sich über Branche und Datenerhebung sowie -verwendung zu informieren.","en":"You can set your consent preferences for every partner listed below individually. Click on a partner name to get more information on what it does, what data it is collecting and how it is using it.","es":"Puede configurar sus preferencias de consentimiento por separado para cada uno de los socios mencionados abajo. Haga clic en el nombre de un socio para obtener más información acerca de qué hace, qué datos recopila y cómo los usa.","fr":"Vous pouvez définir vos préférences de consentement pour chaque partenaire listé ci-dessous individuellement. Cliquez sur le nom d'un partenaire pour obtenir plus d'informations sur ce qu'il fait, les données qu'il récolte et comment il les utilise.","ja":"以下にリストされているすべてのパートナーに対して、個別に同意設定を設定できます。パートナー名をクリックすると、パートナーの機能、収集しているデータ、およびデータの使用方法に関する詳細情報が表示されます。","ko":"아래에 나열된 모든 파트너에 대한 동의 환경설정을 개별적으로 설정할 수 있습니다. 파트너 이름을 클릭하면 파트너가 수행하는 작업, 수집하는 데이터 및 파트너가 사용하는 방법에 대한 자세한 정보를 볼 수 있습니다.","pt":"Pode definir individualmente as suas preferências de autorização para cada parceiro indicado abaixo. Clique no nome de um parceiro para obter mais informações acerca das respetivas ações, que dados recolhe e como os utiliza.","ru":"Вы можете указать свои предпочтения отдельно для каждого из перечисленных ниже партнеров. Щелкните имя партнера для получения подробной информации о том, чем он занимается, какие данные собирает и как их использует.","vi":"Bạn có thể đặt ưu tiên đồng ý cho mỗi đối tác được liệt kê bên dưới một cách riêng rẽ. Nhấp vào tên đối tác để nhận thêm thông tin về những gì đối tác làm, những loại dữ liệu đối tác đó thu thập và cách đối tác sử dụng dữ liệu đó."},"activeElements":["crossButton","title","viewAllPartners","disagreeToAll","agreeToAll","save"]},"categories":[{"type":"purpose","purposeId":"lescookie-MUeBLLTH"},{"type":"purpose","purposeId":"audiencem-xedeU2gQ"},{"id":"N7qtDp","name":{"ar":"الحملات الإعلانية","de":"Werbung","en":"Advertising","es":"Publicidad","fr":"Publicité","ja":"広告","ko":"광고하는","pt":"Publicidade","ru":"Реклама","vi":"Quảng cáo"},"type":"category","children":[{"type":"purpose","purposeId":"cookies"},{"type":"purpose","purposeId":"select_personalized_ads"},{"type":"purpose","purposeId":"create_ads_profile"},{"type":"purpose","purposeId":"improve_products"},{"type":"purpose","purposeId":"market_research"},{"type":"purpose","purposeId":"measure_ad_performance"},{"type":"purpose","purposeId":"select_basic_ads"}],"expanded":false,"description":{"ar":"تتيح لنا ملفات تعريف الارتباط هذه قياس أداء حملاتنا الإعلانية المرئية على غوغل أو فيسبوك، بهدف الترويج لهذا الموقع الإلكتروني أو هذا التطبيق.","de":"Diese Cookies ermöglichen uns die Messung der Wirksamkeit unserer Werbekampagnen auf Google oder Facebook, die der Förderung dieser Webseite bzw. dieser Anwendung dienen.","en":"These cookies enable us to analyse our advertising campaigns' performance on Google and Facebook to promote this website or app.","es":"Estas «cookies» nos permiten medir el rendimiento de nuestras campañas publicitarias visibles en Google o Facebook, con el fin de promover este sitio o esta aplicación.","fr":"Ces cookies nous permettent de mesurer la performance de nos campagnes publicitaires visibles sur Google ou Facebook, afin de promouvoir ce site ou cette application.","ja":"これらのCookieにより、当社は、当サイトまたはアプリケーションの宣伝を目的として、GoogleまたはFacebookに表示される広告キャンペーンのパフォーマンスを測定できます。","ko":"이 쿠키를 사용하면이 사이트 또는이 애플리케이션을 홍보하기 위해 Google 또는 Facebook에 표시되는 광고 캠페인의 성능을 측정 할 수 있습니다.","pt":"Os cookies nos permitem mensurar o desempenho das nossas campanhas publicitárias visualizáveis no Google ou Facebook, a fim de promover o site ou o aplicativo.","ru":"Эти файлы «cookie» позволяют нам оценить эффективность наших рекламных кампаний в Google или Facebook с целью продвижения этого сайта или этого приложения.","vi":"Các cookie này cho phép chúng tôi tính toán hiệu suất của các chiến dịch quảng cáo được hiển thị trên Google hoặc Facebook nhằm quảng cáo trang web hay ứng dụng này."}},{"id":"eAmCAk","name":{"ar":"تخصيص","de":"Individualisierung","en":"Personalization","es":"Personalización","fr":"Personnalisation","ja":"パーソナル化","ko":"개인화","pt":"Personalização","vi":"Cá nhân hóa"},"type":"category","children":[{"type":"purpose","purposeId":"select_personalized_content"}],"expanded":false,"description":{"ar":"تسمح لنا ملفات تعريف الارتباط هذه بعرض المعلومات ذات الصلة والشخصية بناءً على تصفحكم.","de":"Diese Cookies gestatten es uns, Ihnen personalisierte Informationen anzuzeigen, die wir auf Basis Ihres Internetsurfverhaltens als für Sie relevant erachten.","en":"These cookies allow us to display relevant and personalised information according to your navigation.","es":"Estas cookies nos permiten mostrar información relevante y personalizada en relación a su navegación.","fr":"Ces cookies nous permettent de vous afficher des informations pertinentes et personnalisées selon votre navigation.","ja":"これらのクッキーは、お客様のナビゲーションに応じて、関連性の高いパーソナライズされた情報を表示するためのものです。","ko":"이러한 쿠키를 통해 당사가 귀하의 탐색에 따라 관련성 있고 개인화된 정보를 표시할 수 있습니다.","pt":"Estes cookies permitem-nos mostrar informação relevante e personalizada, de acordo com a sua navegação.","vi":"Các cookie này cho phép chúng tôi hiển thị thông tin có liên quan và được cá nhân hóa dựa trên quá trình điều hướng của bạn."}},{"type":"purpose","purposeId":"measure_content_performance"}],"showWhenConsentIsMissing":false,"vendorsLayer":{"enabled":true},"denyAppliesToLI":true,"storageDisclosure":{"enable":true},"vendorsCount":{"enabled":true},"vendorsDisclosure":{"enabled":true}},"regulations":{},"integrations":{"vendors":{"google":{"enable":false,"refresh":true,"eprivacy":false,"passTargetingVariables":false},"salesforce-dmp":{"enable":false,"namespace":null},"refreshOnConsent":false,"gcm":{"enable":true,"setDefaultStatus":false,"dataLayerName":null,"defaultStatus":{"analytics":false,"ad":false,"functionality":true,"personalization":true,"security":true,"ad_user_data":true,"ad_personalization":true}}}},"id":"f1c159b3-fe15-4f11-ac0f-e91215a64f51","version":"1.0.0","regulation":{"group":{"name":"optin"},"name":"gdpr","id":1}}}]}}catch(o){console.error("Didomi - Invalid remote config")}}();!function(){try{window.didomiCountry="SA",window.didomiRegion="02",window.didomiGeoRegulations=["gdpr"]}catch(o){console.error("Didomi - Invalid country")}}();!function(){var t={190:function(t){t.exports=function t(e){var n=function(){try{return!("noModule"in HTMLScriptElement.prototype)||"function"!=typeof Set||"function"!=typeof Symbol||"function"!=typeof Object.assign||"function"!=typeof[].find||"function"!=typeof[].flatMap||"function"!=typeof Array.from||"function"!=typeof Promise||"function"!=typeof[].includes||"function"!=typeof Number.isInteger||"function"!=typeof"".repeat||"function"!=typeof WeakSet||"function"!=typeof Object.values||"function"!=typeof Object.entries||"function"!=typeof"".includes||"function"!=typeof"".startsWith||!(1===new Map([["key","value"]]).size)||function(){try{return!Array.from(new Set)}catch(t){return!0}}()||"function"!=typeof Object.defineProperty||"function"!=typeof Object.hasOwn||"function"!=typeof"".replaceAl