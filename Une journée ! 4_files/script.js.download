				$('.favorites-collections-form .submit-btn').attr('disabled', 'disabled');
				$('.favorites-collections-form .manage-btn').bind('click', function(e){
					var $this = $(this);
					e.preventDefault();
					e.stopPropagation();
					if ($('.view-favoris-collections').hasClass('manage-inactive')) {
						$('.view-favoris-collections').removeClass('manage-inactive');
					}
					else {
						$('.view-favoris-collections').addClass('manage-inactive');
						$('.favorites-collections-form .submit-btn').attr('disabled', 'disabled');
					}
				});
			}		
			
			// move search excerpt
			$('.special-search-excerpt').not('.moved').each(function(no, item) {
				$(item).appendTo( $(item).closest('.views-row').find('.node .group-text') ).addClass('moved');
			});
			
			// move view header, favorites series page
			if ($('.view-favoris-series-exercices > .view-header > .hero__chapo').not('.moved').length) {
				$('.hero__wrapper.header-page-title .hero__chapo').remove();
				$('.view-favoris-series-exercices > .view-header > .hero__chapo').not('.moved').appendTo('.hero__wrapper.header-page-title').addClass('moved');
			}
			
			// move view header, favorites collections page
			if ($('.view-favoris-collections > .view-header > .hero__chapo').not('.moved').length) {
				$('.hero__wrapper.header-page-title .hero__chapo').remove();
				$('.view-favoris-collections > .view-header > .hero__chapo').not('.moved').appendTo('.hero__wrapper.header-page-title').addClass('moved');
			}
			
			// attach custom ajax views
			if (settings && settings.views && settings.views.customAjaxViews) {
				var customAjaxViews = settings.views.customAjaxViews;

				Object.keys(customAjaxViews || {}).forEach(function (i) {
					Drupal.views.instances[i] = new Drupal.views.ajaxView(customAjaxViews[i]);
				});
			}
			
			// homepage partners carrousel
			if($('.view-partners-homepage .view-content').length ) {
				 
				$('.view-partners-homepage .view-content').on('init', function (event, slick) {       
					var $this = $(this);
					setTimeout(function () {
						var slideHeight = $this.outerHeight();
						$this.find('.views-row').each(function() {
							var $this_item = $(this);
							$this_item.css('height', slideHeight + 'px');
							$this_item.css('line-height', slideHeight + 'px');
						});
					}, 1000);
				});        
				$('.view-partners-homepage .view-content').on('breakpoint', function (event, slick) {
					var slideHeight = $(this).outerHeight();
					$(this).find('.views-row').each(function() {
						var $this = $(this);
						$this.css('height', slideHeight + 'px');
						$this.css('line-height', slideHeight + 'px');
					});			
				});
				$('.view-partners-homepage').imagesLoaded( function() {
					// images have loaded
					$('.view-partners-homepage .view-content').not('.slick-initialized').slick({
						rtl: $('html').attr('dir') === 'rtl',
						infinite: true,
						centerMode: false,
						centerPadding: 0,
						slidesToShow: 8,
						slidesToScroll: 1,
						variableWidth: false,
						fade: false,
						arrows: true,
						dots: false,
						autoplay: true,
						autoplaySpeed: 5000,
						adaptiveHeight: true,
						prevArrow: '<button type="button" data-role="none" class="btn btn-sm slick-btn slick-prev" aria-label="' + Drupal.t('Previous') + '">' + Drupal.t('Previous') + '</button>',
						nextArrow: '<button type="button" data-role="none" class="btn btn-sm slick-btn slick-next" aria-label="' + Drupal.t('Next') + '">' + Drupal.t('Next') + '</button>',
						responsive: [{
							breakpoint: 1199,
							settings: {
								slidesToShow: 8,
								slidesToScroll: 1
							}
						},
						{
							breakpoint: 992,
							settings: {
									slidesToShow: 5,
									slidesToScroll: 1
							}
						},
						{
							breakpoint: 576,
							settings: {
									slidesToShow: 3,
									slidesToScroll: 1
							}
						}]		
					});
				});	
			}	
			
			// homepage promotions carrousel
			if($('.view-promotions-homepage .view-content').length ) {
				
				$('.view-promotions-homepage').imagesLoaded( function() {
					// images have loaded
					$('.view-promotions-homepage .view-content').not('.slick-initialized').slick({
						rtl: $('html').attr('dir') === 'rtl',
						infinite: true,
						slidesToShow: 4,
						slidesToScroll: 4,
						fade: false,
						arrows: true,
						dots: false,
						autoplay: true,
						autoplaySpeed: 5000,
						adaptiveHeight: true,
						prevArrow: '<button type="button" data-role="none" class="btn btn-sm slick-btn slick-prev" aria-label="' + Drupal.t('Previous') + '">' + Drupal.t('Previous') + '</button>',
						nextArrow: '<button type="button" data-role="none" class="btn btn-sm slick-btn slick-next" aria-label="' + Drupal.t('Next') + '">' + Drupal.t('Next') + '</button>',
						responsive: [{
							breakpoint: 1199,
							settings: {
								slidesToShow: 3,
								slidesToScroll: 3
							}
						},
						{
							breakpoint: 992,
							settings: {
									slidesToShow: 2,
									slidesToScroll: 2
							}
						},
						{
							breakpoint: 767,
							settings: {
									slidesToShow: 1,
									slidesToScroll: 1
							}
						}]		
					});
				});	
			}
			
			// background image for some series in teaser view mode
			$('.image-full.node--type-serie-exercices.node--view-mode-teaser').each(function() {
				var $this = $(this);
				if($this.find('.field--name-field-vignette img').length) {
					if($(window).width() < 768) {
						var srcset = $this.find('.field--name-field-vignette img').parent().find('source').attr('srcset');
						srcset = srcset.slice(0, -3);
						$this.attr('style', 'background-image:url(' + srcset + ')');
					}
					else {
						$this.attr('style', 'background-image:url(' + $this.find('.field--name-field-vignette img').attr('src') + ')');
					}
				}	
			});
			// change title for user login form in modal and click overlay to close modal
			if($(context).length && $(context).hasClass('user-login-form') && $("#drupal-modal").length) {
				$( "#drupal-modal" ).on( "dialogopen", function( event, ui ) {
					$(this).parent().find("span.ui-dialog-title").html('<span class="modal-title-title">' + Drupal.t('I identify myself') + '</span><span class="modal-description">' + Drupal.t('If you are already registered, log in.') + '</span>');
					
					$('.ui-widget-overlay').click(function() {
						$('.ui-dialog-titlebar-close').trigger('click');
					});
				});
			}	

    }
  };
	
	// document ready
	$(document).ready(function() {
		//$("[data-toggle=tooltip]").tooltip();
		// video transcription
		$('.node--type-aide.node--view-mode-full .field--name-body .field--name-field-media-transcription, .node--type-article.node--view-mode-full .field--name-field-content .field--name-field-media-transcription').each(function() {
			var $this = $(this);
			$this.wrapAll('<div class="wrap-media-transcription"></div>');
			$this.parent().prepend('<button class="toggle-transcription">' + Drupal.t('Transcription') + '</button>');
			$this.parent().find('button.toggle-transcription').click(function() {
				var $this = $(this);
				$this.parent().toggleClass('open');
			});
			
			setTimeout(function () {
				var $vid = $this.parent().parent().find('video');
				if ($vid.length) {
					var vid = $vid[0];
					vid.ontimeupdate = function() {
						$this.find('span.word').each(function(i) {
							$(this).attr("style", "");
							if (vid.currentTime >= parseFloat($(this).attr("start")) &&
							vid.currentTime < parseFloat($(this).attr("end"))) {
								$(this).attr("style", "background: linear-gradient(180deg,rgba(255,255,255,0) 25%, #a4dae8 25%);")
							}
						});
					};
					$this.find('span.word').click(function() {
						var end_time, start_time;
						start_time = $(this).attr('start');
						end_time = $(this).attr('end');
						vid.currentTime = parseFloat(start_time);
						if (vid.apaused) {
							return vid.pause();
						}
					});
				}
			}, 5000);
		});
		
		// video link
		$('span.special-timecode-video').each(function(index, item) {
			var video_id = '';
			var timecode = $(item).data('timecode');
			var $video = null;
			var mid = $(item).data('mid');
			if (mid) {
			  $video = $('#video-media-video-tv5-jwplayer-' + mid + '-0');
			}
			else {
				var $video_temp = $('.tv5monde_player').first();
				if ($video_temp.length) {
					$video = $video_temp.parent();
				}
			}
			if ($video && $video.length) {
				video_id = $video.attr('id');
			}

			if(timecode && video_id) {	
				$(item).attr('tabindex', 0);
				$(item).addClass('with-video');
				$(item).unbind('click').bind('click', function(e) {
					var vid = $video.find('video')[0];
					if (typeof vid != 'undefined') {
						document.getElementById(video_id).scrollIntoView({ behavior: 'smooth' });
						vid.currentTime = parseFloat(timecode);
						if (vid.paused) {
							vid.play();
						}
					}					
				});
				$(item).keydown(function(e){
					if(e.which === 13){
						$(this).click();
					}
				});
			}
		});
		
