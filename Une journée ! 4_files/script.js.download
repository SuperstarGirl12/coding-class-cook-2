						var drpback = $('<div class="nav-backdrop" aria-hidden="true"></div>');
						$('.main-container').append(drpback);
						// > Closing Menu on click onto nav-backdrop
						$('.main-container .nav-backdrop').on('click', function () {
							$('.navbar-default .inner-header').removeClass('lg-open');
							$('.main-container .nav-backdrop').remove();
							resetHeaderMenu();
