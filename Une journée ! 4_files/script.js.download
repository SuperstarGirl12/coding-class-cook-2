				$('.favorites-form .submit-btn').attr('disabled', 'disabled');
				$('.favorites-form .manage-btn').bind('click', function(e){
					var $this = $(this);
					e.preventDefault();
					e.stopPropagation();
					if ($('.view-favoris-series-exercices').hasClass('manage-inactive')) {
						$('.view-favoris-series-exercices').removeClass('manage-inactive');
					}
					else {
						$('.view-favoris-series-exercices').addClass('manage-inactive');
						$('.favorites-form .submit-btn').attr('disabled', 'disabled');
					}
				});
			}
			
