			$container_level_tabs.find('button').bind('click', function(){
				var $this = $(this);
				$('.form-item-field-niveau-target-id select').val($this.data('tid'));
				$('#views-exposed-form-favoris-series-exercices-page .form-submit').click();
				$this.parent().find('button').removeClass();
				$this.addClass('active order-1');
				$this.attr('aria-selected', 'true');
				$this.parent().find('button:not(.active)').each(function(i){
					var $this = $(this);
					var new_order = i+2;
					$this.removeClass();
