	// Window Load
  $(window).on('load', function () {
    // End window load
  });
	
	// window scroll
	$(window).scroll(function () {
		var scrollPos = $(window).scrollTop();
		if($('.wrapper-container-level-tabs').length) {
			var level_tabs_pos_top = $('.wrapper-container-level-tabs').data('offset-top');
			if((scrollPos > level_tabs_pos_top) && !$('.wrapper-container-level-tabs').hasClass('fixed')) {
				$('.wrapper-container-level-tabs').addClass('fixed');
			}
			if((scrollPos <= level_tabs_pos_top) && $('.wrapper-container-level-tabs').hasClass('fixed')) {
				$('.wrapper-container-level-tabs').removeClass('fixed');
			}		
		}
		
		if($('.anchormenu').length) {
			if(!posAnchor) {
				posAnchor = $('.anchormenu').offset();
			}
			
			
			if(posAnchor.top < scrollPos+90) {
				$('.anchormenu').css('width', $('.group-left .group-menu').width());
				$('.anchormenu').addClass('is-fixed');
			}
			else {
				$('.anchormenu').removeClass('is-fixed');
			}
			
			if(($('.group-right').offset().top + $('.group-right').height() - scrollPos) < $('.anchormenu').height()) {
				$('.anchormenu').addClass('is-bottom');
			}
			else {
				$('.anchormenu').removeClass('is-bottom');
			}

			$('.anchormenu a').each(function(i){
				var posParag = $('#anchor' + $(this).attr('data-index')).offset();
				if(posParag.top < scrollPos+120 && !$(this).hasClass('active')) {
					$('.anchormenu a').removeClass('active');
					$(this).addClass('active');
				}
				else if(posParag.top >= scrollPos+120) {
					$(this).removeClass('active');
				}
			});
		}
		
		
	});	
	

