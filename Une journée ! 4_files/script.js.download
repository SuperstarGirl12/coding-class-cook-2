// JavaScript should be made compatible with libraries other than jQuery by
// wrapping it with an "anonymous closure". See:
// - https://drupal.org/node/1446420
// - http://www.adequatelygood.com/2010/3/JavaScript-Module-Pattern-In-Depth
(function (Drupal, once, $) { 

  'use strict';
	
	var posAnchor = 0;
	
	$.fn.customAttachAjaxViews = function(settings) {
		
    Object.keys(settings || {}).forEach(function (i) {
			Drupal.views.instances[i] = new Drupal.views.ajaxView(settings[i]);
			drupalSettings.views.ajaxViews[i] = settings[i];
		});
  };

	var resetHeaderMenu = function() {
		$('#block-mainnavigation .menu-level-1').removeClass('ml1-open');
		if($(window).width() >= 1024) {
			$('#block-mainnavigation .menu-level-1').css('height', 'auto');
			$('#block-mainnavigation .menu-level-2').css('height', 'auto');
		}	
	}

  // Detect external links and open them on a new tab.
  function targetBlank() {
    // remove subdomain of current site's url and setup regex
    var internal = location.host.replace("www.", "");
    internal = new RegExp(internal, "i");

    var a = document.getElementsByTagName('a'); // then, grab every link on the page
    for (var i = 0; i < a.length; i++) {
      
      // in metanav or lg menu?
      var in_metanav = false;
      var parent = a[i].parentNode;
      while(!(!parent || in_metanav)) {
        
        var p_id = parent.id;
        if((p_id == 'tv5monde-footer') || (p_id == 'tv5monde-metanav') || (p_id == 'special-menu-lg') || (p_id == 'special-mobile-menu-lg')) { 
          in_metanav = true;
        }
        parent = parent.parentNode;
      }
      // not in metanav
      if (!in_metanav) {
        var href = a[i].host; // set the host of each link
        if( !internal.test(href) ) { // make sure the href doesn't contain current site's host
          a[i].setAttribute('target', '_blank'); // if it doesn't, set attributes
        }
      } 
    }
  };	

  // To understand behaviors, see https://drupal.org/node/756722#behaviors
  Drupal.behaviors.my_custom_behavior = {
    attach: function (context, settings) {
			$("[data-toggle=tooltip]").tooltip();
			// after dialog create
			// change page url and click copy button, record search in modal form
			// click copy button in integration modal
			once('after-dialog-create', 'body').forEach(
				(el) => {

					$(window).on('dialog:aftercreate', function (event, dialog, $element, settings) {
						if ($element.dialog('option', 'modal')) {
							if ($element.parent().hasClass('record-search-modale')) {
								$('.record-search-url').attr('value', document.location.href);
								 $('.search-copy-url').click(function() {
									var copyText = document.querySelector('.record-search-url');
									copyText.focus();
									copyText.select();
									document.execCommand('copy');
								});
							}
							if ($element.parent().hasClass('serie-integration-dialog')) {
								$('.i-copy-url').click(function() {
									var copyText = document.querySelector('.i-serie-iframe');
									copyText.focus();
									copyText.select();
									document.execCommand('copy');
								});
							}
						}
					});
				}
			);
			
			targetBlank();
			
			// cookie profil enseignant, show my classes link
			if ($('.ce-link-classes').length && !$('body').hasClass('pe-processed')) {
				var allcookies = document.cookie;
				var cookiearray = allcookies.split(';');   
				for(var i=0; i<cookiearray.length; i++) {
					var cookiename = cookiearray[i].split('=')[0];
					cookiename = cookiename.trim();
					var cookievalue = cookiearray[i].split('=')[1];
					cookievalue = cookievalue.trim();
					if((cookiename == 'user_pe_active') && cookievalue == '1') {
						$('.ce-link-classes').removeClass('d-none');
					}
				}
				$('body').addClass('pe-processed')
			}	
			
			// search sort block
			if($('.path-search .block-search-api-sorts ul.search-api-sorts li a.is-active').length && !$('.path-search .block-search-api-sorts').hasClass('processed')) {
				
				var $active_sort = $('<div></div>')
					.insertBefore($('.path-search ul.search-api-sorts'))
					.addClass('search-active-sort-label')
					.html($('.path-search ul.search-api-sorts li a.is-active').html())
					.click(function() {
						$('.path-search .block-search-api-sorts ul.search-api-sorts').toggleClass('show');
					});
				$('.path-search .block-search-api-sorts').width($('.path-search .block-search-api-sorts ul').outerWidth(true));
				$('.path-search .block-search-api-sorts').addClass('processed');	
				$('.block-facet-blocktype-de-contenu').css(($('html').attr('dir') === 'rtl')?'padding-left':'padding-right', $('.path-search .block-search-api-sorts').outerWidth(true));
			}
			
			// content type facet, window with < 1200
			if(($(window).width() < 1200) && $('.block-facet-blocktype-de-contenu li a.is-active').length && !$('.block-facet-blocktype-de-contenu').hasClass('processed')) {
				/*var $active_content = $('<div></div>')
					.insertBefore($('.block-facet-blocktype-de-contenu ul'))
					.addClass('search-active-content-label')
					.html($('.block-facet-blocktype-de-contenu li a.is-active').html())
					.click(function() {
						$('.block-facet-blocktype-de-contenu ul').toggleClass('show');
					});
				var s_title = $('<li></li>')
					.prependTo($('.block-facet-blocktype-de-contenu ul'))
					.addClass('s-title')
					.html($('.block-facet-blocktype-de-contenu h2').html());*/
					
				var $active_content = $('<div></div>')
					.insertBefore($('.block-facet-blocktype-de-contenu ul'))
					.addClass('search-active-content-label')
					.html($('.block-facet-blocktype-de-contenu h2').html())
					.click(function() {
						$('.block-facet-blocktype-de-contenu ul').toggleClass('show');
					});
					
				$('.block-facet-blocktype-de-contenu').width($('.block-facet-blocktype-de-contenu ul').outerWidth(true));	
				$('.block-facet-blocktype-de-contenu').addClass('processed');	
			}
			
			
			// facets blocks
			$('.path-search .wrapper-region-sidebar-first .block-facets').not('.click-processed').each(function(index, item) {
				
				if($(window).width() >= 992) {
					// open level facet
					if($(item).hasClass('block-facet-blockniveau')) {
						$(item).addClass('open open-cross');
					}
					// open bloc with active link and add class
					if($(item).find('a.is-active').length) {
						$(item).find('a.is-active').parent().addClass('is-active');
						$(item).addClass('open open-cross');
						// close level facet if no active link
						if(!$(item).hasClass('block-facet-blockniveau') && (!$('.block-facet-blockniveau').find('a.is-active').length)) {
							$('.block-facet-blockniveau').removeClass('open open-cross');
						}
					}
				}
				
				$(item).find('h2').unbind('click').bind('click', function(e) {
					var $this = $(this);
					e.preventDefault();
					e.stopPropagation();
					if($(window).width() >= 992) {

						if($this.parent().hasClass('open')) {
							$this.parent().removeClass('open-cross');
							$this.parent().find('.facets-widget-checkbox').slideUp('slow', function() {
								$this.parent().removeClass('open');
							});
							
						}
						else {;
							$this.parent().addClass('open-cross');
							$this.parent().find('.facets-widget-checkbox').slideDown('slow', function() {
								$this.parent().addClass('open');
							});	
						}
						
					}
					else {
						if($this.closest('.block-facets').hasClass('open')) {
							$('.path-search .wrapper-region-sidebar-first .block-facets').removeClass('open');
						}
						else {
							$('.path-search .wrapper-region-sidebar-first .block-facets').removeClass('open');
							$this.closest('.block-facets').addClass('open');
						}	
					}	
				});
				
				if($(window).width() < 992) {
					var $closebutton = $('<div></div>')
					  .prependTo($(item).find('.facets-widget-checkbox'))
					  .addClass('close-facets')
						.html('<span class="sr-only">'+Drupal.t('Close')+'</span><span class="ikon-xcross" aria-hidden="true"></span>')
						.unbind('click').bind('click', function(e){
							$('.path-search .wrapper-region-sidebar-first .block-facets').removeClass('open');
						});	
				}	
				
				$(item).addClass('click-processed');
			});
			
			// Smooth scroll for in page links
			$('a[href*="#"]:not([href="#"]):not([role="tab"]):not([data-toggle="lightbox"]):not([data-toggle="collapse"]):not(.carousel-control):not(.sr-only-focusable):not(.series-tab-control)').not('.click-processed').each(function(index, item) {
				$(item).unbind('click').bind('click', function(e) {
					if (location.pathname.replace(/^\//, '') == this.pathname.replace(/^\//, '') && location.hostname == this.hostname) {
						var target = $(this.hash)
						target = target.length ? target : $('[name=' + this.hash.slice(1) + ']')
						if (target.length) {
							$('html,body').animate({
								scrollTop: target.offset().top - 100
							}, 1000)
							return false
						}
					}
				});	
				
				$(item).addClass('click-processed');
			});

			// languages dropdown
			if ($('.inner-header .btn-switch-lg').not('.click-processed').length) {
				$('.inner-header .btn-switch-lg').addClass('click-processed');
				$('.inner-header .btn-switch-lg').click(function(e){
					e.preventDefault();
					e.stopPropagation();
					// close
					if ($('.navbar-default .inner-header').hasClass('lg-open')) {
						$('.navbar-default .inner-header').removeClass('lg-open');
						$('.main-container .nav-backdrop').remove();
						resetHeaderMenu();
