			// manage favorites
			$('.view-favoris-series-exercices .views-row').not('.manage-processed').each(function(index, item) {
				var $this = $(this);
				var item_id = $(this).find('h3').data('id');
				var inputBox = $('<div></div>')
					.prependTo($(this).find('.unit-handler'))
					.addClass('select-favorite-item');
				var inputElem = $('<input type="checkbox" id="item-' + item_id + '" name="item-' + item_id + '" value="' + item_id + '">')
					.prependTo($this.find('.select-favorite-item'))
					.bind('click', function() {
						var $this = $(this);
						var nids = $('.favorites-form input:hidden[name=nids]').val();
						if (typeof $this.attr('checked') != 'undefined') {
							$this.removeAttr('checked');
							if (!$('.view-favoris-series-exercices').find('input:checkbox[checked=checked]').length) {
								$('.favorites-form .submit-btn').attr('disabled', 'disabled');
							}
							nids = nids.replace('-' + $this.attr('value') + '-', '-');
							$('.favorites-form input:hidden[name=nids]').val(nids);	
						}
						else {
							$this.attr('checked', 'checked');
							var addval = (nids != ''?$this.attr('value') + '-':'-' + $this.attr('value') + '-');
							$('.favorites-form input:hidden[name=nids]').val(nids + addval);
							$('.favorites-form .submit-btn').removeAttr('disabled');
						}
					});
				var layer = $('<span></span>')
					.appendTo($this.find('.select-favorite-item'))
					.addClass('layer-select-favorite')
					.html('<span class="sr-only">' + Drupal.t('Select this item')+'</span>')
					.bind('click', function() {
						var $this = $(this);
						$this.parent().find('input').trigger('click');
					});		
				$this.addClass('manage-processed');	
			});
			
			if ($('.view-favoris-series-exercices').not('.manage-processed').length) {
