 (function(Drupal, $) {
    $(function() {
    var flag_timestamp = 0;
		var is_mobile = false;
		if($(window).width() <= 460) {
			is_mobile = true;
		}
		var dropbox_label = '';
		if (typeof(drupalSettings.exercice_interface) != 'undefined' && typeof(drupalSettings.exercice_interface.drop_box_label) != 'undefined') {
			dropbox_label = drupalSettings.exercice_interface.drop_box_label;
		}
		
		var dragbox_empty_label = '';
		if (typeof(drupalSettings.exercice_interface) != 'undefined' && typeof(drupalSettings.exercice_interface.drag_box_empty_label) != 'undefined') {
			dragbox_empty_label = drupalSettings.exercice_interface.drag_box_empty_label;
		}
		
		var dragbox_help = '';
		if (typeof(drupalSettings.exercice_interface) != 'undefined' && typeof(drupalSettings.exercice_interface.drag_box_help) != 'undefined') {
			dragbox_help = drupalSettings.exercice_interface.drag_box_help;
		}
		
    $.widget(
      'demo.exercice',
      {
        /* PUBLIC PROPERTIES */
        options:{
          analysis_text:'nbOk(s) correct answer(s) nb',
          ko_title:'<div class="exo-h2">Attention</div>',
          ko_text:'Replay !',
          definition_title:'Definitions',
          ok_title:'<div class="exo-h2">Congratulation</div>',
          ok_text:'You\'re a champion !',
          solution_title:'<div class="exo-h2">Solution</div>',
          solution_text:'Here is the exercice solution',
          replay_bt_label:'Replay',
          validate_bt_label:'Submit',
          solution_bt_label:'Solution',
          majuscule_bt_label:'Majuscule',
          lowercase_bt_label:'Lower Case',
          splitTag:new RegExp('<br[^>]*>'),
          tabAccents:Array('à', 'â', 'é', 'è', 'ê', 'ë', 'ô', 'î', 'ï', 'û', 'ü', 'ù', 'ç', 'œ', 'æ'),
          enabledAssetClasses:'undefined',
          to_be_corrected_text:'This item had to be corrected',
          not_need_to_be_corrected_text:'This item did not need to be corrected',
          capsLock:0,
          shiftKey:0
        },
        /* PRIVATE PROPERTIES */
        nbQ:null,
        nbR:null,
        tabMyResponse:[],
        $container:null,
        $imgzoom:null,
        $ko:null,
        $ok:null,
        $solution:null,

        $popResult:null,
        $myResponse:null,
        $activeElement:null,
        $keyboard:null,
        $elements:null,
        /* CONSTRUCTOR METHOD */
        _create : function(){
          flag_timestamp = Math.round(new Date().getTime()/1000);
          var self = this;
          this.$elements = this.element.find('*');
          this.$imgzoom = $('<div></div>').addClass('exo-img-zoom').appendTo('body')/*.bind('mouseup mouseleave', function(){$(this).html('').hide()})*/;
          this.$container = $('<div></div>').addClass('exercice_items').appendTo(this.element);/* MAIN CONTAINER OBJECT */
          this.$myResponse = $('<div></div>').addClass('exercice_myresponse').appendTo(this.$container).hide();/* MY RESPONSE OBJECT */
          this.$popResult = $('<div></div>').addClass('exercice_result').attr('id', 'exercice-result-a').appendTo(this.element).hide();/* RESULT POPUP */
         
					$('button.btn-exo-validate').click(
						function(){
							self._testResponse();
							self._replay();
							// anchor exo resultq
							var $anchor = $('#exercice-result-a');
							$('html,body').animate({scrollTop: $anchor.offset().top},'slow');
							return;
						}
					);	
          if(typeof(this.options.json) == 'undefined')
            return;
          this.nbQ = this.options.json['items'].length;
        },
        /* INITIALISATION METHOD */
        _init : function(){
          this._initAsset();
					var dir_html = $('html').attr('dir');
					if (dir_html == 'rtl') {
						this.$elements.css({position:'absolute',top:'-20000px',right:'-20000px',left:'unset'});
					}
					else {
						this.$elements.css({position:'absolute',top:'-20000px',left:'-20000px'});
					}
          this._initImg();
        },
        _initAsset : function($container){
					/*var $mycontainer = self.$container;				
					if(typeof($container) != 'undefined') {
						$mycontainer = $container;
					}*/
					
					// init audio
					if(typeof(Drupal.behaviors.audiofieldjplayer) != 'undefined') {
						//Drupal.behaviors.audiofieldjplayer.attach($mycontainer, drupalSettings);
						Drupal.behaviors.audiofieldjplayer.attach(document, drupalSettings);
					}	
        },
        _initImg : function($obj){					
            var self = this;
            if(typeof(this.options.imageAssetClasse) == 'undefined')
              return;
						var $mycontainer = self.$container;				
            if(typeof($obj) != 'undefined') {
							$mycontainer = $obj;
						}
						
            $mycontainer.find('a.exercice_img').each(
              function() {
                var $this = $(this);
                var img_asset_mode = $this.data('asset-mode');
                var img_asset_aid = $this.data('asset-aid');
                if(typeof(img_asset_mode) != 'undefined' && typeof(img_asset_aid) != 'undefined') {
                  $this
                  .bind({
                    click:function(){
                      if((self.options.force_zoom_300 == 1) || (img_asset_mode != 'asset-mode-exercice-300')) {
                        var $this = $(this);
												if($this.hasClass('show')) {
													$this.removeClass('show');
													self.$imgzoom.html('');
												}
												else{
													$('a.exercice_img').removeClass('show');
													$this.addClass('show');
													var offset = $this.find('img').offset();
													var top = Math.round(offset.top + $this.outerHeight());
													var left = Math.round(offset.left);
													var data_img_zoom = $this.data('img_zoom');
													if(typeof(data_img_zoom) != 'undefined') {
														self
															.$imgzoom
																.html(data_img_zoom)
																.css('position', 'absolute')
																.css('z-index', '100000')
																.css('top', top)
																.css('left', left)
																.show();
													}
													else {
														$.ajax({
															url: '/exercice-zoom-asset/'+img_asset_aid,
															dataType: 'html',
															success: function (data) {
																$this.data('img_zoom', data);
																self
																	.$imgzoom
																		.html(data)
																		.css('position', 'absolute')
																		.css('z-index', '100000')
																		.css('top', top)
																		.css('left', left)
																		.show();
															}
														});
													}
												}		
														
                      }
                      return false;
                    }
                  });
                }
              }
            );

            $mycontainer.find(this.options.imageAssetClasse).each(
              function() {
                var $this = $(this);
								asset_aid = $this.data('asset-aid');
								asset_mode = $this.data('asset-mode');
                if(asset_mode != '' && asset_aid != 0) {
                  var $img = $this.find('img');
                  var pattern = new RegExp(/\s*/g);   // remplacer + par *
                  var $parent = $img.parents('.question').length ? $img.parents('.question') : $img.parents('.response');
                  var content = self._stripHtml($parent.text()).replace(pattern, '');
                  if((typeof(self.options.force_zoom_img) == 'undefined' || self.options.force_zoom_img != 1) && (!$parent.length || ($parent.length && (!content.length || content.charCodeAt() == 8203)))) {
                    if(self.options.imgAlign) {
                      $parent.addClass(self.options.imgAlign);
                    }
                  } else {
                    if(!$parent.length || ($parent.length && (!content.length || content.charCodeAt() == 8203))) {
                      if(self.options.imgAlign) {
                        $parent.addClass(self.options.imgAlign);
                      }
                    }
                    var $wrap = $('<a></a>')
                      .addClass("exercice_img")
                      .attr('data-asset-mode', asset_mode)
                      .attr('data-asset-aid', asset_aid)
                      .bind({
                          click:function(){
                            if((self.options.force_zoom_300 == 1) || (asset_mode != 'exercice_300')) {
                              var $this = $(this);
															if($this.hasClass('show')) {
																$this.removeClass('show');
																self.$imgzoom.html('');
															}
															else{
																$('a.exercice_img').removeClass('show');
																$this.addClass('show');
																var offset = $this.find('img').offset();
																var top = Math.round(offset.top + $this.outerHeight());
																var left = Math.round(offset.left);
																var data_img_zoom = $wrap.data('img_zoom');
																if(typeof(data_img_zoom) != 'undefined') {
																	self
																		.$imgzoom
																			.html(data_img_zoom)
																			.css('position', 'absolute')
																			.css('z-index', '100000')
																			.css('top', top)
																			.css('left', left)
																			.show();
																}
																else {
																	$.ajax({
																		url: '/exercice-zoom-asset/'+asset_aid,
																		dataType: 'html',
																		success: function (data) {
																			$wrap.data('img_zoom', data);
																			self
																				.$imgzoom
																					.html(data)
																					.css('position', 'absolute')
																					.css('z-index', '100000')
																					.css('top', top)
																					.css('left', left)
																					.show();
																		}
																	});
																}
															}	
                            }
                            return false;
                          }
                      });
                    $.ajax({
                      url: '/exercice-zoom-asset/'+asset_aid,
                      dataType: 'html',
                      success: function (data) {
                        $wrap.data('img_zoom', data);
                      }
                    });

										var $img2 = null;
										var img_parent_tag = 	$img.parent().get(0).tagName;
										// keep tag picture if any
										if(img_parent_tag == 'PICTURE') {
											$img2 = $img.parent().clone();
										}	
										else {
											$img2 = $img.clone();
										}										
                    $img2
                      .insertAfter($img.parents(self.options.imageAssetClasse))
                      .wrap($wrap)
                      .addClass('exercice_img_small ' + asset_mode);
                    $img.parents(self.options.imageAssetClasse).remove();
                  }
                }
              }
            );
            // fin evolutions
        },
        /* _ISMEDIA */
        _isMedia : function(txt){
          if(txt.indexOf('<img') != -1 || txt.indexOf('<video') != -1 || txt.indexOf('<audio') != -1 || txt.indexOf('<object') != -1 || txt.indexOf('<embed') != -1)
            return true;
          var assets = this.options.enabledAssetClasses.split(' ');
          for(var prop in assets)
            if(txt.indexOf(assets[prop].replace('.', '')) != -1)
              return true;
          return false;
        },
        /* SPLIT METHOD */
        _split : function(txt, splitTag){
          var tabR = txt.split(splitTag);
          for(var prop in tabR)
            if(tabR[prop] == '' || tabR[prop] == ' ')
              tabR.splice(prop, 1);
          return tabR;
        },
        /**
         * RETURN TYPE OF ITEM
         */
        _getType : function(txt){
          if(typeof(txt) == 'undefined' && !txt.length)
            return false;
          var ntxt = this._stripHtml(txt);
          var pattern = new RegExp(/^\s*/i);
          ntxt = ntxt.replace(pattern, '');
          if(ntxt.length)
            return true;
          return false;
        },
        /**
         * REPLACE RESULT POPUP TOKENS WITH PARAMS VALUES
         * & SHOW RESULT LAYER
         * @see TESTRESPONSE METHOD
         */
        _showResult : function(type, params){
					var self = this;
          this.$popResult.hide();
          if(typeof(type) == 'undefined'){
              return;
          }
          if(typeof(params) == 'undefined'){
            params = {};
          }
          var title = '';
          var text = '';
					var wrap_btn_solution = null;
					var $text_solution = null;
					
          switch(type){
            case 'ko' :
							$('.exo-actions-actions').removeClass('ok');
							$('.exo-actions-actions').addClass('nok');
						  var title_solution = typeof(params.title) != 'undefined' ? params.title : (typeof(this.options.solution_title) != 'undefined' ? this.options.solution_title : '');
							var text_solution = (typeof(params.text) != 'undefined' ? params.text : (typeof(this.options.solution_text) != 'undefined' ? this.options.solution_text : ''));
						
						  // title
              title = typeof(params.title) != 'undefined' ? '<div class="exo-info-title">' + params.title + '</div>' : (typeof(this.options.ko_title) != 'undefined' ? '<div class="exo-info-title">' + this.options.ko_title + '</div>' : '');
							// score
              text = typeof(params.analysis) != 'undefined' ? params.analysis : (typeof(this.options.analysis_text) != 'undefined' ? this.options.analysis_text : '');
              if(text != '') text = '<div class="exo-info-score">'+text+'</div>';
              if(typeof(params.nbOk) != 'undefined'){
                text = text.replace('nbOk', params.nbOk);
                text = text.replace(/\(s\)/gi, params.nbOk > 1 ? 's' : '');
              }
              if(typeof(params.nb) != 'undefined')
                text = text.replace('nb', params.nb);
							// text
              text += (typeof(params.text) != 'undefined' && params.text != '')? '<div class="exo-info-text">' + params.text + '</div>' : ((typeof(this.options.ko_text) != 'undefined' && this.options.ko_text != '')? '<div class="exo-info-text">' + this.options.ko_text + '</div>' : '');
							// button solution
							if(typeof(drupalSettings.exercice_interface) != 'undefined') {
								
								// solution type
								var solution_comment = '';
								var class_type_comment = '';
								if(typeof(params.solution_type) != 'undefined'){
									switch(params.solution_type) {
										case 'dotted':
										  solution_comment = drupalSettings.exercice_interface.solution_comment_dotted;
										break;
										
										case 'hover':
										  solution_comment = drupalSettings.exercice_interface.solution_comment_hover;
											class_type_comment = 'hover';
										break;
									}
								}
								// wrapper solution
								wrap_btn_solution = $('<div></div>').addClass('wrapper-btn-solution off');
								// button
								var btn_solution = $('<button></button>')
								.addClass('btn-exo-solution')
								.text(drupalSettings.exercice_interface.btn_solution)
								.appendTo(wrap_btn_solution)
								.click(
									function(){
										var $parent = $(this).parent();
										// button is on
										if($parent.hasClass('on')) {
											$parent.removeClass('on');
											$parent.addClass('off');
											//$('.btn-solution-comment').hide();
											$('.btn-solution-comment').removeClass('show');
											$('.exo-solution-text').hide();
											$('.btn-exo-resume').remove();
											$('.btn-exo-skip').remove();
											$('.btn-exo-results').remove();
											$('.btn-exo-validate').show();
											self._replay();
										}
										// button is off
										else	{
											$parent.removeClass('off');
											$parent.addClass('on');
											//$('.btn-solution-comment').show();
											$('.btn-solution-comment').addClass('show');
											$('.exo-solution-text').show();
											$('.btn-exo-validate').hide();
											self._solution();
											// resume button
											var $btn_resume = $('<button></button>')
											.addClass('btn-exo-resume')
											.text(drupalSettings.exercice_interface.btn_resume)
											.prependTo($('.exo-actions-actions'))
											.click(
												function(){
													wrap_btn_solution.removeClass('on');
													wrap_btn_solution.addClass('off');
													//$('.btn-solution-comment').hide();
													$('.btn-solution-comment').removeClass('show');
													$('.exo-solution-text').hide();
													$('.btn-exo-skip').remove();
													$('.btn-exo-results').remove();
													$('.btn-exo-validate').show();
													self._replay();
													$(this).remove();
												}
											);
											// skip button ?
											if(typeof(drupalSettings.exercice) != 'undefined' && typeof(drupalSettings.exercice.next_url) != 'undefined') {
												var $skip_button = $('<a></a>')
												.addClass('btn-exo-skip')
												.attr('href', drupalSettings.exercice.next_url)
												.html('<span>' + drupalSettings.exercice_interface.btn_skip + '</span>')
												.appendTo($('.exo-actions-actions'));
											}
											// results button	
											if(typeof(drupalSettings.exercice) != 'undefined' && typeof(drupalSettings.exercice.results_url) != 'undefined') {
												var $skip_button = $('<a></a>')
												.addClass('btn-exo-results')
												.attr('href', drupalSettings.exercice.results_url)
												.html('<span>' + drupalSettings.exercice_interface.btn_results + '</span>')
												.appendTo($('.exo-actions-actions'));
											}
											
										}
										
										// reset height footer
										$('body.page-exercice .region-content').css('padding-bottom', $('.exercice-footer').height());
										
										return;
									}
								);
								var $solution_comment = $('<span></span>')
								.addClass('btn-solution-comment' + (class_type_comment != ''?' ' + class_type_comment:''))
								.html(solution_comment).appendTo(wrap_btn_solution);
								// text
								if((title_solution != '') || (text_solution != '')) {
									$text_solution = $('<div></div>')
									.addClass('exo-solution-text')
									.html(title_solution + text_solution);
								}						
							}
              // flagging
              if(typeof(drupalSettings.exercice) != 'undefined' && (drupalSettings.exercice.toflag != 0) && (parseFloat(this.options.exercice_id) == parseInt(this.options.exercice_id)) && !isNaN(this.options.exercice_id)) {
                $.ajax({
                  url: '/'+drupalSettings.path.currentLanguage+'/exercice/'+this.options.exercice_id+'/flag/0',
                  dataType: 'text',
                  data: 'flag_timestamp='+flag_timestamp,
                  success: function (data) {
                    // do nothing
                  }
                });
              }
            break;
            case 'ok' :
						  $('.exo-actions-actions').removeClass('nok');
							$('.exo-actions-actions').addClass('ok');
							// title
              title = typeof(params.title) != 'undefined' ? '<div class="exo-info-title">' + params.title + '</div>' : (typeof(this.options.ok_title) != 'undefined' ? '<div class="exo-info-title">' + this.options.ok_title + '</div>' : '');
							// score
							text = typeof(params.analysis) != 'undefined' ? params.analysis : (typeof(this.options.analysis_text) != 'undefined' ? this.options.analysis_text : '');
              if(text != '') text = '<div class="exo-info-score">'+text+'</div>';
              if(typeof(params.nbOk) != 'undefined'){
                text = text.replace('nbOk', params.nbOk);
                text = text.replace(/\(s\)/gi, params.nbOk > 1 ? 's' : '');
              }
              if(typeof(params.nb) != 'undefined')
              text = text.replace('nb', params.nb);
						  // text
              text += (typeof(params.text) != 'undefined' ? '<div class="exo-info-text">' + params.text + '</div>' : (typeof(this.options.ok_text) != 'undefined' ? '<div class="exo-info-text">' + this.options.ok_text + '</div>' : ''));
							$('.btn-exo-validate').hide();
              // redo button
							var $btn_redo = $('<button></button>')
							.addClass('btn-exo-redo')
							.html('<span>' + drupalSettings.exercice_interface.btn_redo + '</span>')
							.prependTo($('.exo-actions-actions'))
							.click(
								function(){
									$('button.btn-exo-validate').unbind('click');
									$('.exercice_items').remove();
									$('.exercice_result').remove();
									$('.btn-exo-next').remove();
									$('.btn-exo-results').remove();
									$('.btn-exo-validate').show();
									self._redo();		
									self._create();
									self._init();
									$(this).remove();
								}
							);
							
							// next button ?
							if(typeof(drupalSettings.exercice) != 'undefined' && typeof(drupalSettings.exercice.next_url) != 'undefined') {
								var $skip_button = $('<a></a>')
								.addClass('btn-exo-next')
								.attr('href', drupalSettings.exercice.next_url)
								.html('<span>' + drupalSettings.exercice_interface.btn_next + '</span>')
								.appendTo($('.exo-actions-actions'));
							}
							// results button	
							if(typeof(drupalSettings.exercice) != 'undefined' && typeof(drupalSettings.exercice.results_url) != 'undefined') {
								var $skip_button = $('<a></a>')
								.addClass('btn-exo-results')
								.attr('href', drupalSettings.exercice.results_url)
								.html(drupalSettings.exercice_interface.btn_results)
								.appendTo($('.exo-actions-actions'));
							}
							
							
              // flagging
              if(typeof(drupalSettings.exercice) != 'undefined' && (drupalSettings.exercice.toflag != 0) && (parseFloat(this.options.exercice_id) == parseInt(this.options.exercice_id)) && !isNaN(this.options.exercice_id)) {
                $.ajax({
                  url: '/'+drupalSettings.path.currentLanguage+'/exercice/'+this.options.exercice_id+'/flag/1',
                  dataType: 'text',
                  data: 'flag_timestamp='+flag_timestamp,
                  success: function (data) {
                    if(data == 1) drupalSettings.exercice.toflag = 0;
                  }
                });
              }
            break;
          }
          if(title == '' && text == ''){
            return;
          }
          this.$popResult.html('<div class="'+type+'">'+title+text+'</div>');
          this._initAsset(this.$popResult);
					if(wrap_btn_solution != null) {
						wrap_btn_solution.appendTo(this.$popResult);
					}
					if($text_solution != null) {
						$text_solution.appendTo(this.$popResult);
					}
          this.$popResult.show();

					if (typeof drupalSettings.embed_serie != 'undefined') {
						$('.exo-info-text a').click(
							function(e){
								e.preventDefault();
								e.stopPropagation();	
							}
						);
						$('.exo-info-text a').each(
							function(){
								var $this = $(this);
								$this.attr('data-placement', 'bottom');
								$this.attr('data-toggle', 'tooltip');
								$this.attr('data-trigger', 'hover');
								$this.attr('title', drupalSettings.disabled_links_text);
							}
						);
						$('.exo-solution-text a').click(
							function(e){
								e.preventDefault();
								e.stopPropagation();	
							}
						);
						$('.exo-solution-text a').each(
							function(){
								var $this = $(this);
								$this.attr('data-placement', 'bottom');
								$this.attr('data-toggle', 'tooltip');
								$this.attr('data-trigger', 'hover');
								$this.attr('title', drupalSettings.disabled_links_text);
							}
						);
						$("[data-toggle=tooltip]").tooltip();
					}
					
					// reset height footer
					$('body.page-exercice .region-content').css('padding-bottom', $('.exercice-footer').height());
					
					// video links
					this._init_video_link(this.$popResult);
					
        },
        /* HIDE RESULT LAYER */
        _hideResult : function(){
          this.$popResult.hide();
        },
        /**
         * TEST RESPONSE METHOD
         * @see INIT METHOD
         * @see VALIDATE BUTTON EVENT
         * @see SOLUTION BUTTON EVENT
         */
        _testResponse : function(){},
        /**
         * SOLUTION  METHOD
         * @see INIT METHOD
         * @see SOLUTION BUTTON EVENT
         */
        _solution : function(){},
        /**
         * REPLAY METHOD
         * @see INIT METHOD
         * @see REPLAY BUTTON EVENT
         * @see VALIDATE BUTTON EVENT
         */
        _replay : function(){},
        /* ZOOM IN */
        _zoomIn : function($obj){
          var height = $obj.height();
          var width = $obj.width();
          $obj.addClass('zoom');
          var nheight = $obj.height();
          var nwidth = $obj.width();
          var dheight = nheight - height;
          var dwidth = nwidth - width;
          $obj.css({
            top:$obj.position().top-dheight/2,
            left:$obj.position().left-dwidth/2
          });
        },
        /* ZOOM OUT */
        _zoomOut : function($obj){
          var height = $obj.height();
          var width = $obj.width();
          $obj.removeClass('zoom');
          var nheight = $obj.height();
          var nwidth = $obj.width();
          var dheight = height - nheight;
          var dwidth = width - nwidth;
          $obj.css({
            top:$obj.position().top+dheight/2,
            left:$obj.position().left+dwidth/2
          });
        },
        /* ALIGN TYPE IMAGE ITEM */
        _imageAlign : function(){
          this.$container.children('.file-media-exercice').each(
            function(){
              var $this = $(this);
              var parents = $this.parents('.question_content');
              if(!parents.length)
                parents = $this.parents('.response_content');
              if(!parents.length)
                return;
              $(parents[0])
                .css('display', 'table-cell')
                .css('vertical-align', 'middle');
            }
          );
        },
        /**
         * SHOW PLAYER RESPONSE LAYER
         * @see SOLUTION METHOD
         */
        _showMyResponse:function($obj, myResponse, params){
          if(!$obj.length || myResponse == null || myResponse == '')
            return false;
          var params = $.extend({
            valign:'top'
          },params);
          var pos = $obj.position();
          var left = pos.left
          var top = pos.top;
          this.$myResponse.html('');
          $('<div></div>').appendTo(this.$myResponse).addClass('exercice_myresponse_content').html(myResponse);
          switch(params.valign){
            case 'top':
              top -= this.$myResponse.outerHeight();
              this.$myResponse.addClass('top');
              break;
            case 'bottom':
              top += $obj.outerHeight() + 8;
              this.$myResponse.addClass('bottom');
              break;
          }
          if(typeof(params.top) != 'undefined')
            top += params.top;
          switch(params.align){
            case 'center':
              left = left - this.$myResponse.outerWidth()/2 + $obj.outerWidth()/2;
              this.$myResponse.addClass('center');
              break;
            case 'right':
              left = left - this.$myResponse.outerWidth() + $obj.outerWidth();
              this.$myResponse.addClass('right');
              break;
						case 'middle_left':
							left = left - $obj.outerWidth()/2;
							this.$myResponse.addClass('middle-left');
							break;
						case 'middle_right_20':
							left = left - this.$myResponse.outerWidth()/2 + $obj.outerWidth()/2 + 20;
							this.$myResponse.addClass('middle-right-20');
							break;	
          }
          this.$myResponse
            .css('position', 'absolute')
            .css('z-index', 1000)
            .css('top', top)
            .css('left', left)
            .show();
        },
        /* HIDE PLAYER RESPONSE LAYER */
        _hideMyResponse:function(){
          this.$myResponse.hide();
        },
        /* CONVERT HTML TEXT IN PLAIN TEXT */
        _stripHtml: function(str, char, tab, exclude){
          if(typeof(char) == 'undefined')
            var char = '';
          if(typeof(tab) != 'undefined'){
            var pattern = new RegExp(/<(?:.|\n)*?>/i);
            while(str.match(pattern)){
              tab.push(pattern.exec(str));
              str = str.replace(pattern, char);
            }
          } else {
            var pattern = new RegExp(/<(?:.|\n)*?>/gi);
            str = str.replace(pattern, char);
          }
          str = $('<div/>').html(str).text();
          return str;
        },
        _findAndReplace: function(target, searchAttr, replaceElement){
          var returnTab = Array();
          if(typeof(searchAttr) == 'object' && searchAttr.constructor == RegExp){
            var str = target.html();
            while(str.match(searchAttr)){
              returnTab.push(searchAttr.exec(str)[1]);
              str = str.replace(searchAttr, replaceElement);
            }
            target.html(str);
          } else {
            var $elements = this._find(target, searchAttr);
            if($elements.length){
              $elements.each(function(){returnTab.push($(this).html())}).replaceWith(replaceElement);
            }
          }
          return returnTab;
        },
        _recursiveReplace:function (str, findStr, tabReplace, htmlTag, htmlClass){
          var pattern = new RegExp(findStr);
          var r = 0;
          while(str.match(pattern)){
            str = str.replace(pattern, (typeof(htmlTag) != 'undefined' ? '<'+htmlTag+''+(typeof(htmlClass) != 'undefined' ? ' class="'+htmlClass+'"' : '')+'>' : '')+tabReplace[r]+(typeof(htmlTag) != 'undefined' ? '</'+htmlTag+'>' : ''));
            r++;
          }
          return str;
        },
        _splitTextInWords:function(str, htmlTag, classTag){
          var pattern = new RegExp(/([\s\/\-_"\'\\.§<>,=!%\*\{\};\+\?:\[\]\(\)])([^\s\/\-_"\'\\.§<>,=!%\*\{\};\+\?:\[\]\(\)]*)/gi);
          str = str.replace(pattern, '$1BeginWord$2EndWord');
          str = str.replace(/([\/\-_"\'\\.,=!%\*\{\};\+\?:\[\]\(\)])/g, '<'+htmlTag+' class="'+classTag+'">$1</'+htmlTag+'>')
          str = str.replace(/BeginWord/g, '<'+htmlTag+' class="'+classTag+'">');
          str = str.replace(/EndWord/g, '</'+htmlTag+'>');
          str = str.replace(new RegExp('<'+htmlTag+' class="'+classTag+'"></'+htmlTag+'>', 'gi'), '');
          return str;
        },
        /* RETURN UNACCENTED STRING */
        _unaccentedStr: function(str){
          if(typeof(str) == 'undefined')
            return;
          var pattern = Array('é','è','ê','ë','à','â','ä','ù','û','ü','ï','î','ö','ô','À','Â','É','È','Ê','Ë','Ô','Î','Ï','Û','Ü','Ù');
          var replace_pattern = Array('e','e','e','e','a','a','a','u','u','u','i','i','o','o','A','A','E','E','E','E','O','I','I','U','U','U');
          for(var delta in pattern){
            var reg_exp = RegExp(pattern[delta], 'gi');
            str = str.replace(reg_exp, replace_pattern[delta]);
          }
          return str;
        },
        _initKeyboard:function(){
          var self = this;
          this.$keyboard = $('<ul></ul>')
            .appendTo(this.$container)
            .addClass('exercice_keyboard')
						.wrap('<div class="wrapper-exercice-keyboard"></div>')
            .hover(
              function(){
                self.$activeElement=$(document.activeElement);
              },
              function(){
                self.$activeElement = null;
              }
            );
          for(var prop in this.options.tabAccents){
            $('<li></li>')
              .appendTo(this.$keyboard)
              .html(this.options.tabAccents[prop])
              .click(
                function(){
                  var $this = $(this);
                  var maxlength = self.$activeElement.attr('maxlength');
                  var length = self.$activeElement.val().length;
                  if(maxlength === 1){
                    self.$activeElement.val($this.text());
                  } else if(maxlength > length || maxlength == -1 || typeof(maxlength) == 'undefined') {
                    var startIndex = self.$activeElement[0].selectionStart;
                    var endIndex = self.$activeElement[0].selectionEnd;
                    var beginText = self.$activeElement.val().substring(0, startIndex);
                    var endText = self.$activeElement.val().substring(endIndex);
                    self.$activeElement.val(beginText+$this.text()+endText);
                    length = self.$activeElement.val().length;
                    self.$activeElement[0].setSelectionRange(startIndex+1, startIndex+1);
                    self.$activeElement.focus();
                  }
                  if(typeof(self._setInputVal) == 'function'){
                    self._setInputVal(self.$activeElement, $this.text());
                  }
                  if(typeof(self._nextInput) == 'function'){
                    self._nextInput(self.$activeElement);
                    self.$activeElement=$(document.activeElement);
                  }
                  return false;
                }
              );
          }
					var $bt_case = $('<ul></ul>')
            .appendTo(this.$container)
            .addClass('bt-case');
					$('<li></li>')
					  .addClass('majuscule')
						.appendTo($bt_case)
						.html('AA')
						.click(
							function(){
								var $this = $(this);
								$this.addClass('active');
								$('.minuscule').removeClass('active');
								self.$keyboard.children('li').each(function(){$this=$(this);$this.text($this.text().toUpperCase())});
							}
						);
					$('<li></li>')
					  .addClass('minuscule')
						.addClass('active')
						.appendTo($bt_case)
						.html('aa')
						.click(
							function(){
								var $this = $(this);
								$this.addClass('active');
								$('.majuscule').removeClass('active');
								self.$keyboard.children('li').each(function(){$this=$(this);$this.text($this.text().toLowerCase())});
							}
						);	
					this.$keyboard.after($bt_case);				
					
          $(window).keydown(function(e){
            switch(e.keyCode){
							// caps lock
              case 20 :
                if(self.capsLock == 1){
									$('.minuscule').addClass('active');
									$('.majuscule').removeClass('active');
                  self.capsLock = 0;
                  self
                    .$keyboard
                      .children('li')
                        .each(function(){$this=$(this);$this.text($this.text().toLowerCase())});
                } else {
									$('.majuscule').addClass('active');
									$('.minuscule').removeClass('active');
                  self.capsLock = 1;
                  self
                    .$keyboard
                      .children('li')
                        .each(function(){$this=$(this);$this.text($this.text().toUpperCase())});
                }
                break;
							// shift	
              case 16 :
							  $('.majuscule').addClass('active');
								$('.minuscule').removeClass('active');
                self
                  .$keyboard
                    .children('li')
                      .each(function(){$this=$(this);$this.text($this.text().toUpperCase())});
              break;
            }
          });
          $(window).keyup(function(e){
            switch(e.keyCode){
							// shift
              case 16 :
                if(!self.capsLock) {
									$('.minuscule').addClass('active');
									$('.majuscule').removeClass('active');
                  self
                    .$keyboard
                    .children('li')
                      .each(function(){$this=$(this);$this.text($this.text().toLowerCase())});
								}			
              break;
            }
          });
        },
        _find:function(target, searchAttr){
          var $return = null;
          switch(searchAttr){
            case 'underline' :
              $return = target.find('u, span, div, p')
                .filter(
                  function(){
                    var $this = $(this);
                    if(($this[0]['nodeName'] == 'U' || (((typeof($this.css('text-decoration')) != 'undefined' && $this.css('text-decoration').toLowerCase() == 'underline') || (typeof($this.attr('style')) != 'undefined') && $this.attr('style').toLowerCase().indexOf('underline') != -1))))
                      return true;
                  }
                );
              break;
            case 'line-through' :
              $return = target.find('strike, s, span, div, p')
                .filter(
                  function(){
                    var $this = $(this);
                    if(($this[0]['nodeName'] == 'STRIKE' || $this[0]['nodeName'] == 'S' || (((typeof($this.css('text-decoration')) != 'undefined' && $this.css('text-decoration').toLowerCase() == 'line-through') || (typeof($this.attr('style')) != 'undefined') && $this.attr('style').toLowerCase().indexOf('line-through') != -1))))
                      return true;
                  }
                );
              break;
            case 'bold' :
              $return = target.find('b, strong, span, div , p')
                .filter(
                  function(){
                    var $this = $(this);
                    if(($this[0]['localName'] == 'B' || $this[0]['localName'] == 'STRONG' || (((typeof($this.css('font-size')) != 'undefined' && $this.css('font-size').toLowerCase() == 'bold') || (typeof($this.attr('style')) != 'undefined' && $this.attr('style').toLowerCase().indexOf('bold') != -1)))))
                      return true;
                  }
                );
              break;
            default :
              $return = target.find(searchAttr);
            break;
          }
          return $return;
        },
				_init_video_link:function(target) {
					target.find('span.special-timecode-video').each(function(index, item) {
						var video_id = '';
						var timecode = $(item).data('timecode');
						var $video = null;
						var mid = $(item).data('mid');
						if (mid) {
							$video = $('#video-media-video-tv5-jwplayer-' + mid + '-0');
						}
						else {
							var $video_temp = $('.tv5monde_player').first();
							if ($video_temp.length) {
								$video = $video_temp.parent();
							}
						}
						if ($video && $video.length) {
							video_id = $video.attr('id');
						}
					 
						if(timecode && video_id) {	
							$(item).attr('tabindex', 0);
							$(item).addClass('with-video');
							$(item).unbind('click').bind('click', function(e) {
								var vid = $video.find('video')[0];
								if (typeof vid != 'undefined') {
									document.getElementById(video_id).scrollIntoView({ behavior: 'smooth' });
									vid.currentTime = parseFloat(timecode);
									if (vid.paused) {
										vid.play();
									}
								}					
							});
							$(item).keydown(function(e){
								if(e.which === 13){
									$(this).click();
								}
							});
						}
					});
				}
      }
    );
    /**
     * GLISSER DEPOSER ASSOCIATION
     */
    $.widget(
      'demo.exercice_gda',
      $.demo.exercice,
      {
        options:{
            imgAlign:'middle',
            force_zoom_img:1,
            force_zoom_300:1
        },
        _init : function(){
					var self = this;
          $.demo.exercice.prototype._init.call(this);
					// not mobile
					if(!is_mobile) {
						// get max height
						this.$container.imagesLoaded( function() {
							
							// images have loaded
							var max_height = 0;
							var width_qc = $('.question_content').outerWidth(true);
							var width_r = $('.response').outerWidth(true) - 32;
							
							$('.response_droppable').css('width', width_qc);
							$('.response_content').css('width', width_r - width_qc - 14);
							
							$('.question_content').each(function(i) {
								var qheight = $(this).outerHeight(true);
								if(qheight > max_height) {
									max_height = qheight;
								}
							});
							$('.response_content').each(function(i) {
								var rheight = $(this).outerHeight(true);
								if(rheight > max_height) {
									max_height = rheight;
								}
							});
							$('.question_content').css('height', max_height);
							$('.response_content').css('height', max_height);
						});
					}	
					// mobile
					else {
						// get max height and width question, width response
						this.$container.imagesLoaded( function() {
							
							// images have loaded
							var max_height = 0;				
							
							$('.question_content').each(function(i) {
								var qheight = $(this).outerHeight(true);
								if(qheight > max_height) {
									max_height = qheight;
								}
							});
							$('.response_content').each(function(i) {
								var rheight = $(this).outerHeight(true);
								if(rheight > max_height) {
									max_height = rheight;
								}
							});
							self.$container.data('max_height', max_height);
							$('.question_content').css('height', max_height);
							$('.response_content').css('height', max_height);
							
							self.$container.data('question_width', $('.question_content').outerWidth(true));
							self.$container.data('response_width', $('.response_content').outerWidth(true));
						});
					}
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
					
					// not mobile
					if(!is_mobile) {
						this.$container.addClass('no-mobile');
						// questions
						var $container_question = $('<div></div>')
						  .appendTo(this.$container)
						  .addClass('questions-container');
					
						var tempIndex = [];
						for (var i = 0; i<this.nbQ; i++) {
							tempIndex.push(i);
						}

						for (var r=this.nbQ; r>=1; r--) {
							var tAI = tempIndex.splice(Math.floor(Math.random()*r), 1);
							var tI = tAI[0];
							var $question = $('<div></div>')
								.appendTo($container_question)
								.addClass('question question_' + tI)
								.html('<div class="question_content"><div class="inner-content">' + this.options.json['items'][tI]['question'] + '</div></div>')
								.droppable({
									accept: '.question_draggable_' + tI,
									hoverClass: 'hovered',
									drop: function(event, ui){
										var $draggable = $(ui.draggable);
										var $this = $(this);
