								});	
							var $question_draggable = $('<div></div>')
							  .appendTo($question)
							  .addClass('question_draggable question_draggable_' + tI)
								.html('<div class="qd-inner"><div class="inner-content">' + this.options.json['items'][tI]['question'] + '</div></div>')
								.data('qid', tI)
								.data('from_id', 'question_' + tI)
								.draggable({
									containment: '.exercice_items',
									revert: 'invalid',
									zIndex : 10000,
									start : function(event, ui){
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
									},
