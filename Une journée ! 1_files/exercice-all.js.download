										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
									}
								})
								.disableSelection();	
						}
	
					  // responses
						var $container_response = $('<div></div>')
						  .appendTo(this.$container)
						  .addClass('responses-container');
						for (var i = 0; i<this.nbQ; i++) {
							var $response = $('<div></div>')
								.appendTo($container_response)
								.addClass('response response_'+i)
								.html('<div class="response_content"><div class="inner-content">' + this.options.json['items'][i]['response'] + '</div></div>');
							var $response_droppable = $('<div></div>')
							  .prependTo($response)
							  .addClass('response_droppable response_droppable_' + i)
								.data('rid', i)
								.data('qid', -1)
								.html('<span>'+dropbox_label+'</span>')
								.droppable({
									accept: '.question_draggable',
									hoverClass: 'hovered',
									drop: function(event, ui){
										var $draggable = $(ui.draggable);
										var $this = $(this);
										var qhtml = $draggable.find('.inner-content').html();
										var qid = $draggable.data('qid');
										var from_id = $draggable.data('from_id');
										
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
										
										if($draggable.hasClass('ui-draggable')) {
											$draggable.draggable('destroy');
										}
										$draggable.remove();
										$('.' + from_id).droppable('enable');
										$this.droppable('disable');										
										$('.' + from_id).removeClass('bad');
										$('.' + from_id).data('qid', -1);
										$this.data('qid', qid);
										self._initImg($this);
										//audio
										self._enableQuestionAudio($this);						
										
										var $question_draggable = $('<div></div>')
											.appendTo($this)
											.addClass('question_draggable question_draggable_' + qid)
											.html('<div class="qd-inner"><div class="inner-content">' + qhtml + '</div></div>')
											.data('qid', qid)
											.data('from_id', 'response_droppable_' + $this.data('rid'))
											.draggable({
												containment: '.exercice_items',
												revert: 'invalid',
												zIndex : 10000,
												start : function(event, ui){
													$('a.exercice_img').removeClass('show');
													self.$imgzoom.html('');
												},
												stop : function(event, ui){
													$('a.exercice_img').removeClass('show');
													self.$imgzoom.html('');
												}
											})
											.disableSelection();
										self._initImg($question_draggable);
										//audio
										self._enableQuestionAudio($question_draggable);	
										
										// click remove dropped
										var remove_btn = $('<div></div>')
										  .addClass('remove-dropped')
											.data('qid', qid)
											.data('from_id', 'response_droppable_' + $this.data('rid'))
											.appendTo($question_draggable)
										  .unbind('click').bind('click', function(e) {
												if(e.target !== this) return false;
												var $dthis = $(this);								
												var $question_draggable_q = $('<div></div>')
													.appendTo($('.question_' + $dthis.data('qid')))
													.addClass('question_draggable question_draggable_' + $dthis.data('qid'))
													.html('<div class="qd-inner">' + $('.question_' + $dthis.data('qid') +' .question_content').html() + '</div>')
													.data('qid', $dthis.data('qid'))
													.data('from_id', 'question_' + $dthis.data('qid'))
													.draggable({
														containment: '.exercice_items',
														revert: 'invalid',
														zIndex : 10000,
														start : function(event, ui){
															$('a.exercice_img').removeClass('show');
															self.$imgzoom.html('');
														},
														stop : function(event, ui){
															$('a.exercice_img').removeClass('show');
															self.$imgzoom.html('');
														}
													})
													.disableSelection();
													
												$('.' + $dthis.data('from_id')).droppable('enable');
												if($dthis.parent().hasClass('ui-draggable')) {
													$dthis.parent().draggable('destroy');
												}
												$dthis.parent().parent().data('qid', -1);
												$dthis.parent().parent().removeClass('bad');
												$dthis.parent().remove();
												
												self._initImg($question_draggable_q);
												//audio
												self._enableQuestionAudio($question_draggable_q);
												
												return false;
											});
										/*$this.unbind('click').bind('click', function(e) {
											if(e.target !== this) return false;
											var $dthis = $(this);
											$dthis.removeClass('dropped');
											$dthis.html('<span>' + dropbox_label + '</span>');											
											var $question_draggable = $('<div></div>')
												.appendTo($('.question_' + $dthis.data('qid')))
												.addClass('question_draggable question_draggable_' + $dthis.data('qid'))
												.html($('.question_' + $dthis.data('qid') +' .question_content').html())
												.data('qid', $dthis.data('qid'))
												.draggable({
													containment: '.exercice_items',
													revert: 'invalid',
													zIndex : 10000,
													start : function(event, ui){
														$('a.exercice_img').removeClass('show');
														self.$imgzoom.html('');
													},
													stop : function(event, ui){
														$('a.exercice_img').removeClass('show');
														self.$imgzoom.html('');
													}
												})
												.disableSelection();	
											$dthis.droppable('enable');
											$dthis.data('qid', -1);
											$dthis.unbind('click');										
											self._initImg($question_draggable);
											//audio
											self._enableQuestionAudio($question_draggable);
											
											return false;
										});*/
									}			
								});
						}
						
					}
					// mobile
					else {
						this.$container.addClass('mobile');
						var $qrContainer = $('<div></div>')
						  .appendTo(this.$container)
						  .addClass('qr-container');
					  var $myResponsesContainer = $('<div></div>')
						  .prependTo(this.$container)
						  .addClass('myresponses-container');
							
						// questions
						var $container_question = $('<div></div>')
						  .appendTo($qrContainer)
						  .addClass('questions-container');
					
						var tempIndex = [];
						for (var i = 0; i<this.nbQ; i++) {
							tempIndex.push(i);
						}
						for (var r=this.nbQ; r>=1; r--) {
							var tAI = tempIndex.splice(Math.floor(Math.random()*r), 1);
							var tI = tAI[0];
							var $question = $('<div></div>')
								.appendTo($container_question)
								.data('qid', tI)
								.addClass('question question_'+tI)
								.wrap('<div class="wrap-question wrap-question-' + tI + '"></div>')
								.html('<div class="question_content"><div class="inner-content">' + this.options.json['items'][tI]['question'] + '</div></div>');	
							// click question	
							$question.unbind('click').bind('click', function(e) {
								$target = $(e.target);
								if(!($target.hasClass('question') || $target.hasClass('question_content') || $target.hasClass('inner-content'))) {
									return false;
								}
								var $this = $(this);
								if(!$('.questions-container').hasClass('selected')) {	
									$this.addClass('selected');
									$('.responses-container').addClass('selectionable');
									//remove click images
									$('.responses-container').find('a.exercice_img').each(
										function() {
											var $this = $(this);
											$this.unbind('click');
										}
									);
									
									$('.questions-container').addClass('selected');
									$('.responses-container').data('qid', $this.data('qid'));	
								}
								else {
									$('.questions-container .question').removeClass('selected');
									$('.responses-container').removeClass('selectionable');
									$('.questions-container').removeClass('selected');
									$('.responses-container').removeData('qid');
									// re-init click images
									self._initImg($('.responses-container'));
								}
							});	
						}
						
						// responses
						var $container_response = $('<div></div>')
						  .appendTo($qrContainer)
						  .addClass('responses-container');
						for (var i = 0; i<this.nbQ; i++) {
							var $response = $('<div></div>')
								.appendTo($container_response)
								.data('rid', i)
								.addClass('response response_'+i)
								.wrap('<div class="wrap-response show wrap-response-' + i + (i==(this.nbQ-1)?' last':'') + '"></div>')
								.html('<div class="response_content"><div class="inner-content">' + this.options.json['items'][i]['response'] + '</div></div>');
								
							// click response
							$response.bind('click', function(e) {
								var $rthis = $(this);
								if($('.responses-container').hasClass('selectionable')/* && !$rthis.hasClass('solution')*/) {
									var qid = $('.responses-container').data('qid');
									var rid = $rthis.data('rid');
									var $myqr = $('<div></div>')
										.appendTo($('.myresponses-container'))
										.data('qid', qid)
										.data('rid', rid)
										.html('<div class="myq"><div class="wrap-myq-content"><div class="myq-content">' + $('.question_' + qid + ' .question_content').html() + '</div></div></div>' + '<div class="myr"><div class="wrap-myr-content"><div class="myr-content">' + $('.response_' + rid + ' .response_content').html() + '</div></div></div>')
										.addClass('myqr');
									self._initImg($myqr);
									//audio
									self._enableQuestionAudio($myqr.find('.myq-content'));
									self._enableResponseAudio($myqr.find('.myr-content'));
									$('a.exercice_img').removeClass('show');
									self.$imgzoom.html('');
									// re-init click images
									self._initImg($('.responses-container'));	
									
									$('.myq-content').unbind('click').bind('click', function(e) {
										if( e.target !== this) return false;
										var $mqthis = $(this);
										var $mqrthis = $mqthis.parent().parent().parent();
										var mqid = $mqrthis.data('qid');
										var mrid = $mqrthis.data('rid');	
										$('.wrap-question-' + mqid).show();
										$('.wrap-response-' + mrid).show();
										$('.wrap-response-' + mrid).addClass('show');
										$mqrthis.remove();
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
										
										// search last wrap-response with show class
										var last_i = 0;
										for (var wr = 0; wr<self.nbQ; wr++) {
											$('.wrap-response-' + wr).removeClass('last');
											if($('.wrap-response-' + wr).hasClass('show')) {
												last_i = wr;
											}
										}
										$('.wrap-response-' + last_i).addClass('last');	
									});	
									$('.myq-content').css('height', self.$container.data('max_height'));
									$('.myr-content').css('height', self.$container.data('max_height'));
									$('.myq-content').css('width', self.$container.data('question_width'));
									$('.myr-content').css('width', self.$container.data('response_width'));
									$('.wrap-question-' + qid).hide();
									$('.wrap-response-' + rid).hide();
									$('.wrap-response-' + rid).removeClass('show');
									$('.question_' + qid).removeClass('selected');
									$('.responses-container').removeClass('selectionable');
									$('.questions-container').removeClass('selected');
									// search last wrap-response with show class
									var last_i = 0;
									for (var wr = 0; wr<self.nbQ; wr++) {
										$('.wrap-response-' + wr).removeClass('last');
										if($('.wrap-response-' + wr).hasClass('show')) {
											last_i = wr;
										}
									}
									$('.wrap-response-' + last_i).addClass('last');	
								}		
							});	
						}
						
					}
					this._init_video_link($('.responses-container .response_content'));
        },
        _testResponse : function(){
					var self = this;
					// not mobile
					if(!is_mobile) {
						var nbOk = 0;
						for (var i = 0; i<this.nbQ; i++) {
							var $response_droppable = this.$container.find('.response_droppable_'+i);
							var qid = $response_droppable.data('qid');
							var rid = $response_droppable.data('rid');
							if((qid == rid)) {
								if(!$response_droppable.hasClass('good')) {
									$response_droppable.addClass('good');
									$response_droppable.find('.question_draggable.ui-draggable').draggable('disable');
									$response_droppable.find('.question_draggable .remove-dropped').remove();
								}
								nbOk++;
							}
							else if(qid != -1) {
								$response_droppable.addClass('bad');
							} 
						}
						if (nbOk == this.nbQ) {
							this._showResult('ok', {nbOk:nbOk, nb:this.nbQ});
						} else {
							this._showResult('ko', {nbOk:nbOk, nb:this.nbQ, solution_type:'hover'});
						}
					}
					// mobile
					else {
						var nbOk = 0;
						if($('.myqr').length) {
							$('.myqr').each(function(i) {
								var $this = $(this);
								var qid = $this.data('qid');
								var rid = $this.data('rid');
								if(qid == rid) {
									$this.addClass('good');
									nbOk++;
									$this.find('.myq-content').unbind('click');
								}
								else {
									$this.addClass('bad');
								}
							});	
						}
						
						if (nbOk == this.nbQ) {
							this._showResult('ok', {nbOk:nbOk, nb:this.nbQ});
						} else {
							this._showResult('ko', {nbOk:nbOk, nb:this.nbQ, solution_type:'hover'});
						}
					}	
        },
        _solution : function() {
          var self = this;
					// not mobile
					if(!is_mobile) {
						this.$container.addClass('solution');
						$('.question .question_draggable.ui-draggable').draggable('destroy');
						$('.question .question_draggable').remove();
						$('.response_droppable').droppable('disable');
						for (var i = 0; i<this.nbQ; i++) {
							var $response_droppable = this.$container.find('.response_droppable_'+i);
							var qid = $response_droppable.data('qid');
							var rid = $response_droppable.data('rid');
							if(qid != rid) {
								$response_droppable.addClass('solution dropped');
								$response_droppable.unbind('click');
								$response_droppable.html($('.question_' + rid + ' .question_content').html());
								self._initImg($response_droppable);
								//audio
								self._enableQuestionAudio($response_droppable);
								if(qid != -1) {
									$response_droppable.bind({
										mouseenter:function(e){
											var $this = $(this);
											var mySelection = $('.question_' + $this.data('qid') +' .question_content').html();
											var rwidth = $this.outerWidth(true);
											var rheight = $this.outerHeight(true);
											$('.exercice_myresponse').css('width', rwidth);
											$('.exercice_myresponse').css('height', rheight);
											self._showMyResponse($this, mySelection, {valign:'bottom', align:'middle_left'});
										},
										mouseleave:function(e){
											self._hideMyResponse();
										}
									});
								}	
							}
							else if(!$response_droppable.hasClass('good')) {
								$response_droppable.addClass('good');
								$response_droppable.find('.question_draggable.ui-draggable').draggable('disable');
								$response_droppable.find('.question_draggable .remove-dropped').remove();
							}
						}
					}
					// mobile 
					else {
						this.$container.addClass('solution');
						$('.question').removeClass('selected');
						$('.responses-container').removeClass('selectionable');
						$('.questions-container').removeClass('selected');
						$('.responses-container').removeData('qid');
					  var tab_q = [];
						// q/r selected
						if($('.myqr').length) {
							$('.myqr').each(function(i) {
								var $this = $(this);
								var qid = $this.data('qid');
								var rid = $this.data('rid');
								// bad
								if(qid != rid) {
									tab_q.push(rid);
									var qhtml = $('.question_' + rid +' .question_content').html();
									$('.wrap-question-' + rid).hide();
									$this.removeClass('bad');
									$this.addClass('solution');
									$this.find('.myq-content').html(qhtml);
									self._initImg($this);
									//audio
									self._enableQuestionAudio($this.find('.myq-content'));
									$this.find('.myq-content').unbind('click');
									$this.find('.myq-content').bind({
										mouseenter:function(e){
											var $mthis = $(this);
											var mySelection = $('.question_' + $mthis.parent().parent().parent().data('qid') + ' .question_content').html();
											var rwidth = $mthis.outerWidth(true);
											var rheight = $mthis.outerHeight(true);
											$('.exercice_myresponse').css('width', rwidth);
											$('.exercice_myresponse').css('height', rheight);
											self._showMyResponse($mthis, mySelection, {valign:'bottom', align:'middle_right_20'});
										},
										mouseleave:function(e){
											self._hideMyResponse();
										}
									});
								}
								// good
								else {
									tab_q.push(rid);
									$this.find('.myq-content').unbind('click');
									// selected but not validated
									if(!$this.hasClass('good')) {
										$this.addClass('good');									
									}
								}
							});
						}
						// q/r not selected
						for (var i = 0; i<this.nbQ; i++) {
							if($.inArray(i, tab_q) == -1) {
								var $myqr = $('<div></div>')
									.appendTo($('.myresponses-container'))
									.html('<div class="myq"><div class="wrap-myq-content"><div class="myq-content">' + $('.question_' + i + ' .question_content').html() + '</div></div></div>' + '<div class="myr"><div class="wrap-myr-content"><div class="myr-content">' + $('.response_' + i + ' .response_content').html() + '</div></div></div>')
									.addClass('myqr solution not-selected');
								self._initImg($myqr);
								//audio
								self._enableQuestionAudio($myqr.find('.myq-content'));
								self._enableResponseAudio($myqr.find('.myr-content'));	
								$('.myq-content').css('height', self.$container.data('max_height'));
								$('.myr-content').css('height', self.$container.data('max_height'));
								$('.myq-content').css('width', self.$container.data('question_width'));
								$('.myr-content').css('width', self.$container.data('response_width'));
								$('.wrap-question-' + i).hide();
								$('.wrap-response-' + i).hide();
								$('.wrap-response-' + i).removeClass('show');								
							}
						}			
					}	
        },
        _replay : function(){
					var self = this;
					// not mobile
					if(!is_mobile) {
						if(this.$container.hasClass('solution')) {
							this.$container.removeClass('solution');
							var tab_q = [];
							for (var i = 0; i<this.nbQ; i++) {
								var $response_droppable = this.$container.find('.response_droppable_'+i);
								var qid = $response_droppable.data('qid');
								var rid = $response_droppable.data('rid');
								// solution = no response or bad response
								if($response_droppable.hasClass('solution')) {
									$response_droppable.removeClass('solution');
									
									// no response before
									if(qid == -1) {
										$response_droppable.removeClass('dropped');
										$response_droppable.html('<span>' + dropbox_label + '</span>');
										$response_droppable.droppable('enable');
									}	
									// response bad
									else {
										tab_q.push(qid);
										$response_droppable.unbind('mouseenter');
										$response_droppable.unbind('mouseleave');	
										$response_droppable.html('<span>' + dropbox_label + '</span>');
										$response_droppable.addClass('bad');

										var $question_draggable = $('<div></div>')
											.appendTo($response_droppable)
											.addClass('question_draggable question_draggable_' + qid)
											.html('<div class="qd-inner">' + $('.question_' + qid +' .question_content').html() + '</div>')
											.data('qid', qid)
											.data('from_id', 'response_droppable_' + rid)
											.draggable({
												containment: '.exercice_items',
												revert: 'invalid',
												zIndex : 10000,
												start : function(event, ui){
													$('a.exercice_img').removeClass('show');
													self.$imgzoom.html('');
												},
												stop : function(event, ui){
													$('a.exercice_img').removeClass('show');
													self.$imgzoom.html('');
												}
											})
											.disableSelection();
										self._initImg($question_draggable);
										//audio
										self._enableQuestionAudio($question_draggable);	
										
										// click remove dropped
										var remove_btn = $('<div></div>')
										  .addClass('remove-dropped')
											.data('qid', qid)
											.data('from_id', 'response_droppable_' + rid)
											.appendTo($question_draggable)
										  .unbind('click').bind('click', function(e) {
												if(e.target !== this) return false;
												var $dthis = $(this);								
												var $question_draggable_q = $('<div></div>')
													.appendTo($('.question_' + $dthis.data('qid')))
													.addClass('question_draggable question_draggable_' + $dthis.data('qid'))
													.html('<div class="qd-inner">' + $('.question_' + $dthis.data('qid') +' .question_content').html() + '</div>')
													.data('qid', $dthis.data('qid'))
													.data('from_id', 'question_' + $dthis.data('qid'))
													.draggable({
														containment: '.exercice_items',
														revert: 'invalid',
														zIndex : 10000,
														start : function(event, ui){
															$('a.exercice_img').removeClass('show');
															self.$imgzoom.html('');
														},
														stop : function(event, ui){
															$('a.exercice_img').removeClass('show');
															self.$imgzoom.html('');
														}
													})
													.disableSelection();
													
												$('.' + $dthis.data('from_id')).droppable('enable');
												if($dthis.parent().hasClass('ui-draggable')) {
													$dthis.parent().draggable('destroy');
												}	
												$dthis.parent().parent().data('qid', -1);
												$dthis.parent().parent().removeClass('bad');
												$dthis.parent().remove();
												
												self._initImg($question_draggable_q);
												//audio
												self._enableQuestionAudio($question_draggable_q);
												
												return false;
											});



										
										/*$response_droppable.html($('.question_' + qid +' .question_content').html());
										self._initImg($response_droppable);
										//audio
										self._enableQuestionAudio($response_droppable);
										$response_droppable.unbind('click').bind('click', function(e) {
											if(e.target !== this) return false;
											var $this = $(this);
											$this.removeClass('dropped');
											$this.html('<span>' + dropbox_label + '</span>');											
											var $question_draggable = $('<div></div>')
												.appendTo($('.question_' + $this.data('qid')))
												.addClass('question_draggable question_draggable_' + $this.data('qid'))
												.html('<div class="qd-inner">' + $('.question_' + $this.data('qid') +' .question_content').html() + '</div>')
												.data('qid', $this.data('qid'))
												.draggable({
													containment: '.exercice_items',
													revert: 'invalid',
													zIndex : 10000,
													start : function(event, ui){
														$('a.exercice_img').removeClass('show');
														self.$imgzoom.html('');
													},
													stop : function(event, ui){
														$('a.exercice_img').removeClass('show');
														self.$imgzoom.html('');
													}
												})
												.disableSelection();
											self._initImg($question_draggable);
											//audio
											self._enableQuestionAudio($question_draggable);
											$this.droppable('enable');
											$this.data('qid', -1);
											$this.unbind('click');	
											return false;
										});*/
										
									}
								}
								// good response
								else {
									tab_q.push(qid);
								}
							}
							// replace some draggable question (not bad, not good)
							for (var i = 0; i<this.nbQ; i++) {
								if($.inArray(i, tab_q) == -1) {
									var qhtml = $('.question_' + i +' .question_content').html();
									var $question_draggable = $('<div></div>')
										.appendTo($('.question_' + i))
										.addClass('question_draggable question_draggable_' + i)
										.html('<div class="qd-inner">' + qhtml + '</div>')
										.data('qid', i)
										.draggable({
											containment: '.exercice_items',
											revert: 'invalid',
											zIndex : 10000,
											start : function(event, ui){
												$('a.exercice_img').removeClass('show');
												self.$imgzoom.html('');
											},
											stop : function(event, ui){
												$('a.exercice_img').removeClass('show');
												self.$imgzoom.html('');
											}
										})
										.disableSelection();
									self._initImg($question_draggable);
									self._enableQuestionAudio($question_draggable);
								}
							}
						}
					}	
					// mobile
					else {
						if(this.$container.hasClass('solution')) {
							this.$container.removeClass('solution');
							var tab_q = [];
							var tab_r = [];
							if($('.myqr').length) {
								$('.myqr').each(function(i) {
									var $this = $(this);
									// q/r not selected
									if($this.hasClass('not-selected')) {
										$this.remove();
									}
									else {
										var qid = $this.data('qid');
										var rid = $this.data('rid');
										// good
										if(qid == rid) {
											tab_q.push(qid);
											tab_r.push(rid);
											$this.find('.myq-content').unbind('click');
										}
										// bad
										else {
											tab_q.push(qid);
											tab_r.push(rid);
											var qhtml = $('.question_' + qid +' .question_content').html();
											$this.find('.myq-content').html(qhtml);
											self._initImg($this);
											//audio
											self._enableQuestionAudio($this.find('.myq-content'));
											$this.addClass('bad');
											$this.removeClass('solution');
											$this.find('.myq-content').unbind('mouseenter');
											$this.find('.myq-content').unbind('mouseleave');
											$this.find('.myq-content').unbind('click').bind('click', function(e) {
												if(e.target !== this) return false;
												var $mqthis = $(this);
												var $mqrthis = $mqthis.parent().parent().parent();
												var mqid = $mqrthis.data('qid');
												var mrid = $mqrthis.data('rid');	
												$('.wrap-question-' + mqid).show();
												$('.wrap-response-' + mrid).show();
												$('.wrap-response-' + mrid).addClass('show');
												$mqrthis.remove();
												// search last wrap-response with show class
												var last_i = 0;
												for (var wr = 0; wr<self.nbQ; wr++) {
													$('.wrap-response-' + wr).removeClass('last');
													if($('.wrap-response-' + wr).hasClass('show')) {
														last_i = wr;
													}
												}
												$('.wrap-response-' + last_i).addClass('last');												
											});										
										}
									}
								});	
							}

							// re-show q/r not selected
							for (var i = 0; i<this.nbQ; i++) {
								if($.inArray(i, tab_q) == -1) {		
									$('.wrap-question-' + i).show();							
								}
								if($.inArray(i, tab_r) == -1) {
									$('.wrap-response-' + i).show();
									$('.wrap-response-' + i).addClass('show');
									// search last wrap-response with show class
									var last_i = 0;
									for (var wr = 0; wr<self.nbQ; wr++) { 
										$('.wrap-response-' + wr).removeClass('last');
										if($('.wrap-response-' + wr).hasClass('show')) {
											last_i = wr;
										}
									}
									$('.wrap-response-' + last_i).addClass('last');	
								}
							}	
						}		
					}
        },
				_enableQuestionAudio: function($container) {
					$container.find('.jp-audio').each(function(){
						var $athis = $(this);
						$athis.unbind('click').bind('click', function() {
							var $pthis = $(this);
							var $id = $pthis.attr('id').substr(13);
							var $jp_player = $('.question').find('#jquery_jplayer_' + $id);
							var $jp_container = $('.question').find('#jp_container_' + $id);
							if($jp_player.length && $jp_container.length) {
								if($jp_container.hasClass('jp-state-playing')) {
									$jp_player.jPlayer('pause');
								}
								else {
									$jp_player.jPlayer('play');
								}
							}
						});
					});
				},
				_enableResponseAudio: function($container) {
					$container.find('.jp-audio').each(function(){
						var $athis = $(this);
						$athis.unbind('click').bind('click', function() {
							var $pthis = $(this);
							var $id = $pthis.attr('id').substr(13);
							var $jp_player = $('.response').find('#jquery_jplayer_' + $id);
							var $jp_container = $('.response').find('#jp_container_' + $id);
							if($jp_player.length && $jp_container.length) {
								if($jp_container.hasClass('jp-state-playing')) {
									$jp_player.jPlayer('pause');
								}
								else {
									$jp_player.jPlayer('play');
								}
							}
						});
					});
				},
				_redo : function(){
        }
      }
    );
    /**
     * GLISSER DEPOSER COLONNES
     */
    $.widget(
      'demo.exercice_gdc',
      $.demo.exercice,
      {
        $responses:null,
        nbR:null,
        tabQR:[],
        options:{
          force_zoom_img:1,  // evolutions
          force_zoom_300:1
        },
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
					var self = this;
					
					// not mobile
					if(!is_mobile) {
						// set some width and height
						this.$container.imagesLoaded( function() {
							
							// images have loaded
							
							// width question and response
							var nbQ = $('.question').length;
							var pct = Math.round(100/nbQ) - 1;
							$('.question').css('width', pct+'%');
							//var width_r = Math.floor($('.dropbox-label').width());
							//self.$container.data('width_r', width_r);
							//$('.response').css('width', width_r);
							
							// max height response
							var max_height_r = 0;
							$('.response').each(function(i) {
								var rheight = $(this).outerHeight();
								max_height_r = Math.max(max_height_r, rheight);
							});
							self.$container.data('height_r', max_height_r);
							$('.response').css('height', max_height_r);
							
							self.$container.find('.exercice_responses').addClass('init');
							
							// min height question_response
							//max response for a question
							var tab_nb_qr = [];
							for(var i= 0; i < self.tabQR.length; i++) {
								if(!(self.tabQR[i][0] in tab_nb_qr)) {
									tab_nb_qr[self.tabQR[i][0]] = 1;
								}
								else {
									tab_nb_qr[self.tabQR[i][0]] = parseInt(tab_nb_qr[self.tabQR[i][0]]) + 1;
								}
							}
							var max_r = 0;
							for(var j= 0; j < tab_nb_qr.length; j++) {
								max_r = Math.max(max_r, tab_nb_qr[j])
							} 						
							var min_height_qr = (parseInt(max_r)*(parseInt(max_height_r)*parseInt(nbQ)/3)) + (parseInt(max_r)*16) + 36;
							//var min_height_qr = (parseInt(max_r)*parseInt(max_height_r)) + (parseInt(max_r)*16) + 36;
							$('.question_response').css('min-height', min_height_qr);
							
							// height response header
							var max_height_qc = 0;
							$('.question_content').each(function(i) {
								var qcheight = $(this).outerHeight(true);
								max_height_qc = Math.max(max_height_qc, qcheight);
							});
							$('.question_content').css('height', max_height_qc);
						
						});	
					}
					// mobile
					else {
						//
					}
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
										
					var tabTmp = new Array();
          var tabR = new Array();
          var tabResponses = new Array();
          var nbR = null;
          /**
           * QUESTION/RESPONSE ARRAYS
           */
          var tmp_nbQ = this.nbQ;
          for (var q = 0; q<this.nbQ; q++) {
            tabR = this._split(this.options.json['items'][q]['response'], this.options.splitTag);
            if(this.options.json['items'][q]['question'] == '') {
              tmp_nbQ--;
            }
            nbR = tabR.length;
            for (r=0; r<nbR; r++) {
              tabResponses.push([q,tabR[r]]);
            }
          }
          this.nbQ = tmp_nbQ;
          this.nbR = tabResponses.length;
          /**
           * RANDOM ITEMS POSITION
           */
          for (var r = 0; r<this.nbR; r++) {
            tabTmp = Math.round(Math.random()*(tabResponses.length-1));
            this.tabQR.push(tabResponses[tabTmp]);
            tabResponses.splice(tabTmp,1);
          }
					
					// not mobile
					if(!is_mobile) {
						this.$container.addClass('no-mobile');
						
						// responses
						var $responses_container = $('<div></div>').appendTo(this.$container).addClass('exercice_responses');
						this.$responses = $('<div></div>')
							.addClass('exercice_responses_item')
							.appendTo($responses_container)
							.droppable({
								accept: '.response_dropped',
								hoverClass: 'hovered',
								drop: function(event, ui){
									var $draggable = $(ui.draggable);
									var $this = $(this);
									var rhtml = $draggable.find('.response_content').html();
									var rid = $draggable.data('id');
									var rq = $draggable.data('q');
									
									$('a.exercice_img').removeClass('show');
									self.$imgzoom.html('');
									if($this.hasClass('empty')) {
										$this.removeClass('empty');
										$this.html('');
									}

									var $drop_response = $('<div></div>')
										.appendTo(self.$responses)
										.addClass('response response_' + rid)
										.html('<div class="response_content">' + rhtml + '</div')
										.data({
											id:rid,
											q:rq
										})
										.draggable({
											containment: '.exercice_items',
											revert: 'invalid',
											zIndex : 10000,
											start : function(event, ui){
												$('a.exercice_img').removeClass('show');
												self.$imgzoom.html('');
											},
											stop : function(event, ui){
												$('a.exercice_img').removeClass('show');
												self.$imgzoom.html('');
											}	
										})
										.disableSelection();
										
									$drop_response.css('height', self.$container.data('height_r'));

									if($draggable.parent().find('.response_dropped').length == 1) {
										$draggable.parent().addClass('empty');
										$draggable.parent().html('<div class="dropbox-label"><span>' + dropbox_label + '</span></div>');
									}

									if($draggable.hasClass('ui-draggable')) {
										$draggable.draggable('destroy');
									}
									$draggable.remove();
									self._initImg($drop_response);
									self._initAsset($drop_response);
									
									if($('.exercice_responses_item .response').length <= 6) {
										$('.exercice_responses').addClass('less');
									}	
									else {
										$('.exercice_responses').removeClass('less');
									}								
								}
							});		
						for (var r = 0; r<this.nbR; r++) {
							var $response = $('<div></div>')
								.appendTo(this.$responses)
								.addClass('response response_'+r)
								.html('<div class="response_content">' + this.tabQR[r][1] + '</div')
								.data({
									id:r,
									q:this.tabQR[r][0]
								})
								.draggable({
									containment: '.exercice_items',
									revert: 'invalid',
									zIndex : 10000,
									start : function(event, ui){
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
									},
									stop : function(event, ui){
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
									}	
								})
								.disableSelection();
						}

						if(this.nbR > 6) {
							var $bottom_response_container = $('<div></div>')
								.addClass('exercice_responses_bottom')
								.appendTo($responses_container)
								.bind('click', function(e) {
									var $this = $(this);
									if($this.parent().hasClass('open')) {
										$this.parent().removeClass('open');
									}
									else {
										$this.parent().addClass('open');
									}
								})
						}
						
						// questions
						var $questions_container = $('<div></div>').appendTo(this.$container).addClass('exercice_questions');
						for (var q = 0; q<this.nbQ; q++) {
							$question = $('<div></div>')
								.appendTo($questions_container)
								.addClass('question question_'+q)
								.data('q', q)
								.html('<div class="question_content">' + this.options.json['items'][q]['question'] + '</div><div class="question_response empty">' + '<div class="dropbox-label"><span>' + dropbox_label + '</span></div></div>');
						}	
						$('.question_response').droppable({
							accept: '.response',
							hoverClass: 'hovered',
							over: function(event, ui){
								var $this = $(this);
								$this.parent().addClass('hovered');								
							},
							out: function(event, ui){
								var $this = $(this);
								$this.parent().removeClass('hovered');								
							},
							drop: function(event, ui){
								var $draggable = $(ui.draggable);
								var $this = $(this);
								var rhtml = $draggable.find('.response_content').html();
								var rid = $draggable.data('id');
								var rq = $draggable.data('q');
								$this.parent().removeClass('hovered');
								$('a.exercice_img').removeClass('show');
								self.$imgzoom.html('');
								$this.removeClass('empty');
								$this.find('.dropbox-label').remove();

								var $drop_r = $('<div></div>')
									.addClass('response_dropped response response_' + rid)
									.data({
										id:rid,
										q:rq
									})
									.html('<div class="response_content">' + rhtml + '</div')
									.appendTo($this)
									.draggable({
										containment: '.exercice_items',
										revert: 'invalid',
										zIndex : 10000,
										start : function(event, ui){
											$('a.exercice_img').removeClass('show');
											self.$imgzoom.html('');
										},
										stop : function(event, ui){
											$('a.exercice_img').removeClass('show');
											self.$imgzoom.html('');
										}	
									})
									.disableSelection();
								//$drop_r.css('height', self.$container.data('height_r'));
								
								// click remove dropped
								var remove_btn = $('<div></div>')
									.addClass('remove-dropped')
									.data('id', rid)
									.data('q', rq)
									.appendTo($drop_r)
									.unbind('click').bind('click', function(e) {
										if(e.target !== this) return false;
										var $this = $(this);
										self._revert_response($this.parent());
									});	

								if($draggable.parent().find('.response_dropped').length == 1) {
									$draggable.parent().addClass('empty');
									$draggable.parent().html('<div class="dropbox-label"><span>' + dropbox_label + '</span></div>');
								}
								
								if($draggable.hasClass('ui-draggable')) {
									$draggable.draggable('destroy');
								}								
								$draggable.remove();
								self._initImg($drop_r);
								self._initAsset($drop_r);
								
								if(!$('.exercice_responses_item .response').length) {
									$('.exercice_responses_item').addClass('empty');
									$('.exercice_responses_item').html(dragbox_empty_label);
								}
								else if($('.exercice_responses_item .response').length <= 6) {
									$('.exercice_responses').addClass('less');
								}	
								else {
									$('.exercice_responses').removeClass('less');
								}								
							}						
						});	
					}
					// mobile
					else {
						this.$container.addClass('mobile');
						
						var $qr_container = $('<div></div>').appendTo(this.$container).addClass('qr_container');
						for (var r = 0; r<this.nbR; r++) {
							var $qr = $('<div></div>')
								.appendTo($qr_container)
								.data('q',  this.tabQR[r][0])
								.addClass('qr qr_' + r);
							var $response = $('<div></div>')
								.appendTo($qr)
   						  .addClass('response response_' + r)	
								.html('<div class="response_content">' + this.tabQR[r][1] + '</div');
							var $questions = $('<ul></ul>')
							  .appendTo($qr)
								.addClass('questions');								
							for (var q = 0; q<this.nbQ; q++) {
								$question = $('<li></li>')
									.appendTo($questions)
									.addClass('question question_' + q)
									.data('q', q)
									.html('<div class="question_content">' + this.options.json['items'][q]['question'] + '</div>')
									.bind('click', function(e) {
										$target = $(e.target);
										if($target.hasClass('exercice_img')) {
											return false;
										}
										var $this = $(this);
										if($this.hasClass('selected')) {
											$this.removeClass('selected');
											$this.removeClass('bad');
										}
										else {
											$this.parent().find('.question').removeClass('selected');
											$this.parent().find('.question').removeClass('bad');
											$this.addClass('selected');
										}	
									});
							}							
						}					
					} 
					this._init_video_link($('.exercice_questions .question_content'));
        },
        _testResponse : function() {
					var self = this;
					
					// not mobile
					if(!is_mobile) {
						var nbOk = 0;
						var nb_fake = 0;
						for(var i= 0; i < self.tabQR.length; i++) {
							if(self.tabQR[i][0] > (parseInt(self.nbQ) - 1)) {
								nb_fake++;
							} 
						}
						
						var $qr = this.$container.find('.question_response').children();
						if($qr.length) {
							$qr.each(
								function(){
									var $this = $(this);
									if($this.hasClass('response_dropped')) {
										if($this.parent().parent().data('q') == $this.data('q')) {
											if(!$this.hasClass('good')) {
												$this.addClass('good');
												if($this.hasClass('ui-draggable')) {
													$this.draggable('disable');
												}	
												$this.find('.remove-dropped').remove();	
											}
											nbOk++;
										}
										else {
											$this.addClass('bad');
										}
									}
								}
							);
						}
						
						// lure not dropped
						// responses not dropped
						if($('.exercice_responses_item .response').length) {
							$('.exercice_responses_item .response').each(function(i) {
								var $this = $(this);
								var q = $this.data('q');
								// lure
								if(q >= self.nbQ) {
									if(!$this.hasClass('good')) {
										$this.addClass('good');
										if($this.hasClass('ui-draggable')) {
											$this.draggable('disable');
										}	
									}
									nbOk++;
								}
							});
						}
							
						//if (nbOk == this.nbR-nb_fake) {
						if (nbOk == this.nbR) {	
							this._showResult('ok', {nbOk:nbOk, nb:this.nbR});
						} else {
							this._showResult('ko', {nbOk:nbOk, nb:this.nbR, solution_type:'dotted'});
						}
					}
					// mobile
					else {
						this.$container.addClass('mobile');
						
						var nbOk = 0;
						var nb_fake = 0;
						for(var i= 0; i < self.tabQR.length; i++) {
							if(self.tabQR[i][0] > (parseInt(self.nbQ) - 1)) {
								nb_fake++;
							} 
						}
						
						$('.question.selected').each(
							function(){
								var $this = $(this);
								var q = $this.data('q');
								var qr = $this.parent().parent().data('q');
								if(q == qr) {
									$this.addClass('good');
									$this.parent().parent().addClass('good');
									$this.parent().parent().find('.question').unbind('click');
									nbOk++
								}
								else {
									$this.addClass('bad');
								}
							}
						);
						
						// lures, search if any question selected 
						$('.qr').each(function() {
						  var $this = $(this);
							var q = $this.data('q');
							if (q > (parseInt(self.nbQ) - 1)) {
								var has_selected = $this.find('.question.selected').length;
								if (!has_selected) {
									nbOk++;
								}
							}
						});
						
						//if (nbOk == this.nbR-nb_fake) {
						if (nbOk == this.nbR) {	
							this._showResult('ok', {nbOk:nbOk, nb:this.nbR});
						} else {
							this._showResult('ko', {nbOk:nbOk, nb:this.nbR, solution_type:'dotted'});
						}	
					}
        },
        _replay : function() {
					
					var self = this;
					// not mobile
					if(!is_mobile) {
						if(this.$container.hasClass('solution')) {
							this.$container.removeClass('solution');
							
							if($('.exercice_responses_item .response').length) {
								$('.exercice_responses_item .response').each(function(i) {
									var $this = $(this);
									if($this.hasClass('clone')) {
										$this.remove();
									}
									else {
										if($this.hasClass('ui-draggable')) {
											$this.draggable('enable');
										}
										$this.removeClass('solution');	
									}									
								});
							}		
							
							var $qr = this.$container.find('.question_response').children();
							if($qr.length) {
								$qr.each(
									function(){
										var $this = $(this);
										if($this.hasClass('response_dropped')) {
											if($this.hasClass('solution')) {
												if($this.hasClass('bad')) {
													$this.remove();
												}
												else {											
													var rhtml = $this.find('.response_content').html();
													var rid = $this.data('id');
													var rq = $this.data('q');
													if($('.exercice_responses_item').hasClass('empty')) {
														$('.exercice_responses_item').removeClass('empty');
														$('.exercice_responses_item').html('');
													}
													var $response = $('<div></div>')
														.appendTo(self.$responses)
														.addClass('response response_'+rid)
														.html('<div class="response_content">' + rhtml + '</div')
														.data({
															id:rid,
															q:rq
														})
														.draggable({
															containment: '.exercice_items',
															revert: 'invalid',
															zIndex : 10000,
															start : function(event, ui){
																$('a.exercice_img').removeClass('show');
																self.$imgzoom.html('');
															},
															stop : function(event, ui){
																$('a.exercice_img').removeClass('show');
																self.$imgzoom.html('');
															}
														})
														.disableSelection();
													//$response.css('width', self.$container.data('width_r'));	
													$response.css('height', self.$container.data('height_r'));
													self._initImg($response);
													self._initAsset($response);	
													if($this.parent().find('.response_dropped').length == 1) {
														$this.parent().addClass('empty');
														$this.parent().html('<div class="dropbox-label"><span>' + dropbox_label + '</span></div>');
													}
													$this.remove();	
												}
											}
											else if($this.hasClass('bad')) {
												if($this.hasClass('ui-draggable')) {	
													$this.draggable('enable');
												}	
												$this.find('.remove-dropped').bind('click', function(e) {
													if(e.target !== this) return false;
													var $rvthis = $(this);
													self._revert_response($rvthis.parent());
												});
											}
										}	
									}
								);
							}
							if(!$('.exercice_responses_item .response').length) {
								$('.exercice_responses_item').addClass('empty');
								$('.exercice_responses_item').html(dragbox_empty_label);
							}
							else if($('.exercice_responses_item .response').length <= 6) {
								$('.exercice_responses').addClass('less');
							}	
							else {
								$('.exercice_responses').removeClass('less');
							}
						}
					}
					// mobile
					else {
						if(this.$container.hasClass('solution')) {
							this.$container.removeClass('solution');
							
							$('.question.solution').removeClass('solution');
						
							$('.qr').each(function() {
								var $this = $(this);
								if(!$this.hasClass('good')) {
									$this.find('.question').bind('click', function(e) {
										$target = $(e.target);
										if(!($target.hasClass('question') || $target.hasClass('question_content'))) {
											return false;
										}
										var $this = $(this);
										if($this.hasClass('selected')) {
											$this.removeClass('selected');
											$this.removeClass('bad');
										}
										else {
											$this.parent().find('.question').removeClass('selected');
											$this.parent().find('.question').removeClass('bad');
											$this.addClass('selected');
										}	
									});
								}
							});
						}	
					}
        },
        _solution : function() {
          var self = this;
					
					// not mobile
					if(!is_mobile) {
						this.$container.addClass('solution');
						
						// responses not dropped
						if($('.exercice_responses_item .response').length) {
							$('.exercice_responses_item .response').each(function(i) {
								var $this = $(this);
								var rhtml = $this.html();
								var q = $this.data('q');
								var id = $this.data('id');
									// note lure
									if(q < self.nbQ) {
										$('.question_' + q + ' .question_response').removeClass('empty');
										$('.question_' + q + ' .question_response').find('.dropbox-label').remove();
										var $drop_r = $('<div></div>')
											.addClass('response_dropped solution')
											.html(rhtml)
											.data({
												id:id,
												q:q
											})
											.appendTo($('.question_' + q + ' .question_response'));
										//$drop_r.css('height', self.$container.data('height_r'));
										self._initImg($drop_r);
										self._initAsset($drop_r);	
										$this.remove();
									}
									// lure
									else {
										if($this.hasClass('ui-draggable')) {
											$this.draggable('disable');
											$this.addClass('solution');
										}	
									}									
							});	
						}
						
						// dropped responses
						var $qr = this.$container.find('.question_response').children();
						if($qr.length) {
							$qr.each(
								function(){
									var $this = $(this);
									if($this.hasClass('response_dropped')) {
										var qr_q = $this.data('q');
										var my_q = $this.parent().parent().data('q');
										// bad responses
										if(my_q != qr_q) {
											$('.question_' + qr_q + ' .question_response').removeClass('empty');
											$('.question_' + qr_q + ' .question_response').find('.dropbox-label').remove();
											if($this.hasClass('ui-draggable')) {											
												$this.draggable('disable');
											}
											$this.find('.remove-dropped').unbind('click');
											$this.addClass('bad');											
											var $rclone = $this.clone();
											$rclone.addClass('solution');	
											// not lure	
											if(qr_q < self.nbQ) {
												$rclone.appendTo($('.question_' + qr_q + ' .question_response'));
											}	
											// lure 
											else {
												$rclone.addClass('clone');
												$rclone.css('height', self.$container.data('height_r'));
												if($('.exercice_responses_item').hasClass('empty')) {
													$('.exercice_responses_item').removeClass('empty');
													$('.exercice_responses_item').html('');
												}
												$rclone.appendTo(self.$responses);
											}	
											$rclone.find('.remove-dropped').remove();	
											self._initImg($rclone);
											// audio
											$rclone.find('.jp-audio').each(function(){
												var $athis = $(this);
												$athis.unbind('click').bind('click', function() {
													var $pthis = $(this);
													var $id = $pthis.attr('id').substr(13);
													var $jp_player = $('.response_dropped.bad:not(.solution)').find('#jquery_jplayer_' + $id);
													var $jp_container = $('.response_dropped.bad:not(.solution)').find('#jp_container_' + $id);
													if($jp_player.length && $jp_container.length) {
														if($jp_container.hasClass('jp-state-playing')) {
															$jp_player.jPlayer('pause');
														}
														else {
															$jp_player.jPlayer('play');
														}
													}
												});
											});
										}
										// good responses
										else if(!$this.hasClass('good')) {
											$this.addClass('good');
											if($this.hasClass('ui-draggable')) {
												$this.draggable('disable');
											}
											$this.find('.remove-dropped').remove();
										}
									}	
								}
							);
						}
						if(!$('.exercice_responses_item .response').length) {
							$('.exercice_responses_item').addClass('empty');
							$('.exercice_responses_item').html(dragbox_empty_label);
						}
						else if($('.exercice_responses_item .response').length <= 6) {
							$('.exercice_responses').addClass('less');
						}	
						else {
							$('.exercice_responses').removeClass('less');
						}							
					}
					// mobile
					else {
						this.$container.addClass('solution');
						
						$('.qr').each(function() {
							var $this = $(this);
							var qr = $this.data('q');
							if(!$this.hasClass('good') && qr < self.nbQ) {
								$this.find('.question_' + qr).addClass('solution');
							}
						});
						$('.question').unbind('click');					
					}
        },
				_redo : function(){
					this.$responses = null;
          this.nbR = null;
          this.tabQR = [];
        },
				_revert_response : function($obj){
          var self = this;
					
					var rhtml = $obj.find('.response_content').html();
					var rid = $obj.data('id');
					var rq = $obj.data('q');
					if($('.exercice_responses_item').hasClass('empty')) {
						$('.exercice_responses_item').removeClass('empty');
						$('.exercice_responses_item').html('');
					}
					
					var $response = $('<div></div>')
						.appendTo(self.$responses)
						.addClass('response response_' + rid)
						.html('<div class="response_content">' + rhtml + '</div')
						.data({
							id:rid,
							q:rq
						})
						.draggable({
							containment: '.exercice_items',
							revert: 'invalid',
							zIndex : 10000,
							start : function(event, ui){
								$('a.exercice_img').removeClass('show');
								self.$imgzoom.html('');
							},
							stop : function(event, ui){
								$('a.exercice_img').removeClass('show');
								self.$imgzoom.html('');
							}
						})
						.disableSelection();
					//$response.css('width', self.$container.data('width_r'));	
					$response.css('height', self.$container.data('height_r'));
					self._initImg($response);
					self._initAsset($response);	
					if($obj.parent().find('.response_dropped').length == 1) {
						$obj.parent().addClass('empty');
						$obj.parent().html('<div class="dropbox-label"><span>' + dropbox_label + '</span></div>');
					}
					if($obj.hasClass('ui-draggable')) {
						$obj.draggable('destroy');
					}
					$obj.remove();

					if($('.exercice_responses_item .response').length <= 6) {
						$('.exercice_responses').addClass('less');
					}	
					else {
						$('.exercice_responses').removeClass('less');
					}						
				}	
      }
    );
    /**
     * GLISSER DEPOSER TEXTE
     */
    $.widget(
      'demo.exercice_gdt',
      $.demo.exercice,
      {
        options:{
          force_zoom_img:1,
          questionAttribute:'underline'
        },
        $qr : null,
        $dragr : null,
				tabR : [],
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
					
					var self = this;
					// response, average width and height
					var r_width = 0;
					var r_height = 0;
					var nb_r = $('.response').length;
					if(nb_r) {
						var w_total = 0;
						var h_total = 0;
						$('.response').each(function(i) {
							w_total += $(this).outerWidth();
							h_total += $(this).outerHeight();
						});
						r_width = Math.round(w_total/nb_r);
						r_height = Math.round(h_total/nb_r);
					}
					self.$container.data('width_r', r_width);
					$('.question_response').css('width', r_width); 
					self.$container.data('height_r', r_height);
					$('.question_response').css('height', r_height);
					
					/*//height response
					var r_height = 0;
					r_height = $('.response').outerHeight();
					self.$container.data('height_r', r_height);
					$('.question_response').css('height', r_height);*/			
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          var texte = this.options.json['items'][0]['question'];

          this.$dragr = $('<ul></ul>')
            .appendTo(this.$container)
            .addClass('response_list')
						.wrap('<div class="wrap-response-list"></div>');
					
					if (texte.startsWith('<div dir="ltr">')) {
						this.$dragr.attr('dir', 'ltr');
					}
					
					$('.wrap-response-list').droppable({
						accept: '.response',
						hoverClass: 'hovered',
						drop:function(event, ui){
							var $draggable = ui.draggable;
							var $this = $(this);
							var rid = $draggable.data('id');
							var from_id = $draggable.data('from_id');
							var rhtml = $draggable.find('.response_content').html();
							if(from_id != '') {
								$('.' + from_id).css('width', self.$container.data('width_r'));
								$('.' + from_id).css('height', self.$container.data('height_r'));
								$('.' + from_id).removeClass('dropped');
								$('.' + from_id).removeClass('bad');
								
								if($('.' + from_id).hasClass('ui-droppable')) {
									$('.' + from_id).droppable('enable');
								}
								
							}						
							if($draggable.hasClass('ui-draggable')) {
								$draggable.draggable('destroy');
							}
							$draggable.remove();
							
							
							var $dresponse = $('<li></li>')
								.appendTo(self.$dragr)
								.addClass('response response_' + rid)
								.data('id', rid)
								.data('from_id', '')
								.html('<div class="response_content">' + rhtml + '</div>')
								.draggable({
									containment: '.exercice_items',
									revert: 'invalid',
									zIndex : 10000,
									start:function(event, ui){
										var $this = $(this);
										$this.addClass('drag');	
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
									},
									stop:function(){
										var $this = $(this);
										$this.removeClass('drag');
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
									}
								})
								.disableSelection();
								
							if($('.response_list').hasClass('empty')) {
								$('.response_list').removeClass('empty');
								$('.dragbox-help').html(dragbox_help);
							}	
						}
					});
					var	$dragbox_help = $('<div></div>')
						.prependTo($('.wrap-response-list'))
					  .addClass('dragbox-help')
						.html(dragbox_help);
          var $questiontext = $('<div></div>')
            .appendTo(this.$container)
            .addClass('question question_text')
            .html(texte);
          var $responses = this._find($questiontext, this.options.questionAttribute);
          var $fakes = this._find($questiontext, 'line-through');
          if(!(typeof($fakes) != 'object' || !$fakes.length)) {
            $fakes
              .each(function(){
                var $this = $(this);
                var sub_fake = self._split($this.html(), self.options.splitTag);
                for(var i=0; i<sub_fake.length; i++) {
                  $responses.push($('<span></span>').html(sub_fake[i]));
                }
              })
            .replaceWith('');
          }
          if(typeof($responses) != 'object' || !$responses.length)
            return;

          var r=0;
          this.nbR = $responses.length;
          $responses
            .each(function(){
              var $this = $(this);
              self.tabR.push({id:r,html:$this.html()});
							$this.replaceWith('<div class="question_response question_response_' + r + '"></div>');
              r++;
            });
          this.$qr = $questiontext.find('.question_response');
          this.$qr.each(function(index){
            $(this).data('id', index).droppable({
							accept: '.response',
							hoverClass: 'hovered',
              drop:function(event, ui){
                var $draggable = ui.draggable;
                var $this = $(this);
                var rid = $draggable.data('id');
								var qid = $this.data('id');
								var from_id = $draggable.data('from_id');
								var rhtml = $draggable.find('.response_content').html();
								$this.addClass('dropped');
								$this.droppable('disable');
								//$this.css('width', $draggable.outerWidth());
								//$this.css('height', $draggable.outerHeight());
								
								if($draggable.hasClass('ui-draggable')) {
									$draggable.draggable('destroy');
								}
								$draggable.remove();
								
								if((from_id != '') && !$this.hasClass(from_id)) {
									$('.' + from_id).css('width', self.$container.data('width_r'));
									$('.' + from_id).css('height', self.$container.data('height_r'));
									$('.' + from_id).removeClass('dropped');
									$('.' + from_id).removeClass('bad');
									
									if($('.' + from_id).hasClass('ui-droppable')) {
										$('.' + from_id).droppable('enable');
									}	
								}
								
								var $dresponse = $('<div></div>')
									.appendTo($this)
									.addClass('response response_' + rid)
									.data('id', rid)
									.data('from_id', 'question_response_' + qid)
									.html('<div class="response_content">' + rhtml + '</div>')
									.draggable({
										containment: '.exercice_items',
										revert: 'invalid',
										zIndex : 10000,
										start:function(event, ui){
											var $this = $(this);
											$this.addClass('drag');
											/*if($this.parent().hasClass('ui-droppable')) {
												$this.parent().droppable('enable');
											}	*/
											$('a.exercice_img').removeClass('show');
											self.$imgzoom.html('');
										},
										stop:function(){
											var $this = $(this);
											$this.removeClass('drag');
											$('a.exercice_img').removeClass('show');
											self.$imgzoom.html('');
										}
									})
									.disableSelection();
								$this.disableSelection();
								
								// click remove dropped
								var remove_btn = $('<div></div>')
									.addClass('remove-dropped')
									.data('id', rid)
									.data('from_id', 'question_response_' + qid)
									.appendTo($dresponse)
									.unbind('click').bind('click', function(e) {
										if(e.target !== this) return false;
										var $this = $(this);
										var rhtml = $this.parent().find('.response_content').html();
										var rid = $this.data('id');
										var from_id = $this.data('from_id');

										var $qresponse = $('<li></li>')
											.appendTo(self.$dragr)
											.addClass('response response_' + rid)
											.data('id', rid)
											.data('from_id', '')
											.html('<div class="response_content">' + rhtml + '</div>')
											.draggable({
												containment: '.exercice_items',
												revert: 'invalid',
												zIndex : 10000,
												start:function(event, ui){
													var $this = $(this);
													$this.addClass('drag');	
													$('a.exercice_img').removeClass('show');
													self.$imgzoom.html('');
												},
												stop:function(){
													var $this = $(this);
													$this.removeClass('drag');
													$('a.exercice_img').removeClass('show');
													self.$imgzoom.html('');
												}
											})
											.disableSelection();
											
										if(from_id != '') {
											$('.' + from_id).css('width', self.$container.data('width_r'));
											$('.' + from_id).css('height', self.$container.data('height_r'));
											$('.' + from_id).removeClass('dropped');
											$('.' + from_id).removeClass('bad');
											if($('.' + from_id).hasClass('ui-droppable')) {
												$('.' + from_id).droppable('enable');
											}
										}						
										if($this.parent().hasClass('ui-draggable')) {
											$this.parent().draggable('destroy');
										}
										$this.parent().remove();
										
										if($('.response_list').hasClass('empty')) {
											$('.response_list').removeClass('empty');
											$('.dragbox-help').html(dragbox_help);
										}	
									});
								
								if(!$('.response_list .response').length) {
									$('.response_list').addClass('empty');
									$('.dragbox-help').html(dragbox_empty_label);
								}
              }
            });
          });
          for(r=this.nbR-1; r>=0; r--){
            var random = this.tabR.splice(Math.floor(Math.random()*r), 1);
            var $response = $('<li></li>')
              .appendTo(this.$dragr)
              .addClass('response response_' + (random[0]['id']))
              .attr('id', 'response_' + (random[0]['id']))
              .data('id', random[0]['id'])
							.data('from_id', '')
              .html('<div class="response_content">' + random[0]['html'] + '</div>')
              .draggable({
								containment: '.exercice_items',
								revert: 'invalid',
								zIndex : 10000,
                start:function(event, ui){
                  var $this = $(this);
                  $this.addClass('drag');
									$('a.exercice_img').removeClass('show');
									self.$imgzoom.html('');
                },
                stop:function(){
                  var $this = $(this);
                  $this.removeClass('drag');
									$('a.exercice_img').removeClass('show');
									self.$imgzoom.html('');
                }
              })
							.disableSelection();
          }
					this._init_video_link($questiontext);
        },
        _testResponse : function() {
          var nbOk = 0;
          var $responses = this.$container.find('.question_response.dropped');
          $responses.each(
            function(){
              var $this = $(this);
							var $qresponse = $this.find('.response');
							if($qresponse.length) {
								if($this.data('id') === $qresponse.data('id')) {
									$this.addClass('good');
									if($qresponse.hasClass('ui-draggable')) {
										$qresponse.draggable('disable');
									}	
									$qresponse.find('.remove-dropped').remove();
									nbOk++;
								}
								else {
									$this.addClass('bad');
								}	
							}						
            }
          );

					// lure
          var $rq = $('.response_list').children();
          var nbQ = $('.question_response').length;
          var nb_fake = 0;
          if($rq.length) {
            $rq.each(
              function() {
                var $this = $(this);
                if($this.data('id') >= nbQ) {
                  nb_fake++;
									$(this).addClass('good');
									if($(this).hasClass('ui-draggable')) {
										$(this).draggable('disable');
									}
									nbOk++;
                }
              }
            );
          }

          //if (nbOk == this.nbR-nb_fake) {
					if (nbOk == this.nbR) {	
            this._showResult('ok', {nbOk:nbOk, nb:this.nbR});
          } else {
            this._showResult('ko', {nbOk:nbOk, nb:this.nbR, solution_type:'dotted'});
          }
        },
        _replay : function() {
          var self = this;
					
					if(self.$container.hasClass('solution')) {
						self.$container.removeClass('solution');
						$('.solution.lure-dropped').remove();
						$('.response_solution').remove();
						$('.response_list .response').removeClass('hide solution');
						if($('.response_list .response').hasClass('ui-draggable')) {
							$('.response_list .response').draggable('enable');
						}
						if($('.response_list').hasClass('empty') && $('.response_list .response').length) {
							$('.response_list').removeClass('empty');
							$('.dragbox-help').html(dragbox_help);
						}	
						$('.question_response.bad .response.ui-draggable').draggable('enable');
						$('.question_response.solution.ui-droppable')
							.droppable('enable')
							.removeClass('solution')
							.html('');
							
						$('.question_response.bad .remove-dropped').unbind('click').bind('click', function(e) {
							if(e.target !== this) return false;
							var $this = $(this);
							var rhtml = $this.parent().find('.response_content').html();
							var rid = $this.data('id');
							var from_id = $this.data('from_id');

							var $qresponse = $('<li></li>')
								.appendTo(self.$dragr)
								.addClass('response response_' + rid)
								.data('id', rid)
								.data('from_id', '')
								.html('<div class="response_content">' + rhtml + '</div>')
								.draggable({
									containment: '.exercice_items',
									revert: 'invalid',
									zIndex : 10000,
									start:function(event, ui){
										var $this = $(this);
										$this.addClass('drag');	
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
									},
									stop:function(){
										var $this = $(this);
										$this.removeClass('drag');
										$('a.exercice_img').removeClass('show');
										self.$imgzoom.html('');
									}
								})
								.disableSelection();
								
							if(from_id != '') {
								$('.' + from_id).css('width', self.$container.data('width_r'));
								$('.' + from_id).css('height', self.$container.data('height_r'));
								$('.' + from_id).removeClass('dropped');
								$('.' + from_id).removeClass('bad');
								if($('.' + from_id).hasClass('ui-droppable')) {
									$('.' + from_id).droppable('enable');
								}
							}						
							if($this.parent().hasClass('ui-draggable')) {
								$this.parent().draggable('destroy');
							}
							$this.parent().remove();
							
							if($('.response_list').hasClass('empty')) {
								$('.response_list').removeClass('empty');
								$('.dragbox-help').html(dragbox_help);
							}	
						});	
					}		
        },
        _solution : function() {
          var self = this;
          self.$container.addClass('solution');
					var nbQ = $('.question_response').length;
         
          for(var r=0; r<this.nbR; r++){

						var $qr = this.$container.find('.question_response_' + r);
						if($qr.length) {
              var $dragr = this.$container.find('.response_list .response_' + r);
							// with response
							if($qr.hasClass('dropped')) {
								
								var $qresponse = $qr.find('.response');
								if($qresponse.length) {
									// good response
									if(($qresponse.data('id') === r)) {
										if(!$qr.hasClass('good')) {
											$qr.addClass('good');
											if($qresponse.hasClass('ui-draggable')) {
												$qresponse.draggable('disable');
											}	
											$qresponse.find('.remove-dropped').remove();
										}	
									}
									// bad response
									else {
										if(!$qr.hasClass('bad')) {
											$qr.addClass('bad');
										}
										if($qresponse.hasClass('ui-draggable')) {
											$qresponse.draggable('disable');
										}
										$qresponse.find('.remove-dropped').unbind('click');
										
										var shtml = $('.response_' + r).html();
										var $solution = $('<div></div')
											.addClass('response_solution')
											.html(shtml);
										$qr.after($solution);
										if($dragr.length) {
											$dragr.addClass('hide');
											if($dragr.hasClass('ui-draggable')) {
												$dragr.draggable('disable');
											}
										}
										// lure ?	
										if($qresponse.data('id') > nbQ) {
											var $response_lure = $('<li></li>')
												.appendTo(self.$dragr)
												.addClass('response solution lure-dropped response_' + $qresponse.data('id'))
												.html('<div class="response_content">' + $qresponse.find('.response_content').html() + '</div>');
												
										}
									}	
								}
							}
							// no response
							else {
								$qr.addClass('solution');
								$qr.html($('.response_' + r + ' .response_content').html());
								if($dragr.length) {
									$dragr.addClass('hide');
								}
								if($qr.hasClass('ui-droppable')) {
									$qr.droppable('disable');
								}	
							}
					  }
          }
					var is_drag_empty = true;
					$('.response_list .response').each(function(){
						var $this = $(this);
						if(!$this.hasClass('hide')) {
							is_drag_empty = false;
							return false;
						}
					});
					if(!$('.response_list').hasClass('empty') && is_drag_empty) {
						$('.response_list').addClass('empty');
						$('.dragbox-help').html(dragbox_empty_label);
					}
					// lure
					if($('.response_list .response:not(.hide)').length) {
						$('.response_list .response:not(.hide)').each(function() {
							$(this).addClass('solution');
							if($(this).hasClass('ui-draggable')) {
								$(this).draggable('disable');
							}
						});
					}
        },
				_redo : function(){
					this.tabR = [];
					this.$qr = null;
          this.$dragr = null;
        }
      }
    );
    /**
      * MOTS CROISES
      */
    $.widget(
      'demo.exercice_mc',
      $.demo.exercice,
      {
        options:{
          force_zoom_img:1,
          force_zoom_300:1
        },
        tabResult : [],
        tabTextResult:[],
        qIndex:0,
        $ul:null,
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
					
					// get max height questions_items
					this.$container.imagesLoaded( function() {
						
						// images have loaded
						var ul_max_height = 0;
						$('.exercice_items .questions_items ul li.question').each(function(i) {
							ul_max_height = Math.max(ul_max_height, $(this).height());
						});
						$('.exercice_items .questions_items ul.questions-list').css('height', ul_max_height);
						$('.exercice_items .questions_items ul li.question').hide();
						$('.exercice_items .questions_items ul li.question_0').show();
					});
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          this.tabTextResult = this._split(this.options.analysis_text, this.options.splitTag);
					
					// definitions container
					var $div = $('<div></div>')
            .appendTo(this.$container)
            .addClass('questions_items');
					$('<h2></h2>').appendTo($div).html('<span class="num">1</span> / '+ this.nbQ + ' - ' + this.options.definition_title);
          this.$ul = $('<ul></ul>').addClass('questions-list').appendTo($div);
					
					// grid
          var $grid = $('<div></div>')
            .addClass('grid')
            .appendTo(this.$container)
						.wrap('<div class="wrap-grid"><div class="wrap-content-grid"></div></div>')
            .css({
              position:'relative'
             });
					var $myResponseMc = $('<div></div>')
					  .addClass('myresponse-mc')
						.appendTo($grid);	
          var $input = $('<input type="text" maxlength="1"/>').appendTo($grid);
          var iwidth = $input.outerWidth(true);
          var iheight = $input.outerHeight(true);
					$grid
						.css({
              height:11*iheight,
              width:17*iwidth
             });
          $input.remove();
          
					// fill grid and definitions
					var tab_coord = [];
          for(var q=0; q<this.nbQ; q++){
            var item = this.options.json['items'][q];
            var direction = Number(item['response_direction']);
            var position = Number(item['response_position']);
            var tabText = item['response'].split('|');
            this.tabResult.push(tabText[0]);
            var tabWords = tabText[0].split('');
            var length = tabWords.length;
            var pos = position-1;
						var decal = (is_mobile?1:2);
            var top = (Math.floor(position/17))*(iheight-decal);
            var left = (position-(Math.floor(position/17)*17))*(iwidth-decal);
            $('<span></span>')
              .addClass('num num_'+(direction ? 'vert' : 'hor')+' num-'+q)
              .appendTo($grid)
              .text(q+1+'.')
              .data('qIndex', q)
              .css({
                position:'absolute',
                top:top,
                left:left
              })
              .bind('click', function(){
                $this = $(this);
                self.$ul.find('li.question_'+self.qIndex).hide();
                self.qIndex=$this.data('qIndex');
                self.$ul.find('li.question_'+self.qIndex).show();
                self.$container.find('h2 .num').text(self.qIndex+1);
                self._activate();
								return false;
              });	
            for(var l=0; l<length; l++){
							var input_exists = false;
							//tab_coord
							if($.inArray(top + '/' + left, tab_coord) == -1) {
								tab_coord.push(top + '/' + left);
							}
							else {
								input_exists = true;
							}
              $('<input type="text" maxlength="1"/>')
                .appendTo($grid)
                .addClass('input_'+l+' response_'+q+' response_'+(direction ? 'vert' : 'hor')+(input_exists?' sup':''))
                .css({
                  position:'absolute',
                  left:left,
                  top:top,
                  zindex:10
                })
                .data('response-'+q, l)
                .data('qIndex', q)
                .val(typeof(tabText[1]) != 'undefined' && tabText[1].substr(l,1) != '.' ? tabText[1].substr(l,1) : '')
                .focus(function(){
                  var $this = $(this);
                  if($this.data('disabled') === true){
                    $this.blur();return;
                  }
                  if(!$this.hasClass('response_'+self.qIndex)){
                    self.$ul.find('li.question_'+self.qIndex).hide();
                    self.qIndex = $this.data('qIndex');
                    self.$ul.find('li.question_'+self.qIndex).show();
                    self.$container.find('h2 .num').text(self.qIndex+1);
                    self._activate();
                    //self._activate();
                  }
                  $this
                    .removeClass('bad');
                })
                .keydown(function(e){
                  var $this = $(this);
                  var regexp = new RegExp(/\w/);
                  switch(e.keyCode){
										// backspace
                    case 8:
                      //self._prevInput($this);
                    break;
										// tab
                    case 9:
                      if(self.shiftKey){
                        self._prevInput($this);
                      }else{
                        self._nextInput($this);
                      }
                      return false;
                    break;
										// shift
                    case 16:
                      self.shiftKey = 1;
                    break;
                    default:
                      if(regexp.test(String.fromCharCode(e.keyCode)))
                        $this.val('');
                  }
                })
                .keyup(function(e){
                  var $this = $(this);
                  if(e.keyCode == 16)
                    self.shiftKey = 0;
                  var regexp = new RegExp(/\w/);
                  if(!regexp.test(String.fromCharCode(e.keyCode)))
                    return;
                  self._setInputVal($this, $this.val());
                  self._nextInput($this);
                });
              if(direction) {
                top += iheight-decal;
							}
              else {
                left += iwidth-decal;
							}
            }
            $('<li></li>').addClass('question question_'+q).appendTo(this.$ul).html(item['question']);//.hide();
          }
          if(this.nbQ > 1){
            $ul = $('<ul></ul>').appendTo($div).addClass('questions_nav');
            $('<li></li>').appendTo($ul).addClass('previous').text('<').click(function(){self._prev()});
            $('<li></li>').appendTo($ul).addClass('next').text('>').click(function(){self._next()});
          }
          this._activate();
          this._initKeyboard();
					$('.wrap-grid, .wrapper-exercice-keyboard').wrapAll('<div class="mc-grid-keyboard"></div>');
					
					// mobile
					//if(is_mobile) {
					if($(window).width() <= 1024) {	
						// add zoom button
						var $zoom = $('<button></button>')
							.insertAfter($('.wrap-grid'))
							.html(Drupal.t('zoom'))
							.wrap('<div class="zoom-mc"></div>')
							.bind('click', function() {
								var $this = $(this);
								var $zoom_grid = $('.wrap-grid');
								var $grid = $('.wrap-content-grid');

								if($zoom_grid.hasClass('zoom')) {
									$zoom_grid.removeClass('zoom');
									$grid.draggable().draggable('destroy');
									$grid.removeAttr('style');
								}
								else {
									$zoom_grid.addClass('zoom');
									var offset_box_left = $zoom_grid.offset().left;
									var offset_box_top = $zoom_grid.offset().top;
									var zoom_width = $grid[0].getBoundingClientRect().width;
									var zoom_height = $grid[0].getBoundingClientRect().height;
									var box_width = $zoom_grid.width();
									var box_height = $zoom_grid.height();
									var x1 = offset_box_left - (zoom_width - box_width);
									var y1 = offset_box_top - (zoom_height - box_height);
									var x2 = offset_box_left + 30;
									var y2 = offset_box_top + 30;

									$grid.draggable({
										containment: [x1, y1, x2, y2]
									});
								}	
							});
						$('.wrap-grid input').click(function(e){
							$(this).focus();
							return false;
						});		
					}	
					this._init_video_link($('.questions-list'));
        },
        _setInputVal: function(input, val) {
          var position = input.position();
          var top = position.top;
          var left = position.left;
          this.$container
            .find('input')
              .filter(function(){
                var tposition = $(this).position();
                if(tposition.left == left && tposition.top == top){
                  return true;
                }
              })
            .val(val);
        },
        _testResponse : function() {
          var tab = [];
          var nbOk = 0;
          var nbOk1 = 0;
          var nbOk2 = 0;
          var nbKo = 0;
          var $inputs = null;
          var $input = null;
          var nbI = 0;
          var testTxt;
          this.tabMyResponse = [];
          for (var q = 0; q<this.nbQ; q++) {
            $inputs = this.$container.find('.response_'+q);
            nbI = $inputs.length;
            testTxt = '';
            this.tabMyResponse[q] = [];
            for(var i=0; i<nbI; i++){
              $input = $($inputs[i]);
              testTxt += $input.val();
              this.tabMyResponse[q].push($input.val());
              if($input.val() != '' && $input.val() != this.tabResult[q].substr(i,1))
                $input.addClass('bad');
            }
            if (testTxt == this.tabResult[q]) {
              nbOk1++;
              nbOk++;
            } else if (this._unaccentedStr(testTxt.toLowerCase()) == this._unaccentedStr(this.tabResult[q].toLowerCase())){
              nbOk2++;
            }
          }
          if (nbOk == this.nbQ) {
						var params = {};
            params.analysis = '';
            if (nbOk1){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk1', nbOk1);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk1 > 1 ? 's' : '');
            }
            if (nbOk2) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbOk2', nbOk2);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk2 > 1 ? 's' : '');
            }
            nbKo = this.nbQ-nbOk1;
            if (nbKo>1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nbKo', nbKo);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo > 1 ? 's' : '');
            }
						this.$container.addClass('all-good');
            this._showResult('ok',params);
          } else {
            var params = {};
            params.analysis = '';
            if (nbOk1){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk1', nbOk1);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk1 > 1 ? 's' : '');
            }
            if (nbOk2) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbOk2', nbOk2);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk2 > 1 ? 's' : '');
            }
            nbKo = this.nbQ-nbOk1;
            if (nbKo>1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nbKo', nbKo);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo > 1 ? 's' : '');
            }
						params.solution_type = 'hover';
            this._showResult("ko",params);
          }
        },
        _solution: function() {
          var self = this;
          for (var q = 0; q<this.nbQ; q++) {
            this.$container
              .find('.response_'+q)
                .each(
                  function(index){
                    var $this = $(this);
                    var txt = self.tabResult[q].substr(index, 1);
                    if($this.val() != txt){
                      $this.addClass('solution');
                    }
                    $this
                      .val(txt)
                      .data('disabled', true)
                      .filter('.bad')
                        //.parent()
                          //.addClass('solution')
                          .bind({
                            mouseenter:function(){
                              var $this=$(this);
															var q = $this.data('qIndex');
                              var direction = self.$container.find('.num-'+q).hasClass('num_vert') ? 'vert' : 'hor';
                              var  myResponse = self.tabMyResponse[q].join('');
                              if(myResponse != '' && myResponse != self.tabResult[q]){
                                var myResponseTxt = '';
                                for(var prop in self.tabMyResponse[q]){
                                  myResponseTxt += (self.tabMyResponse[q][prop] == '' ? '<span>_</span>' : '<span' + (self.tabMyResponse[q][prop] == self.tabResult[q][prop]?' class="good"':'') + '>' + self.tabMyResponse[q][prop] + '</span>');
                                }
																self._showMyResponseMc(self.$container.find('.response_'+q+':eq(0)'), myResponseTxt, {align:'left_decal', valign:'bottom', orient:direction})
                              }
                            },
                            mouseleave:function(){
                              self._hideMyResponseMc();
                            }
                          });
                    }
                )
            }
        },
        _replay: function() {
          var self = this;
          for (var q=0; q<this.nbQ; q++) {
            var i = 0;
            this.$container
              .find('.response_'+q)
                .each(
                  function(){
                    $(this).val(self.tabMyResponse[q][i]).data('disabled', false).removeClass('solution');
                    i++;
                  }
                )
								.removeClass('solution')
								.unbind('mouseleave')
								.unbind('mouseenter');
          }
        },
        _activate: function(){
          var self = this;
          this
            .$container
            .find('.activ')
              .removeClass('activ')
              .css('z-index', 10)
              .end()
            .find('.response_'+this.qIndex)
              .removeClass('bad')
              .addClass('activ')
              .css('z-index', 100)
              .first()
                .focus();
        },
        _nextInput: function($this){
          var self = this;
          var l = Number($this.data('response-'+this.qIndex));
          var $next = this.$container.find('.response_'+this.qIndex).filter(function(){return $(this).data('response-'+self.qIndex) == l+1});
          if($next.length)
            $next.focus();
          else
            this._next();
        },
        _prevInput: function($this){
          var self = this;
          var l = Number($this.data('response-'+this.qIndex));
          var $prev = this.$container.find('.response_'+this.qIndex).filter(function(){return $(this).data('response-'+self.qIndex) == l-1});
          if($prev.length)
            $prev.focus();
          else
            this._prev();
        },
        _next: function(){
          this.$ul.find('li.question_'+this.qIndex).hide();
          if(this.qIndex < this.nbQ-1){
            this.qIndex++;
          }else{
            this.qIndex=0;
          }
          this.$ul.find('li.question_'+this.qIndex).show();
          this.$container.find('h2 .num').text(this.qIndex+1);
          this._activate();
        },
        _prev: function(){
          this.$ul.find('li.question_'+this.qIndex).hide();
          if(this.qIndex > 0){
            this.qIndex--;
          }else{
            this.qIndex=this.nbQ-1;
          }
          this.$ul.find('li.question_'+this.qIndex).show();
          this.$container.find('h2 .num').text(this.qIndex+1);
          this._activate();
        },
				_showMyResponseMc:function($obj, myResponse, params){
          if(!$obj.length || myResponse == null || myResponse == '')
            return false;
          var params = $.extend({
            valign:'top'
          },params);
          var pos = $obj.position();
          var left = pos.left
          var top = pos.top;
					var decal = (is_mobile?1:2);
					
					
					if($('.wrap-grid').length && $('.wrap-grid').hasClass('zoom')) {
						left = Math.round(left/1.8);
						top = Math.round(top/1.8);
						//o_pos_left = Math.round(o_pos_left/1.8);
					}
					
          $('.myresponse-mc').html('');
					$('.myresponse-mc').removeClass('hor vert');
					$('.myresponse-mc').addClass(params.orient);
          $('<div></div>').appendTo($('.myresponse-mc')).addClass('exercice_myresponse_content').html(myResponse);
					if(params.orient == 'vert') {
						var after_top = Math.round((($('.myresponse-mc span').height() + decal) * $('.myresponse-mc span').length)/2);
						document.documentElement.style.setProperty('--response-mc-after-top', after_top + 'px');
					}
					
          switch(params.valign){
            case 'top':
              top -= $('.myresponse-mc').outerHeight();
              $('.myresponse-mc').addClass('top');
              break;
            case 'bottom':
              $('.myresponse-mc').addClass('bottom');
							
							if(params.orient == 'vert') {
								top -= $obj.outerHeight();
							}
							else {
								top += $obj.outerHeight() + 8;
							}
              break;
          }
          if(typeof(params.top) != 'undefined')
            top += params.top;
          switch(params.align){
            case 'center':
              left = left - $('.myresponse-mc').outerWidth()/2 + $obj.outerWidth()/2;
              $('.myresponse-mc').addClass('center');
              break;
						case 'left_decal':
              left = left + $obj.outerWidth();
              $('.myresponse-mc').addClass('left-decal');
							if(params.orient == 'vert') {
								left = left + 8;
							}
							
              break;	
            case 'right':
              left = left - $('.myresponse-mc').outerWidth() + $obj.outerWidth();
              $('.myresponse-mc').addClass('right');
              break;
						case 'middle_left':
							left = left - $obj.outerWidth()/2;
							$('.myresponse-mc').addClass('middle-left');
							break;
						case 'middle_right_20':
							left = left - $('.myresponse-mc').outerWidth()/2 + $obj.outerWidth()/2 + 20;
							$('.myresponse-mc').addClass('middle-right-20');
							break;	
          }
          $('.myresponse-mc')
            .css('position', 'absolute')
            .css('z-index', 1000)
            .css('top', top)
            .css('left', left)
            .show();
        },
        _hideMyResponseMc:function(){
          $('.myresponse-mc').hide();
        },
				_redo : function(){
					this.tabResult = [];
					this.tabTextResult = [];
					this.qIndex = 0;
					this.$ul = null;
        }
      }
    );
    /**
      * MOTS MELES
      */
    $.widget(
      'demo.exercice_mm',
      $.demo.exercice,
      {
        options:{
          force_zoom_img:1,
          force_zoom_300:1
        },
        $ul:null,
        selectedIndex:null,
        qIndex:0,
        nbRows: 0,
        nbCols: 0,
				tabgoods:[],
        $table: null,
        tabResponses: [],
        tabResult:[],
        status:'play',
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
					
					// get max height questions_items
					this.$container.imagesLoaded( function() {
						
						// images have loaded
						var ul_max_height = 0;
						$('.exercice_items .questions_items ul li.question').each(function(i) {
							ul_max_height = Math.max(ul_max_height, $(this).height());
						});
						$('.exercice_items .questions_items ul.questions-list').css('height', ul_max_height);
						$('.exercice_items .questions_items ul li.question').hide();
						$('.exercice_items .questions_items ul li.question_0').show();
					});
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
					
          var tabRows = this._split(this.options.json['items'][0]['question'], this.options.splitTag);
					for(var tr in tabRows) {
						tabRows[tr] = tabRows[tr].trim();
					}
					
					// grid
          this.$table = $('<table></table>').appendTo(this.$container).wrap('<div class="wrap-grid-mm"><div class="grid-mm"></div></div>');
          this.nbRows = tabRows.length;
          this.nbQ = this.nbQ - 1;
          for(var r=0; r<this.nbRows; r++){
            var $tr = $('<tr></tr>').appendTo(this.$table);
            var length = tabRows[r].length;
            var tabCols = tabRows[r].split('');
            this.nbCols = tabCols.length;
            for(var c=0; c<this.nbCols; c++){
              $('<td></td>')
                .appendTo($tr)
                .html('<div>'+tabCols[c]+'</div>')
                .bind('click', function(){self._activate($(this).data('index'));})
                .data({
                  index:c+(r*this.nbCols)
                });
            }
          }
					
					// definitions
          var $div = $('<div></div>').appendTo(this.$container).addClass('questions_items');
					$('<h2></h2>').appendTo($div).html('<span class="num">1</span> / '+ this.nbQ + ' - ' + this.options.definition_title);
          this.$ul = $('<ul></ul>').addClass('questions-list').appendTo($div);
          for(var q=0; q<this.nbQ; q++){
            var item = this.options.json['items'][(q+1)];
            $('<li></li>').addClass('question question_'+q).appendTo(this.$ul).html(item['question']);
            var length = item['response'].length;
            var position = Number(item['response_position']);
            position = position - ((17-this.nbCols) * Math.floor(position/17)) - 1;
            var direction = Number(item['response_direction']);
            this.tabResult[q] = [];
            switch(direction){
              case 0:
                for(var i=0; i<length; i++)
                  this.tabResult[q].push(position+i);
              break;
              case 1:
                for(var i=0; i<length; i++)
                  this.tabResult[q].push(position+(i*this.nbCols));
              break;
              case 2:
                for(var i=0; i<length; i++)
                  this.tabResult[q].push(position-i);
              break;
              case 3:
                for(var i=0; i<length; i++)
                  this.tabResult[q].push(position-(i*this.nbCols));
              break;
              case 4:
                for(var i=0; i<length; i++)
                  this.tabResult[q].push(position-(i*(this.nbCols-1)));
              break;
              case 5:
                for(var i=0; i<length; i++)
                  this.tabResult[q].push(position+(i*(this.nbCols+1)));
              break;
              case 6:
                for(var i=0; i<length; i++)
                  this.tabResult[q].push(position-(i*(this.nbCols+1)));
              break;
              case 7:
                for(var i=0; i<length; i++)
                  this.tabResult[q].push(position+(i*(this.nbCols-1)));
              break;
            }
          }
					for(var r in this.tabResult){
						this.tabResult[r].sort(function(a, b){return a-b});
					}	
					// definitions nav
          if(this.nbQ > 1){
            var $ul = $('<ul></ul>').appendTo($div).addClass('questions_nav');
            $('<li></li>').appendTo($ul).addClass('previous').text('<').click(function(){self._prev()});
            $('<li></li>').appendTo($ul).addClass('next').text('>').click(function(){self._next()});
          }
					
					// mobile
					if(is_mobile) {
						// add zoom button
						var $zoom = $('<button></button>')
							.insertAfter($('.wrap-grid-mm'))
							.html(Drupal.t('zoom'))
							.wrap('<div class="zoom-mm"></div>')
							.bind('click', function() {
								var $this = $(this);
								var $zoom_grid = $('.wrap-grid-mm');
								var $grid = $('.grid-mm');

								if($zoom_grid.hasClass('zoom')) {
									$zoom_grid.removeClass('zoom');
									$grid.draggable().draggable('destroy');
									$grid.removeAttr('style');
								}
								else {
									$zoom_grid.addClass('zoom');
									var offset_box_left = $zoom_grid.offset().left;
									var offset_box_top = $zoom_grid.offset().top;
									var zoom_width = $grid[0].getBoundingClientRect().width;
									var zoom_height = $grid[0].getBoundingClientRect().height;
									var box_width = $zoom_grid.width();
									var box_height = $zoom_grid.height();
									var x1 = offset_box_left - (zoom_width - box_width);
									var y1 = offset_box_top - (zoom_height - box_height);
									var x2 = offset_box_left + 30;
									var y2 = offset_box_top + 30;

									$grid.draggable({
										containment: [x1, y1, x2, y2]
									});
								}	
							});;		
					}	
					this._init_video_link($('.questions-list'));
					
        },
        _testResponse : function() {
          var nbOk = 0;			
          for(var r in this.tabResponses){
						// good
            if(this.tabResult[r].toString() == this.tabResponses[r].toString()){
							this.tabgoods.push(parseInt(r));
							$('.bg-selected.q-' + r).remove();
							// prepare bg layer
							var $selected = $('<div></div>').addClass('bg-selected good q-' + r);
							var orient = '';
							for(var index in this.tabResponses[r]){
								var $span = $('<span>&nbsp;</span>');
								if((index == 1) && (this.tabResponses[r].length > 2)) {
									$span.addClass('after-first');
								}
								if((index == (this.tabResponses[r].length - 2))  && (this.tabResponses[r].length > 2)) {
									$span.addClass('before-last');
								}
								$span.appendTo($selected);
								// get orientation
								if(index == (this.tabResponses[r].length - 1)) {
									if(this.tabResponses[r][index] - 1 == this.tabResponses[r][index-1]) {
										orient = 'hor';
									}
									else if (this.tabResponses[r][index] - this.nbCols == this.tabResponses[r][index-1]) {
										orient = 'vert';
									}
									else if (this.tabResponses[r][index] - (this.nbCols + 1) == this.tabResponses[r][index-1]) {
										orient = 'dl-right';
									}
									else if (this.tabResponses[r][index] - (this.nbCols - 1) == this.tabResponses[r][index-1]) {
										orient = 'dl-left';
									}
								}
							}
							// calcul position bg layer
							var $first_selected = this.$table.find('td:eq(' + this.tabResponses[r][0] + ')');
							if(typeof($first_selected) != 'undefined') {
								var select_offset = $first_selected.offset();
								var grid_offset = $('.grid-mm').offset();	
								$selected.appendTo($('.grid-mm'));
								if(orient != '') {
									$selected.addClass(orient);
								}
								if($('.wrap-grid-mm').length && $('.wrap-grid-mm').hasClass('zoom')) {
									$selected.css('top', Math.round(select_offset.top/1.8 - grid_offset.top/1.8));
									$selected.css('left', Math.round(select_offset.left/1.8 - grid_offset.left/1.8));	
								}
								else {
									$selected.css('top', Math.round(select_offset.top - grid_offset.top));
									$selected.css('left', Math.round(select_offset.left - grid_offset.left));	
								}	
							}
              nbOk++;
            }
						// bad
						else if(this.tabResponses[r].toString() != '') {
							$('.bg-selected.q-' + r).remove();
							// prepare bg layer
							var $selected = $('<div></div>').addClass('bg-selected bad q-' + r);
							var orient = '';
							for(var index in this.tabResponses[r]){
								var $span = $('<span>&nbsp;</span>');
								if((index == 1) && (this.tabResponses[r].length > 2)) {
									$span.addClass('after-first');
								}
								if((index == (this.tabResponses[r].length - 2)) && (this.tabResponses[r].length > 2)) {
									$span.addClass('before-last');
								}
								$span.appendTo($selected);
								// get orientation
								if(index == (this.tabResponses[r].length - 1)) {
									if(this.tabResponses[r][index] - 1 == this.tabResponses[r][index-1]) {
										orient = 'hor';
									}
									else if (this.tabResponses[r][index] - this.nbCols == this.tabResponses[r][index-1]) {
										orient = 'vert';
									}
									else if (this.tabResponses[r][index] - (this.nbCols + 1) == this.tabResponses[r][index-1]) {
										orient = 'dl-right';
									}
									else if (this.tabResponses[r][index] - (this.nbCols - 1) == this.tabResponses[r][index-1]) {
										orient = 'dl-left';
									}
								}
							}
							// calcul position bg layer
							var $first_selected = this.$table.find('td:eq(' + this.tabResponses[r][0] + ')');
							if(typeof($first_selected) != 'undefined') {
								var select_offset = $first_selected.offset();
								var grid_offset = $('.grid-mm').offset();	
								$selected.appendTo($('.grid-mm'));
								if(orient != '') {
									$selected.addClass(orient);
								}
								if($('.wrap-grid-mm').length && $('.wrap-grid-mm').hasClass('zoom')) {
									$selected.css('top', Math.round(select_offset.top/1.8 - grid_offset.top/1.8));
									$selected.css('left', Math.round(select_offset.left/1.8 - grid_offset.left/1.8));	
								}
								else {
									$selected.css('top', Math.round(select_offset.top - grid_offset.top));
									$selected.css('left', Math.round(select_offset.left - grid_offset.left));
								}		
							}
						}
          }
          if(nbOk == this.nbQ){
            this._showResult('ok', {nbOk:nbOk,nb:this.nbQ});
          } else {
            this._showResult('ko', {nbOk:nbOk,nb:this.nbQ,solution_type:'hover'});
          }
					this._setSelection();
        },
        _solution: function() {
          this.status = 'solution';
          this.$table.find('td').unbind('click');
					$('.bg-selected').removeClass('activ');
					$('.bg-selected.bad').hide();
					
          for(var q=0; q<this.nbQ; q++){
						if(!$('.bg-selected.good.q-' + q).length) {
							var length = this.tabResult[q].length;
							// prepare bg layer
							var $selected = $('<div></div>').addClass('bg-selected solution q-' + q);
							var orient = '';
							for(var i=0; i<length; i++){
								var $span = $('<span>&nbsp;</span>');
								if((i == 1) && (this.tabResult[q].length > 2)) {
									$span.addClass('after-first');
								}
								if((i == (this.tabResult[q].length - 2)) && (this.tabResult[q].length > 2)) {
									$span.addClass('before-last');
								}
								$span.appendTo($selected);
								// get orientation
								if(i == (this.tabResult[q].length - 1)) {
									if(this.tabResult[q][i] - 1 == this.tabResult[q][i-1]) {
										orient = 'hor';
									}
									else if (this.tabResult[q][i] - this.nbCols == this.tabResult[q][i-1]) {
										orient = 'vert';
									}
									else if (this.tabResult[q][i] - (this.nbCols + 1) == this.tabResult[q][i-1]) {
										orient = 'dl-right';
									}
									else if (this.tabResult[q][i] - (this.nbCols - 1) == this.tabResult[q][i-1]) {
										orient = 'dl-left';
									}
								}	
							}
							// calcul position bg layer
							var $first_selected = this.$table.find('td:eq(' + this.tabResult[q][0] + ')');
							if(typeof($first_selected) != 'undefined') {
								var select_offset = $first_selected.offset();
								var grid_offset = $('.grid-mm').offset();	
								$selected.appendTo($('.grid-mm'));
								if(orient != '') {
									$selected.addClass(orient);
								}
								if($('.wrap-grid-mm').length && $('.wrap-grid-mm').hasClass('zoom')) {
									$selected.css('top', Math.round(select_offset.top/1.8 - grid_offset.top/1.8));
									$selected.css('left', Math.round(select_offset.left/1.8 - grid_offset.left/1.8));	
								}
								else {
									$selected.css('top', Math.round(select_offset.top - grid_offset.top));
									$selected.css('left', Math.round(select_offset.left - grid_offset.left));	
								}	
							}
						}		
          }
          this._setSelection();
        },
        _replay: function() {
          var self = this;
					if(this.status == 'solution') {
						this.status = 'play';
						this.$table.find('td').bind('click', function(){self._activate($(this).data('index'));});
						$('.bg-selected.solution').remove();
						$('.bg-selected.bad').show();
						this.$table.find('td div').unbind('mouseenter');
						this.$table.find('td div').unbind('mouseleave');
						this._setSelection();
					} 
        },
        _activate: function(index){
					// no action if question is correct
					if($.inArray(this.qIndex, this.tabgoods) != -1) {
						return;
					}
					
          this.$table.find('td.q_activ_first').removeClass('q_activ_first');
					// first letter already selected
          if(this.selectedIndex != null){
            this.tabResponses[this.qIndex] = this._selectionToTable(index, this.selectedIndex);
						this.tabResponses[this.qIndex].sort(function(a, b){return a-b});
						// prepare bg layer
						var $selected = $('<div></div>').addClass('bg-selected activ q-' + this.qIndex);
						var orient = '';
            for(var index in this.tabResponses[this.qIndex]) {
							var $span = $('<span>&nbsp;</span>');
							if((index == 1) && (this.tabResponses[this.qIndex].length > 2)) {
								$span.addClass('after-first');
							}
							if((index == (this.tabResponses[this.qIndex].length - 2)) && (this.tabResponses[this.qIndex].length > 2)) {
								$span.addClass('before-last');
							}
							$span.appendTo($selected);
							// get orientation
							if(index == (this.tabResponses[this.qIndex].length - 1)) {
								if(this.tabResponses[this.qIndex][index] - 1 == this.tabResponses[this.qIndex][index-1]) {
									orient = 'hor';
								}
								else if (this.tabResponses[this.qIndex][index] - this.nbCols == this.tabResponses[this.qIndex][index-1]) {
									orient = 'vert';
								}
								else if (this.tabResponses[this.qIndex][index] - (this.nbCols + 1) == this.tabResponses[this.qIndex][index-1]) {
									orient = 'dl-right';
								}
								else if (this.tabResponses[this.qIndex][index] - (this.nbCols - 1) == this.tabResponses[this.qIndex][index-1]) {
									orient = 'dl-left';
								}
							}	
						}
						// calcul position bg layer
						var $first_selected = this.$table.find('td:eq(' + this.tabResponses[this.qIndex][0] + ')');
						if((typeof($first_selected) != 'undefined') && $first_selected.length) {
							var select_offset = $first_selected.offset();
							var grid_offset = $('.grid-mm').offset();	
							$selected.appendTo($('.grid-mm'));
							if(orient != '') {
								$selected.addClass(orient);
							}
							if($('.wrap-grid-mm').length && $('.wrap-grid-mm').hasClass('zoom')) {
								$selected.css('top', Math.round(select_offset.top/1.8 - grid_offset.top/1.8));
								$selected.css('left', Math.round(select_offset.left/1.8 - grid_offset.left/1.8));	
							}
							else {
								$selected.css('top', Math.round(select_offset.top - grid_offset.top));
								$selected.css('left', Math.round(select_offset.left - grid_offset.left));	
							}
							
						}
            this.selectedIndex = null;
          }
					// nothing selected
					else {
						$('.bg-selected.q-' + this.qIndex).remove();
            this.tabResponses[this.qIndex] = [];
            this.$table.find('td:eq('+index+')').addClass('q_activ_first');
            this.selectedIndex = index;
          }
        },
        _selectionToTable: function(index1, index2){
          if(index1 == index2)
            return [];
          var tab = [];
          var i1 = index1<index2 ? index1 : index2;
          var i2 = index1>index2 ? index1 : index2;
          if(parseInt(i2/this.nbCols) === parseInt(i1/this.nbCols)){
            for(var i=i1; i<=i2; i++)
              tab.push(i);
          } else if((i2-i1)%this.nbCols === 0){
            for(var i=i1; i<=i2; i+=this.nbCols)
              tab.push(i);
          } else {
            var col1 = (i1-(parseInt((i1/this.nbCols))*this.nbCols));
            var col2 = (i2-(parseInt((i2/this.nbCols))*this.nbCols));
            var row1 = parseInt(i1/this.nbCols);
            var row2 = parseInt(i2/this.nbCols);
            if(col1+(row2-row1) == col2)
              for(var i=i1; i<=i2; i+=this.nbCols + 1)
                tab.push(i);
            else if(col1-(row2-row1) == col2)
              for(var i=i1; i<=i2; i+=this.nbCols - 1)
                tab.push(i);
          }
          return tab;
        },
        _setSelection: function(){
          var self = this;
          this.$container.find('.num').text(this.qIndex+1);
          switch(this.status){
            case 'solution' :
							$('.bg-selected.solution').removeClass('activ');
							$('.bg-selected.good').removeClass('activ');
							
							if($.inArray(this.qIndex, this.tabgoods) != -1) {
								$('.bg-selected.good.q-' + this.qIndex).addClass('activ');
							}
							else {
								$('.bg-selected.solution.q-' + this.qIndex).addClass('activ');
							}
							
              for(var index in this.tabResult[this.qIndex]){
                this.$table
                  .find('td:eq('+this.tabResult[this.qIndex][index]+')')
                  .find('div')
                    .bind({
                      mouseenter:function(){
                        if(typeof(self.tabResponses[self.qIndex]) != 'undefined') {
													if($.inArray($(this).parent().data('index'), self.tabResult[self.qIndex]) != -1) {
														$('.bg-selected.bad.q-' + self.qIndex).addClass('show').show();
													}			
												}
                      },
                      mouseleave:function(){
                        if(typeof(self.tabResponses[self.qIndex]) != 'undefined') {
													if($.inArray($(this).parent().data('index'), self.tabResult[self.qIndex]) != -1) {
														$('.bg-selected.bad.q-' + self.qIndex).removeClass('show').hide();
													}	
												}		
                      }
                    });
              }
            break;
            default:
							$('.bg-selected').removeClass('activ');
							$('.bg-selected.q-' + this.qIndex).addClass('activ');
            break;
          }
        },
        _next: function(){
					this.$table.find('td.q_activ_first').removeClass('q_activ_first');
					this.selectedIndex = null;
          this.$ul.find('li.question_'+this.qIndex).hide();
          if(this.qIndex < this.nbQ - 1){
            this.qIndex ++;
          } else {
            this.qIndex = 0;
          }
          this.$ul.find('li.question_'+this.qIndex).show();
          this._setSelection();
        },
        _prev: function(){
					this.$table.find('td.q_activ_first').removeClass('q_activ_first');
					this.selectedIndex = null;
          this.$ul.find('li.question_'+this.qIndex).hide();
          if(this.qIndex > 0){
            this.qIndex--;
          }else{
            this.qIndex=this.nbQ-1;
          }
          this.$ul.find('li.question_'+this.qIndex).show();
          this._setSelection();
        },
				_redo : function(){
					this.$ul = null;
					this.selectedIndex = null;
					this.qIndex = 0;
					this.nbRows = 0;
					this.nbCols = 0;
					this.$table = null;
					this.tabResponses = [];
					this.tabResult = [];
					this.tabgoods = [];
					this.status = 'play';
        }
      }
    );
    /**
      * QCM
      */
    $.widget(
      'demo.exercice_qcm',
      $.demo.exercice,
      {
        options:{
          responseAttribute:'underline',
          force_zoom_img:1,
          force_zoom_300:1
        },
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          var $questions = $('<ul></ul>').appendTo(this.$container);
          var width = 0;
          var responses_widths = new Array();
          for(var q=0; q<this.nbQ; q++){
            var $question = $('<li></li>').appendTo($questions).addClass('question qcm_question').html('<h2><span class="num">'+(q+1)+'.</span> '+this.options.json['items'][q]['question']+'</h2>');
            var $responses = $('<ul></ul>').appendTo($question);
            var tabResponses = this._split(this.options.json['items'][q]['response'], this.options.splitTag);
            var nbR = tabResponses.length;
            for(var r = nbR; r>0; r--){
              var tabR = tabResponses.splice(Math.floor(Math.random()*r), 1);
              var $response = $('<li></li>')
                .appendTo($responses)
                .addClass('response qcm_response')
                .html(tabR[0])
                .data('index', r)
                .bind({
                  click:function(){self._click($(this));},
                  mouseenter:function(){$(this).addClass('hover');},
                  mouseleave:function(){$(this).removeClass('hover');}
                });
            }
            var $toselect = this._find($responses, this.options.responseAttribute);
            $question.addClass($toselect.length > 1 ? 'multiple' : '');
            $toselect.each(function(){
              $this = $(this);
              $parent = $this.parent();
              if ($parent.hasClass('qcm_response')) {
								$parent.addClass('toselect');
							}
							// response is wrapped with another tag, get older parent
							else {
								$parent_parent = $parent.parent();
								$parent_parent.addClass('toselect');
							}
            });
            width += $question.outerWidth(true);
            responses_widths[q] = $question.outerWidth(true);
          }
					this._init_video_link($('.qcm_question h2'));
        },
        _testResponse : function(){
          var nbOk = 0;
          this.$container.find('.qcm_question').each(
            function(){
              $this = $(this)
							$this.find('.toselect').filter('.selected').addClass('good');
              if($this.hasClass('multiple')){
                var nbR = $this.find('.toselect').length;
                var nbS = $this.find('.selected').length;
                var nbRS = $this.find('.toselect').filter('.selected').length;							
                if(nbRS == nbR && nbRS == nbS) {
                  nbOk++;
								}	
              } else {
                if($this.find('.toselect').filter('.selected').length) {
									nbOk++;
								}	
              }
            }
          );
          if(nbOk == this.nbQ)
            this._showResult('ok', {nbOk:nbOk,nb:this.nbQ});
          else
            this._showResult('ko', {nbOk:nbOk,nb:this.nbQ, solution_type:'dotted'});
        },
        _solution : function(){
          this.$container
            .find('.qcm_response')
              .unbind('click')
              .unbind('mouseenter')
              .unbind('mouseleave')
							.filter(function(){
                  var $this = $(this);
                  if($this.hasClass('toselect') && !$this.hasClass('good'))
                    return true;
              })
                .addClass('solution');

        },
        _replay : function(){
          var self = this;
          this.$container
            .find('.qcm_response')
              .removeClass('solution')
              .unbind('click')
              .unbind('mouseenter')
              .unbind('mouseleave')
              .bind({
                click:function(){self._click($(this));},
                mouseenter:function(){$(this).addClass('hover');},
                mouseleave:function(){$(this).removeClass('hover');}
              })
              .filter(function(){
                  var $this = $(this);
                  if(!$this.hasClass('toselect') && $this.hasClass('selected'))
                    return true;
              })
                .addClass('bad');
        },
				_redo : function(){
        },
        _click : function($obj){
          $obj
					  .removeClass('good')
            .toggleClass('selected')
            .parent()
              .parent()
                .find('.qcm_response')
                  .removeClass('bad')
                  .end()
                .filter(function(){if(!$(this).hasClass('multiple'))return true;})
                  .find('.qcm_response')
                    .filter(function(){if($(this).data('index') != $obj.data('index')) return true;})
                      .removeClass('selected');
        }
      }
    );
    /**
      * QCM COLONNES
      */
    $.widget(
      'demo.exercice_qcm_col',
      $.demo.exercice,
      {
        options:{
          responseAttribute:'underline',
          force_zoom_img:1,
          force_zoom_300:1
        },
        _init : function(){
					var self = this;
          $.demo.exercice.prototype._init.call(this);
					
					// width for header question (columns)
					var header_q_width = 0;
					$('th.header.question:not(.empty)').each(function(){
						var $this = $(this);
						header_q_width += $this.outerWidth(); 
					});
					$('th.header.question:not(.empty)').css('width', Math.floor(header_q_width/self.nbR));
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
					
					var tabR = this._split(this.options.json['items'][0]['response'], this.options.splitTag);
					this.nbR = tabR.length;
					
					// not mobile
					if(!is_mobile) {
						self.$container.addClass('no-mobile');
						
						var $table = $('<table></table>').appendTo(this.$container);
						var $row = $('<tr></tr>').appendTo($table).append('<th class="question header empty"></th>');
						
						for(var r=0; r<this.nbR; r++){
							$('<th' + (r==0?' class="first"':(r==(this.nbR-1)?' class="last"':'')) + '></th>').appendTo($row).addClass('header question').html('<div class="cell-content">' + tabR[r] + '</div>');
						}
						
						for(var q=0; q<this.nbQ; q++){
							$row = $('<tr class="' + (q==0?'first':(q==(this.nbQ-1)?'last':'')) + (q%2!=0?' odd':' even') + '"></tr>').appendTo($table).append('<th class="question_question"><div class="cell-content">'+this.options.json['items'][q]['question']+'</div></th>');
							tabR = this._split(this.options.json['items'][q]['response'], this.options.splitTag);
							for(var r=0; r<this.nbR; r++){
								var $col = $('<td' + (r==0?' class="first"':(r==(this.nbR-1)?' class="last"':'')) + '></td>')
									.addClass('response')
									.appendTo($row)
									.html(tabR[r])
									.bind({
										click:function(){self._click($(this))},
										mouseenter:function(){$(this).addClass('hover');},
										mouseleave:function(){$(this).removeClass('hover');}
									});
								if(this._find($col, this.options.responseAttribute).length)
									$col.addClass('toselect');
								$col.html('<div class="cell-content"></div>');
							}
						}
					}
					// mobile
					else {
						for(var q=0; q<this.nbQ; q++){
							var $qc = $('<div></div>')
							  .addClass('question-container question-container-' + q)
								.appendTo(self.$container)
								.html('<div class="question-content">' +self.options.json['items'][q]['question'] + '</div>');
							var $qcr = $('<ul></ul>')
								.addClass('responses')
								.appendTo($qc);	
							var tabRQ = this._split(this.options.json['items'][q]['response'], this.options.splitTag);	
							for(var r=0; r<this.nbR; r++){
								var $response = $('<li></li>')
									.addClass('response')
									.appendTo($qcr)
									.html(tabR[r])
									.bind('click', function(){
										self._click($(this));
									});
								var $temp	= $('<div></div>').html(tabRQ[r]);
								if(this._find($temp, this.options.responseAttribute).length)
									$response.addClass('toselect');
							}		
						}	
					}
					this._init_video_link($('th.question_question'));
        },
        _testResponse : function(){
          var nbOk = 0;
					
					// not mobile
					if(!is_mobile) {
						for(var q=1; q<=this.nbQ; q++){
							var $row = this.$container.find('tr:eq('+q+')');
							var nbS = $row.find('.selected').length;
							var nbR = $row.find('.toselect').length;
							var nbRS = $row.find('.toselect').filter('.selected').length;
							if(nbRS == nbR && nbRS == nbS) {
								$row.removeClass('bad').addClass('good');
								$row.find('.toselect')
									.filter('.selected')
									.addClass('good')
									.unbind('click')
									.unbind('mouseenter')
									.unbind('mouseleave');
								nbOk++;
							}	
							else {
								$row.removeClass('good').addClass('bad');
								$row.find('.selected').filter(function(){if(!$(this).hasClass('toselect'))return true;}).addClass('bad');
								$row.find('.selected').filter(function(){if($(this).hasClass('toselect'))return true;})
									.addClass('good')
									.unbind('click')
									.unbind('mouseenter')
									.unbind('mouseleave');
							}
						}
					}
					// mobile
					else {
						for(var q=0; q<this.nbQ; q++){
							var $qcont = this.$container.find('.question-container-' + q);
							var nbS = $qcont.find('.selected').length;
							var nbR = $qcont.find('.toselect').length;
							var nbRS = $qcont.find('.toselect').filter('.selected').length;
							if(nbRS == nbR && nbRS == nbS) {
								$qcont.find('.toselect')
									.filter('.selected')
									.addClass('good')
									.unbind('click')
								nbOk++;
							}	
							else {
								$qcont.find('.selected').filter(function(){if(!$(this).hasClass('toselect'))return true;}).addClass('bad');
								$qcont.find('.selected').filter(function(){if($(this).hasClass('toselect'))return true;})
									.addClass('good')
								  .unbind('click');
							}
						}
					}
						
          if(nbOk == this.nbQ)
            this._showResult('ok', {nbOk:nbOk, nb:this.nbQ});
          else
            this._showResult('ko', {nbOk:nbOk, nb:this.nbQ, solution_type:'dotted'});
        },
        _solution : function(){
					var self = this;
					self.$container.addClass('solution');
					// not mobile
					if(!is_mobile) {
						
						this.$container
							.find('td')
								.unbind('click')
								.unbind('mouseenter')
								.unbind('mouseleave')
								.filter('.toselect')
									.filter(function(){if(!$(this).hasClass('selected'))return true;})
										.addClass('solution');
					}
					// mobile
					else {
						this.$container
							.find('.response')
								.unbind('click')
								.filter('.toselect')
									.filter(function(){if(!$(this).hasClass('selected'))return true;})
										.addClass('solution');
					}	
        },
        _replay : function(){
          var self = this;
					// not mobile
					if(!is_mobile) {
						
						if(self.$container.hasClass('solution')) {
							self.$container.removeClass('solution');
							self.$container
								.find('td')
								.unbind('click')
								.unbind('mouseenter')
								.unbind('mouseleave')
								.removeClass('solution')
								.bind({
									click:function(){self._click($(this))},
									mouseenter:function(){$(this).addClass('hover');},
									mouseleave:function(){$(this).removeClass('hover');}
								});
						}	
					}
					// mobile
					else {
						if(self.$container.hasClass('solution')) {
							self.$container.removeClass('solution');
							self.$container
								.find('.response')
								.unbind('click')
								.removeClass('solution')
								.bind('click', function(){
									self._click($(this));
								});
						}
					}
        },
				_redo : function(){
        },
        _click : function($obj){
          $obj.toggleClass('selected');
					$obj.removeClass('bad');
        }
      }
    );
    /**
     * REMETTRE EN ORDRE PHRASE
     */
    $.widget(
      'demo.exercice_rop',
      $.demo.exercice,
      {
        options:{force_zoom_img : 1},
        tabRows:[],
        tabHeaders:[],
        $rows:null,
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          this.$rows = $('<ul></ul>')
            .appendTo(this.$container)
            .addClass('exercice_rows');
          for(var q=0; q<this.nbQ; q++){
            var tabItems = [];
            var tabRow = [];
            var tabWords = this._split(this.options.json.items[q].question, this.options.splitTag);
            this.tabHeaders.push(self._isMedia(tabWords[0]) ? tabWords.shift() : '');
            var countR = tabWords.length;
            for(var r=0; r<countR; r++){
              tabItems.push({id:r,html:tabWords[r]});
            }
            for(var r=countR; r>0; r--){
              tabRow.push(tabItems.splice(Math.floor(Math.random()*r), 1));
            }
            this.tabRows.push(tabRow);

          }
          this._createRows();
        },
        _createRows : function(){
          var self = this;
          this.$rows.html();
          for(var r=0; r<this.nbQ; r++){
            var $row = $('<li></li>')
              .appendTo(this.$rows)
              .addClass('question response exercice_row exercice_row_'+r);
            if(typeof(this.tabHeaders[r]) != 'undefined' && this.tabHeaders[r] != '')
              $('<h2></h2>').appendTo($row).html(this.tabHeaders[r]).parent().addClass('header');
            var countW = this.tabRows[r].length;
            for(var w=0; w<countW; w++){
              var $words = $('<ul></ul>').appendTo($row);
              for(var delta in this.tabRows[r][w]){
								if(typeof(this.tabRows[r][w][delta]['classTag']) != 'undefined' && this.tabRows[r][w][delta]['classTag'] != '') {
									$words.addClass(this.tabRows[r][w][delta]['classTag']);
								}
                var $word = $('<li></li>')
                  .appendTo($words)
                  .addClass('response word word_'+this.tabRows[r][w][delta]['id']+(typeof(this.tabRows[r][w][delta]['classTag']) != 'undefined' ? ' '+this.tabRows[r][w][delta]['classTag'] : '')+(delta == 0 ? ' first' : '')+(Number(delta)+1 == this.tabRows[r][w].length ? ' last' : ''))
                  .data('id', this.tabRows[r][w][delta]['id'])
                  .html(this.tabRows[r][w][delta]['html']);
              }
            }
            $row.sortable({
              tolerance:'pointer',
              revert:true,
              placeholder: 'exercice_placeholder',
              items:'> ul',
              //axis:"x",
              start: function (event,ui){
                var $this = $(this);
                var $item = $(ui.item);
                var $placeholder = $(ui.placeholder);
                $this.find('.bad').removeClass('bad');
								$this.find('.good').removeClass('good');
                self._zoomIn($item);
                $placeholder.width($item.outerWidth(true));
              },
              stop: function(event,ui){
                self._zoomOut($(ui.item));
              },
              change: function (event,ui){
                var $item = $(ui.item);
                var $placeholder = $(ui.placeholder);
                $placeholder.width(0).animate({width:$item.outerWidth(true)});
              }
            })
            .disableSelection();

          }
        },
        _testResponse : function() {
          var nbOk = 0;
          var tabWord = [];
          var nbW = 0;
          var countR = 0;
          for(var delta in this.tabRows)
            countR += this.tabRows[delta].length;
          for(var r=0; r<this.nbQ; r++)
          {
            this.tabRows[r] = [];
            this.tabMyResponse[r] = '';
            var $words = this.$container.find('.exercice_row_'+r+' .word');
            var countW = $words.length;
            nbW += countW;
            for(var w=0; w<countW; w++){
              var $word = $($words[w]);
              this.tabMyResponse[r] += (this.tabMyResponse[r] != '' ? ' ' : '')+$word.html();
              if($word.data('id') === w){
                nbOk++;
              }
              tabWord.push({id:$word.data('id'), html:$word.html(), classTag:($word.data('id') === w ? 'good' : 'bad')});
              if($($words[w+1]).data('id')-1 !== $word.data('id')){
                this.tabRows[r].push(tabWord);
                tabWord = [];
              }
            }
          }
          if (nbOk == nbW) {
            this._showResult('ok', {analysis:''});
          } else {
            this._showResult('ko', {solution_type:'dotted'});
          }
        },
        _replay : function() {
          this.$rows.children().remove();
          this._createRows();
					this._initAsset();
          this._initImg();
        },
        _solution : function() {
          var self = this;
          this.$rows.children().remove();
          this._createRows();												
					this._initAsset();
          this._initImg();
          for(var r=0; r<this.nbQ; r++)
          {
            var $row = this.$container.find('.exercice_row_'+r);
						var nWR = self.tabRows[r].length;
						var tabRowsGood = [];
						var correct = true; 						
						for(var w=0; w<nWR; w++) {
							var wHtml = '';
							for(var delta in self.tabRows[r][w]){
								if(self.tabRows[r][w][delta]['classTag'] == 'bad') {
									correct = false;
								}
								wHtml += '<span>' + self.tabRows[r][w][delta]['html'] + '</span>';
							}	
							tabRowsGood.push({'first':self.tabRows[r][w][0]['id'], 'word':w, 'html':wHtml});
						}
						if(!correct) {
							//tabRowsGood.sort(self._compare);
							tabRowsGood.sort(function(a, b){
								if ( a.first < b.first ){
									return -1;
								}
								if ( a.first > b.first ){
									return 1;
								}
								return 0;
							});
							var solution_html = '';
							for(var delta in tabRowsGood){
								solution_html += tabRowsGood[delta]['html'];
							}
							$row.append('<div class="wrap-rop-solution"><div class="rop-solution">' + solution_html + '</div></div>');
						}				

            $row
              .sortable('disable')
              .data('id', r);
          }
        },
				_compare( a, b ) {
					if ( a.first < b.first ){
						return -1;
					}
					if ( a.first > b.first ){
						return 1;
					}
					return 0;
				},
				_redo : function(){
					var self = this;
					self.tabRows = [];
          self.tabHeaders = [];
          self.$rows = null;
        }
      }
    );
    /**
     * REMETTRE EN ORDRE RECONSTITUTION
     */
    $.widget(
      'demo.exercice_ror',
      $.demo.exercice,
      {
        tabRows:[],
        $rows:null,
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          var tabItems = [];
          this.$rows = $('<ul></ul>')
            .appendTo(this.$container)
            .addClass('exercice_rows');
            /*.sortable({
                tolerance:'pointer',
								scrollSpeed: 5,
                revert:true,
                placeholder: 'exercice_placeholder',
                items:'> li',
                start: function (event,ui){
                  var $this = $(this);
                  var $item = $(ui.item);
                  var $placeholder = $(ui.placeholder);
                  $item.find('.word_content').width($this.find('.word_content').width());
                  $this.find('.bad').removeClass('bad');
									$this.find('.good').removeClass('good');
                  $placeholder.height($item.outerHeight(true));
                },
                stop: function(event,ui){
									$(ui.item).removeClass('zoom');
                },
                change: function (event,ui){
                  var $item = $(ui.item);
                  var $placeholder = $(ui.placeholder);
                  $placeholder.height(0).animate({height:$item.outerHeight(true)});
                }
            });	*/
						
          for(var r=0; r<this.nbQ; r++)
            tabItems.push({id:r,html:this.options.json.items[r].question});
          for(var r=this.nbQ; r>0; r--)
            this.tabRows.push(tabItems.splice(Math.floor(Math.random()*r), 1));
          this._createRows();
					
					$('ul.exercice_rows').sortable({
						tolerance:'pointer',
						scrollSpeed: 10,
						revert:true,
						placeholder: 'exercice_placeholder',
						forcePlaceholderSize:true,
						items:'> li',
						containment: '.exercice_items',
						start: function (event, ui){
							var $this = $(this);
							var $item = $(ui.item);
							var $placeholder = $(ui.placeholder);
							//$item.find('.word_content').width($this.find('.word_content').width());
							$this.find('.bad').removeClass('bad');
							$this.find('.good').removeClass('good');					
							//$placeholder.height($item.outerHeight(true));
							//$this.height($this.height() + $item.height());
						},
						/*create: function(event,ui){
							var $this = $(this);					
							$this.imagesLoaded( function() {t());
								$this.height($this.height());
							});
						},*/
						stop: function(event, ui){
							var $this = $(this);
							$(ui.item).removeClass('zoom');
							$this.height('auto');
						},
						change: function (event, ui){
							var $this = $(this);
							var $item = $(ui.item);
							var $placeholder = $(ui.placeholder);
							//$placeholder.height(0).animate({height:$item.outerHeight(true)});
						}
					});
        },
        _createRows : function(){
          var self = this;
          var nbR = this.tabRows.length;
          var $row = null;
          var $words = null;
          var $word = null;
          this.$rows.html();
          for(var r=0; r<nbR; r++){
            $row = $('<li></li>')
              .appendTo(this.$rows)
              .addClass('exercice_row exercice_row_'+r);
						
						$row.mousedown(function() {
							if(!$(this).parent().hasClass('ui-sortable-disabled')) {
								$(this).addClass('zoom');					
								$(this).parent().height($(this).parent().height());
							}
						});
						$row.mouseup(function() {
							if(!$(this).parent().hasClass('ui-sortable-disabled') && !$(this).hasClass('ui-sortable-helper')) {
								$(this).removeClass('zoom');
								$(this).parent().height('auto');
							}
						});	
							
            $words = $('<ul></ul>').appendTo($row);
            for(var delta in this.tabRows[r]){
							if(typeof(this.tabRows[r][delta]['classTag']) != 'undefined' && this.tabRows[r][delta]['classTag'] != '') {
								$row.addClass(this.tabRows[r][delta]['classTag']);
							}
              $word = $('<li></li>')
                .appendTo($words)
                .addClass('question word word_'+this.tabRows[r][delta]['id']+(typeof(this.tabRows[r][delta]['classTag']) != 'undefined' ? ' '+this.tabRows[r][delta]['classTag'] : '')+(delta == 0 ? ' first' : '')+(Number(delta)+1 == this.tabRows[r].length ? ' last' : ''))
                .data('id', this.tabRows[r][delta]['id'])
                .html('<div class="word_content">'+this.tabRows[r][delta]['html']+'</div>');
            }
          }
        },
        _testResponse : function() {
					var self = this;
          var nbOk = 0;
          var tabWord = [];
          var $rows = this.$container.find('.word');
          var $row = null;
          var countR = this.tabRows.length;
					var my_reponse = '';
          this.tabMyResponse = [];
          this.tabRows = [];
          for(var r=0; r<this.nbQ; r++)
          {
            $row = $($rows[r]);
            tabWord.push({id:$row.data('id'), html:$row.children().html(), classTag:$row.data('id') === r ? 'good' : 'bad'});
            if($($rows[r+1]).data('id')-1 !== $row.data('id')){
							my_reponse = '<ul>';
							for(var delta in tabWord){
								my_reponse += '<li>' + tabWord[delta]['html'] + '</li>';
							}	
							my_reponse += '</ul>';
							this.tabMyResponse.push(my_reponse);							
              this.tabRows.push(tabWord);
              tabWord = [];
            }
          }
					var tabRowsGood = [];
					for(var r=0; r<this.tabRows.length; r++) {
						tabRowsGood.push({'first':this.tabRows[r][0]['id'], 'row':r});
					}	
					//tabRowsGood.sort(self._compare);
					tabRowsGood.sort(function(a, b){
						if ( a.first < b.first ){
							return -1;
						}
						if ( a.first > b.first ){
							return 1;
						}
						return 0;
					});
					for(var r=0; r<this.tabRows.length; r++) {
						if(tabRowsGood[r]['first'] == this.tabRows[r][0]['id']) {
							nbOk++;
							for(var delta in this.tabRows[r]){
								this.tabRows[r][delta]['classTag'] = 'good';
							}	
						}
					}

          if (nbOk == this.tabRows.length) {
            this._showResult('ok', {analysis:''});
          } else {
            this._showResult('ko', {solution_type:'hover'});
          }
        },
        _replay : function() {
          this.$rows.sortable('enable').children().remove();
          this._createRows();
					this._initAsset();
          this._initImg();
        },
        _solution : function() {
          var self = this;
          var top = 0;
          var $row = null;
					var nbR = this.tabRows.length;
					this.$rows.height(this.$rows.height()).sortable('disable').children().remove();
          this._createRows();
					this._initAsset();
          this._initImg();
					var tabRowsSolution = [];
					for(var r=0; r<nbR; r++) {
						tabRowsSolution.push({'first':self.tabRows[r][0]['id'], 'row':r});
					}	
					//tabRowsSolution.sort(self._compare);
					tabRowsSolution.sort(function(a, b){
						if ( a.first < b.first ){
							return -1;
						}
						if ( a.first > b.first ){
							return 1;
						}
						return 0;
					});
					for(var r in tabRowsSolution){
						$row = self.$container.find('li.exercice_row_'+tabRowsSolution[r]['row']);
						$row.data('rid', r);
						$row
						  .css('position','absolute')
              .animate({top:top})
              .bind({
								mouseenter:function(){
									if($(this).hasClass('solution')) {
										self._showMyResponse($(this), self.tabMyResponse[$(this).data('rid')], {valign:'bottom'});
									}
								},
                mouseleave:function(){
									if($(this).hasClass('solution')) {
										self._hideMyResponse();
									}
								}
              });
						top += $row.outerHeight(true);	
						if($row.hasClass('bad')){
              $row.removeClass('bad').addClass('solution');
            }	
					}	
        },
				_compare( a, b ) {
					if ( a.first < b.first ){
						return -1;
					}
					if ( a.first > b.first ){
						return 1;
					}
					return 0;
				},
				_redo : function(){
					var self = this;
          self.tabRows = [];
					self.$rows = null;
        }
      }
    );
    /**
     * TEXTE A CORRIGER
     */
    $.widget(
      'demo.exercice_tac',
      $.demo.exercice,
      {
        options:{
          selectAttribute:'underline',
          disableAttribute:new RegExp(/\[(.*?)\]/i),
          groupAttribute:new RegExp(/\{(.*?)\}/i)
        },
        tabTextResult:[],
        tabResult:[],
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          var tabResponse = [];
          this.tabTextResult = this._split(this.options.analysis_text, this.options.splitTag);
					var jsonItemQuestion = this.options.json['items'][0]['question'].replace(/ data-entity-embed-display-settings="\[\]"/g, '');
          var $questiontext = $('<div></div>')
            .appendTo(this.$container)
            .addClass('question_text question')
            .html(jsonItemQuestion);
          var tabS = this._findAndReplace($questiontext, this.options.selectAttribute, 'SelectedElm');
          var tabD = this._findAndReplace($questiontext, this.options.disableAttribute, 'DisableElm');
          var tabG = this._findAndReplace($questiontext, this.options.groupAttribute, 'GroupElm');
          this.nbQ = tabS.length;
          for(r=0; r<this.nbQ; r++){
            tabResponse = this._stripHtml(tabS[r]).split('|');
            this.tabResult.push(tabResponse[0]);
            tabS[r] = tabResponse[1];
          }
          var tabH = [];
          $questiontext.text(this._stripHtml($questiontext.html(), '§', tabH));
          $questiontext.html(this._splitTextInWords($questiontext.text(), 'span', 'word'));
          $questiontext.html(this._recursiveReplace($questiontext.html(), 'GroupElm', tabG, 'span', 'word'));
          $questiontext.html(this._recursiveReplace($questiontext.html(), 'DisableElm', tabD, 'span', 'disable'));
          $questiontext.html(this._recursiveReplace($questiontext.html(), 'SelectedElm', tabS, 'span', 'toselect'));
          $questiontext.html(this._recursiveReplace($questiontext.html(), '§', tabH));
          $questiontext.find('.word, .toselect')
            .filter(
              function(){
                if(!$(this).find('.disable, .toselect').length)
                  return true;
              }
            )
            .addClass('selectable')
          $questiontext
            .find('.selectable')
              .each(function(){
                var $this = $(this);
                var text = $this.text();
                $this
                  .data('oText', self._stripHtml(text))
                  .bind('click', function(){self._click($(this));});
              })
          this._initKeyboard();
					this._init_video_link($questiontext);
        },
        _testResponse : function() {
          var self = this;
          var nbOk = 0;
          var nbKo1 = 0;
          var nbKo2 = 0;
          var nb = 0;
          this._click();
          this.$container
            .find('.toselect')
              .each(function(index){
                var $this = $(this);
                var text = $this.text();
                var oText = $this.data('oText');
                if(text == self.tabResult[index]){
                  nbOk++;
                } else if(text != oText){
                  nbKo1 ++;
                  $this.data('myText', text);
                }
              })
              .end()
            .find('.selectable')
              .filter(function(){if(!$(this).hasClass('toselect')) return true;})
                .each(function(){
                  var $this = $(this);
                  var text = $this.text();
                  if(text != $this.data('oText')){
                    $this.data('myText', text);
                    nbKo2 ++;
                  }
                });
          nb = this.nbQ - nbOk - nbKo1;
          if(nbOk == this.nbQ && !nbKo2){
						var params = {};
            params.analysis = '';
            if (nbOk){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk', nbOk);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk > 1 ? 's' : '');
            }
            if (nbKo1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbKo1', nbKo1);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo1 > 1 ? 's' : '');
            }
            if (nbKo2) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nbKo2', nbKo2);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo2 > 1 ? 's' : '');
            }
            if (nb>1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[3];
              params.analysis = params.analysis.replace('nb', nb);
              params.analysis = params.analysis.replace(/\(s\)/g, nb > 1 ? 's' : '');
            }
            this._showResult('ok', params);
          }else{
            var params = {};
            params.analysis = '';
            if (nbOk){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk', nbOk);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk > 1 ? 's' : '');
            }
            if (nbKo1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbKo1', nbKo1);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo1 > 1 ? 's' : '');
            }
            if (nbKo2) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nbKo2', nbKo2);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo2 > 1 ? 's' : '');
            }
            if (nb>1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[3];
              params.analysis = params.analysis.replace('nb', nb);
              params.analysis = params.analysis.replace(/\(s\)/g, nb > 1 ? 's' : '');
            }
						params.solution_type = 'dotted';
            this._showResult("ko", params);
          }
        },
        _solution: function() {
          var self = this;
          var index = 0;
          this.$container
            .find('.selectable')
              .unbind('click')
              .each(function(){
                var $this = $(this);
                var oText = $this.data('oText');
                var text = $this.text();
                var toselect = $this.hasClass('toselect');
                if((!toselect && text != oText) || (text != self.tabResult[index] && toselect)) {
									var span_response = $('<span></span>')
										.addClass('tac-response-item')
										.html(toselect ? self.tabResult[index] : oText);
									$this.after(span_response);
								}		
                else if(toselect && text == self.tabResult[index])
                  $this.addClass('good');
                if(toselect)
                  index++;
              })
        },
        _replay: function() {
          var self = this;
					$('.tac-response-item').remove();
          this.$container
            .find('.solution')
              .removeClass('solution')
              .end()
            .find('.selectable')
              .unbind('mouseenter')
              .unbind('mouseleave')
              .bind('click', function(){self._click($(this))})
              .filter(function(){if(!$(this).hasClass('toselect')) return true;})
                .each(function(index){
                  var $this = $(this);
                  if($this.data('myText'))
                    $this.text($this.data('myText')).data('myText', '');
                  var text = $this.text();
                  if(text != $this.data('oText'))
                    $this.addClass('bad');
                })
                .end()
              .end()
            .find('.toselect')
              .each(
                function(index){
                  var $this = $(this);
                  if($this.data('myText'))
                    $this.text($this.data('myText')).data('myText', '');
                  var text = $this.text();
                  var oText = $this.data('oText');
                  if(text != oText && text != self.tabResult[index])
                    $this.addClass('bad');
                  else if(text == self.tabResult[index])
                    $this.addClass('good');
                }
              );
        },
        _click: function($obj) {
          var self = this;
          this.$container.find('.selectable').removeClass('good bad selected');
          if(typeof($obj) == 'undefined')
            $obj = this.$container.find('.selectable input').parent();
          if($obj.find('input').length)
            $obj.each(
              function(){
                var $this = $(this);
                $this
								  .removeClass('toinput')
                  .html($this.find('input').val())
                  .bind('click', function(){self._click($this);});
              });
          else
            $obj.each(
              function(){
                var $this = $(this);
								var span_width = $this.innerWidth();
                $this
									.addClass('toinput')
                  .unbind('click')
                  .html('<input type="text" value="'+$this.text()+'"/>')
                  .find('input')
									  .width(span_width)
                    .focus()
                    .bind('blur', function(){if(!self.$activeElement) self._click($(this).parent())});
              });
        },
				_redo : function(){
					var self = this;
          self.tabTextResult = [];
					self.tabResult = [];
        }
      }
    );
    /**
     * TEXTE A TROUS AVEC CASES
     */
    $.widget(
      'demo.exercice_tat_ac',
      $.demo.exercice,
      {
        options:{
          questionAttribute:'underline',
          force_zoom_img:1
        },
        tabResult:[],
        tabTextResult:[],
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var excludeKeyCodes = Array(8,9,13,16,17,18,19,20,27,33,34,35,36,37,38,39,40,44,45,46,91,92,93,112,113,114,115,116,117,118,119,120,121,122,123,144,145,160,221,219);
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          var $fieldset = null;
          var $input = null;
          var nbL;
          this.tabTextResult = this._split(this.options.analysis_text, this.options.splitTag);
          var $questiontext = $('<div></div>')
            .appendTo(this.$container)
            .addClass('question question_text')
            .html(this.options.json['items'][0]['question']);
          var $questions = this._find($questiontext, this.options.questionAttribute);
          if(typeof($questions) != 'object' || !$questions.length)
            return;
          $questions
            .each(function(){
              var $this = $(this);
              var txt = self._stripHtml($this.html());
              var tabTxt = txt.split('|');
              self.tabResult.push(tabTxt);
            })
            .replaceWith('<div class="dfieldset"></div');
						//.replaceWith('<fieldset></fieldset');
          this.nbQ = this.tabResult.length;
          for(var q=0; q<this.nbQ; q++){
						//$fieldset = $questiontext.find('fieldset:eq('+q+')')
            $fieldset = $questiontext.find('div.dfieldset:eq('+q+')')
            $fieldset
              .data('id', q)
            nbL = this.tabResult[q][0].length;
            for(var l=0; l<nbL; l++){
              $input = $('<input maxlength="1" class="input_'+l+'"'+(this.tabResult[q][0].substr(l,1) == '*'?' id="empty-'+l+'"':'')+' />')
                .appendTo($fieldset)
                .data('qIndex', q)
                .val(typeof(this.tabResult[q][1]) != 'undefined' && this.tabResult[q][1].substr(l,1) != '.'  ? this.tabResult[q][1].substr(l,1) : '')
                .focus(function(){
                  var $this = $(this);
                  if($this.data('disabled') === true){
                    $this.blur();return;
                  }
                  $this
                    .removeClass('bad');
                })
                .keydown(function(e){
                  var $this = $(this);
                  var regexp = new RegExp(/\w/);
                  switch(e.keyCode){
										// backspace
                    case 8:
                      //self._prevInput($this);
                    break;
										// tab
                    case 9:
                      if(self.shiftKey){
                        self._prevInput($this);
                      }else{
                        self._nextInput($this);
                      }
                      return false;
                    break;
										// shift
                    case 16:
                      self.shiftKey = 1;
                    break;
                    default:
                      if(excludeKeyCodes.indexOf(e.which) == -1)
                        $(this).val('');
                  }
                })
                .keyup(function(e){
                  var $this = $(this);
                  //var regexp = new RegExp(/\w/);
                  //console.log(e.keyCode + ' ' + excludeKeyCodes.indexOf(e.which));
                  if(e.keyCode == 16){
                    self.shiftKey = 0;
                    return;
                  } else if(excludeKeyCodes.indexOf(e.which) != -1){
                    return;
                  }
                  self._nextInput($this);
                });
             }
          };
          this._initKeyboard();
					this._init_video_link($questiontext);
        },
        _prevInput : function($obj){
          var id = Number($obj.attr('class').substr(6));
          if($obj.parent().find('.input_'+(id-1)).length)
            $obj
              .parent()
                .find('.input_'+(id-1))
                .focus();
          else
            this._prev($obj.data('qIndex'));
        },
        _nextInput : function($obj){
          var id = Number($obj.attr('class').substr(6));
          if($obj.parent().find('.input_'+(id+1)).length)
            $obj
              .parent()
                .find('.input_'+(id+1))
                .focus();
          else
            this._next($obj.data('qIndex'));
        },
        _prev : function(qIndex){
          if(this.$container.find('div.dfieldset:eq('+(Number(qIndex)-1)+')').length)
            this.$container.find('div.dfieldset:eq('+(Number(qIndex)-1)+') input:last-child').focus();
          else
            this.$container.find('div.dfieldset:last-child input:last-child').focus();
        },
        _next : function(qIndex){
          if(this.$container.find('div.dfieldset:eq('+(Number(qIndex)+1)+')').length)
            this.$container.find('div.dfieldset:eq('+(Number(qIndex)+1)+') input:first-child').focus();
          else
            this.$container.find('div.dfieldset:first-child input:first-child').focus();
        },
        _testResponse : function() {
          var tab = [];
          var nbOk = 0;
          var nbOk1 = 0;
          var nbOk2 = 0;
          var nbKo = 0;
          this.tabMyResponse = [];
					this.tabMyResponseHover = [];
          for (var q = 0; q<this.nbQ; q++) {
            var $fieldset = this.$container.find('div.dfieldset:eq('+q+')');
            var $inputs = $fieldset.children('input');
            var nbI = $inputs.length;
            var testTxt = '';
            this.tabMyResponse[q] = [];
						this.tabMyResponseHover[q] = [];
            for(var i=0; i<nbI; i++){
              var $input = $($inputs[i]);
              var value = $input.val();
              testTxt += value;
              this.tabMyResponse[q].push(value ? value : ' ');
							var valuehover = (value ? value : ' ');
              if(value != '' && value != ' ' && value != this.tabResult[q][0].substr(i,1)){
                $input.addClass('bad');
								valuehover = '<span>' + valuehover + '</span>';
              }
							this.tabMyResponseHover[q].push(valuehover);
            }
            if (testTxt == this.tabResult[q][0].replace(/\*/g, '')) {
              nbOk1++;
              nbOk++;
            } else if (this._unaccentedStr(testTxt.toLowerCase()) == this._unaccentedStr(this.tabResult[q][0].toLowerCase())){
              nbOk2++;
            }
          }
          if (nbOk == this.nbQ) {
						$('body').addClass('exo-all-ok');
						var params = {};
            params.analysis = '';
            if (nbOk1){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk1', nbOk1);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk1 > 1 ? 's' : '');
            }
            if (nbOk2) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbOk2', nbOk2);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk2 > 1 ? 's' : '');
            }
            nbKo = this.nbQ-nbOk1;
            if (nbKo>1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nbKo', nbKo);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo > 1 ? 's' : '');
            }
            this._showResult('ok', params);
          } else {
            var params = {};
            params.analysis = '';
            if (nbOk1){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk1', nbOk1);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk1 > 1 ? 's' : '');
            }
            if (nbOk2) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbOk2', nbOk2);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk2 > 1 ? 's' : '');
            }
            nbKo = this.nbQ-nbOk1;
            if (nbKo>1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nbKo', nbKo);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo > 1 ? 's' : '');
            }
						params.solution_type = 'hover';
            this._showResult("ko",params);
          }
        },
        _solution: function() {
          var self = this;
          for (var q = 0; q<this.nbQ; q++) {
            var i = 0;
            this.$container
              .find('div.dfieldset:eq('+q+') input')
                .each(
                  function(){
                    var $this = $(this);
                    var txt = self.tabResult[q][0].substr(i, 1);
                    if(txt == '*') {
                      txt = '';
                    }
                    if($this.val() != txt){
                      $this.addClass('solution');
                    }
                    $this
                      .val(txt)
                      .data('disabled', true)
                      .filter('.bad')
                      .parent()
                        .bind({
                          mouseenter:function(){
                            var $this = $(this);
                            var q = $this.data('id');
                            self._showMyResponse($this, self.tabMyResponseHover[q].toString().replace(/ /gi, '&nbsp;').replace(/,/g, ''), {valign:'bottom', align:'center'})
                          },
                          mouseleave:function(){
                            self._hideMyResponse();
                          }
                        });
                    i++;
                  }
                );
          }
        },
        _replay: function() {
          var self = this;
          for (var q=0; q<this.nbQ; q++) {
            var i = 0;
            this.$container.find('div.dfieldset:eq('+q+')').unbind('mouseenter').unbind('mouseleave').children('input').each(
              function(){
                $(this).val(self.tabMyResponse[q][i]).data('disabled', false).removeClass('solution').hover(function(){return;},function(){return;});
                i++;
              }
            );
          }
        },
				_redo : function(){
					var self = this;
          self.tabResult = [];
          self.tabTextResult = [];
					$('body').removeClass('exo-all-ok');
        }
      }
    );
    /**
     * TEXTE A TROUS MENU DEROULANT
     */
    $.widget(
      'demo.exercice_tat_md',
      $.demo.exercice,
      {
        options:{
          questionAttribute:'underline'
        },
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          var $questiontext = $('<div></div>')
            .appendTo(this.$container)
            .addClass('question question_text')
            .html(this.options.json['items'][0]['question']);
          var $questions = this._find($questiontext, this.options.questionAttribute);
          if(typeof($questions) != 'object' || !$questions.length)
            return;
          this.nbQ = $questions.length;
          for(var q=0; q<this.nbQ; q++){
            var $question = $($questions[q]);
            var tabT = $question.html().split('|');
            var tabR = [];
            for(var delta in tabT)
              tabR.push({id:Number(delta)+1,html:tabT[delta]});
            $question.replaceWith('<div class="question_response"><div class="response_content"></div></div>')
            $question = $questiontext.find('.question_response:eq('+q+')');
            $question.find('.response_content').bind({
							click:function(){self._over($(this).parent())},
              //mouseenter:function(){self._over($(this))},
              //mouseleave:function(){self._out($(this))}
            });
            var $menu = $('<ul></ul>').appendTo($question);
            var nbR = tabR.length;
            for(var r=nbR; r>=1; r--){
              var tR = tabR.splice(Math.floor(Math.random()*r), 1);
              var $item = $('<li></li>')
                .appendTo($menu)
                .data('id', tR[0].id)
                .html(tR[0].html)
                .bind({
                  mouseenter:function(){$(this).addClass('act')},
                  mouseleave:function(){$(this).removeClass('act')},
                  click:function(){self._click($(this))}
                });
            }
						$menu.wrap('<div class="wrapper-menu-tat-md"></div>');
						var qr_width = Math.round($menu.width());
						var width_toset = qr_width + 40;
						if(width_toset > (this.$container.width() - 30)) {
							width_toset = (this.$container.width() -30);
						}
						$question.css ('width', width_toset);
						$menu.parent().css('width', width_toset);
						$menu.parent().hide();
						var qr_span = $('<span></span>');
						$menu.parent().prepend(qr_span);
						qr_span.bind({
							click:function(){self._out($(this).parent().parent())}
						});
          }
					this._init_video_link($questiontext);
					
        },
        _testResponse : function() {
          var nbOk = 0;
          var self = this;
          this.tabMyResponse = [];
          this.$container.find('.question_response').each(
            function(){
              var $this = $(this);
              var id = $this.data('id');
              if(id === 1) {
                nbOk++;
							  $this.addClass('good');
							}	
              else if(id) {
                $this.addClass('bad');
							}	
            }
          );
          if(nbOk == this.nbQ)
            this._showResult('ok', {nbOk:nbOk,nb:this.nbQ});
          else
            this._showResult('ko', {nbOk:nbOk,nb:this.nbQ,solution_type:'dotted'});
        },
        _solution: function() {
          var self = this;
          this.$container.find('.question_response').each(
            function(){
              var $this = $(this);
              var $response = $this.find('li').filter(function(){if($(this).data('id') == 1) return true;});
              var id = $this.data('id');
							if(!id || id != 1) {
								var span_response = $('<span></span>')
								.addClass('tat-md-response-item')
								.html($response.html());
								$this.after(span_response);
							}	
              if(id && id != 1){						
                $this
                  .find('li.selected')
                    .addClass('bad')
                    .end()
                  .find('li')
                    .unbind('mouseenter mouseleave click');
              } else {
                $this.unbind('mouseenter');
              }
            }
          );
        },
        _replay: function() {
          var self = this;
					$('.tat-md-response-item').remove();
          this.$container.find('.question_response').each(
            function(){
              var $this = $(this);
              var id = $this.data('id');
              var $rc = $this.find('.response_content');
              $this
                .find('li')
                  .bind({
                    mouseenter:function(){$(this).addClass('act')},
                    mouseleave:function(){$(this).removeClass('act')},
                    click:function(){self._click($(this))}
                  });

              if(id){
                var $response = $this.find('li').filter(function(){if($(this).data('id') == id) return true;});
                $rc.html($response.html());
              } else {
                $rc.html('');
              }
            }
          );
        },
				_redo : function(){
        },
        _over:function($obj){
					$('.wrapper-menu-tat-md').removeClass('show');
					$('.wrapper-menu-tat-md').hide();
          $obj
            .find('.wrapper-menu-tat-md')
						  .addClass('show')
              .show();
        },
        _out:function($obj){
					$('.wrapper-menu-tat-md').removeClass('show')
					$('.wrapper-menu-tat-md').hide();
          /*$obj
            .find('.wrapper-menu-tat-md')
              .hide();*/
        },
        _click:function($obj){
          $obj
            .parent()
              .children()
                .removeClass('selected')
                .removeClass('bad')
                .end()
              .parent().parent()
                .removeClass('bad')
								.removeClass('good')
                .addClass('question_response_act')
                .data('id', $obj.data('id'))
                .find('.response_content')
                  .html($obj.html())
                  .end()
                .end()
              .end().end()						
            .addClass('selected');
          this._out($obj.parent().parent());
        }
      }
    );
    /**
     * TEXTE A TROUS SANS CASES
     */
    $.widget(
      'demo.exercice_tat_sc',
      $.demo.exercice,
      {
        options:{
          questionAttribute:'underline',
          force_zoom_img:1
        },
        tabResult:[],
        tabTextResult:[],
        nbL:0,
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          var maxlength = 0;
          this.tabTextResult = this._split(this.options.analysis_text, this.options.splitTag);
          var $questiontext = $('<div></div>')
            .appendTo(this.$container)
            .addClass('question question_text')
            .html(this.options.json['items'][0]['question']);
          var $questions = this._find($questiontext, this.options.questionAttribute);
          if(typeof($questions) != 'object' || !$questions.length)
            return;
          $questions
            .each(function(){
              var $this = $(this);
              var txt = self._stripHtml($this.html());
              maxlength = Math.max(maxlength, txt.length);
              self.tabResult.push(txt);
            })
            .replaceWith('<span class="input"><input type="text" value="" maxlength="'+maxlength+'" size="'+maxlength+'"/></span>');
          this.nbQ = this.tabResult.length;
          for(var q=0; q<this.nbQ; q++){
            $questiontext
              .find('input:eq('+q+')')
                .data('id', q)
                .focus(function(){
                  var $this = $(this);
                  if($this.data('disabled') === true){
                    $this.blur();return;
                  }
                  if($this.hasClass('bad') && $this.val() != ''){
                    $this.removeClass('bad');
                    if(self.options.display_indice != 'no') {
                      $this.val(self.tabResult[$this.data('id')].substr(0, self.nbL).replace(/\*/g, ''));
                    }
                  }
                });
          };
          this._initKeyboard();
					this._init_video_link($questiontext);
        },
        _testResponse : function() {
          var tab = [];
          var nbOk = 0;
          var nbOk1 = 0;
          var nbOk2 = 0;
          var nbKo = 0;
          this.tabMyResponse = [];
          for (var q = 0; q<this.nbQ; q++) {
            var $input = this.$container.find('input:eq('+q+')');
            var value = $input.val();
            this.tabMyResponse.push($input.val());
            if (value == this.tabResult[q].replace(/\*/g, '')) {
              nbOk1++;
              nbOk++;
							$input.addClass('good');
            } else if (this._unaccentedStr(value.toLowerCase()) == this._unaccentedStr(this.tabResult[q].toLowerCase())){
              $input.addClass('bad');
              nbOk2++;
            } else if(value && value != ' ') {
              $input.addClass('bad');
            }
          }
          if (nbOk == this.nbQ) {
						var params = {};
            params.analysis = '';
            if (nbOk1){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk1', nbOk1);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk1 > 1 ? 's' : '');
            }
            if (nbOk2) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbOk2', nbOk2);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk2 > 1 ? 's' : '');
            }
            nbKo = this.nbQ-nbOk1;
            if (nbKo>1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nbKo', nbKo);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo > 1 ? 's' : '');
            }
            this._showResult('ok', params);
          } else {
            var params = {};
            params.analysis = '';
            if (nbOk1){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk1', nbOk1);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk1 > 1 ? 's' : '');
            }
            if (nbOk2) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbOk2', nbOk2);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk2 > 1 ? 's' : '');
            }
            nbKo = this.nbQ-nbOk1;
            if (nbKo>1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nbKo', nbKo);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo > 1 ? 's' : '');
            }
						params.solution_type = 'dotted';
            this._showResult("ko", params);
          }
        },
        _solution: function() {
          var self = this;
          for (var q = 0; q<this.nbQ; q++) {
            var $input = this.$container.find('input:eq('+q+')');
            if($input.val() != this.tabResult[q]){
              //$input.addClass('solution');
							$input.data('disabled', true);
							var span_response = $('<span></span>')
								.addClass('tat-sc-response-item')
								.html(this.tabResult[q].replace(/\*/g, ''));
							$input.after(span_response);
            }
          }
        },
        _replay: function() {
					$('.tat-sc-response-item').remove();
          this.nbL++;
          for (var q=0; q<this.nbQ; q++) {
            var $input = this.$container.find('input:eq('+q+')');
            $input.val(this.tabMyResponse[q]).data('disabled', false).removeClass('solution').parent().unbind('mouseenter').unbind('mouseleave');
          }
        },
				_redo : function(){
					var self = this;
          self.tabResult = [];
          self.tabTextResult = [];
        }
      }
    );
    /**
     * ZONES A CLIQUER
     */
    $.widget(
      'demo.exercice_zac',
      $.demo.exercice,
      {
        options:{
          selectAttribute:'underline',
          disableAttribute:new RegExp(/\[(.*?)\]/i),
          groupAttribute:new RegExp(/\{(.*?)\}/i)
        },
        tabTextResult:[],
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
          this.tabTextResult = this._split(this.options.analysis_text, this.options.splitTag);
					var jsonItemQuestion = this.options.json['items'][0]['question'].replace(/ data-entity-embed-display-settings="\[\]"/g, '');
          var $questiontext = $('<div></div>')
            .appendTo(this.$container)
            .addClass('question question_text')
            .html(jsonItemQuestion);
          var tabH = Array();
          var tabG = this._findAndReplace($questiontext, this.options.groupAttribute, ' GroupElm ');
          var tabS = this._findAndReplace($questiontext, this.options.selectAttribute, ' SelectedElm ');
          this.nbQ = tabS.length;
          var tabD = this._findAndReplace($questiontext, this.options.disableAttribute, ' DisableElm ');
          $questiontext.text(this._stripHtml($questiontext.html(), '§', tabH));
          $questiontext.html(this._splitTextInWords($questiontext.text(), 'span', 'word'));
          $questiontext.html(this._recursiveReplace($questiontext.html(), 'GroupElm', tabG));
          $questiontext.html(this._recursiveReplace($questiontext.html(), 'DisableElm', tabD, 'span', 'disable'));
          $questiontext.html(this._recursiveReplace($questiontext.html(), 'SelectedElm', tabS, 'span', 'toselect'));
          $questiontext.html(this._recursiveReplace($questiontext.html(), '§', tabH));

          $questiontext.find('.word, .toselect')
            .filter(
              function(){
                if(!$(this).find('.disable, .toselect').length)
                  return true;
              }
            )
            .addClass('selectable')
          $questiontext.find('.selectable').bind('click', function(){self._click($(this));});
        },
        _testResponse : function() {
          this.$container.find('.selectable').unbind('click');
          var nbOk = this.$container.find('.toselect.selected').length;
          var nbKo = this.$container.find('.selected').length - nbOk;
          var nb = this.$container.find('.toselect').length - nbOk;
          if(nbOk == this.nbQ && !nbKo){
						var params = {};
            params.analysis = '';
            if (nbOk){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk', nbOk);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk > 1 ? 's' : '');
            }
            if (nbKo) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbKo', nbKo);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo > 1 ? 's' : '');
            }
            if (nb>=1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nb', nb);
              params.analysis = params.analysis.replace(/\(s\)/g, nb > 1 ? 's' : '');
            }
            this._showResult('ok', params);
          }else{
            var params = {};
            params.analysis = '';
            if (nbOk){
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[0];
              params.analysis = params.analysis.replace('nbOk', nbOk);
              params.analysis = params.analysis.replace(/\(s\)/g, nbOk > 1 ? 's' : '');
            }
            if (nbKo) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[1];
              params.analysis = params.analysis.replace('nbKo', nbKo);
              params.analysis = params.analysis.replace(/\(s\)/g, nbKo > 1 ? 's' : '');
            }
            if (nb>=1) {
              params.analysis += (params.analysis?'<br/>':'')+this.tabTextResult[2];
              params.analysis = params.analysis.replace('nb', nb);
              params.analysis = params.analysis.replace(/\(s\)/g, nb > 1 ? 's' : '');
            }
						params.solution_type = 'dotted';
            this._showResult("ko", params);
          }
        },
        _solution: function() {
          var self = this;
          this.$container
            .find('.bad')
              .removeClass('bad selected')
              .addClass('myselection')
              .end()
            .find('.selectable')
              .unbind('click')
              .end()
            .find('.toselect')
              .filter(function(){if(!$(this).hasClass('selected')) return true;})
                .addClass('solution');
        },
        _replay: function() {
          var self = this;
          this.$container
            .find('.myselection')
              .removeClass('myselection')
              .addClass('selected')
              .end()
            .find('.toselect')
              .unbind('mouseenter')
              .unbind('mouseleave')
              .end()
            .find('.solution')
              .removeClass('solution')
              .end()
            .find('.selectable')
              .bind('click', function(){self._click($(this))})
              .end()
            .find('.selected')
              .filter(function(){if(!$(this).hasClass('toselect')) return true;})
                .addClass('bad')
							  .end()
							.filter(function(){if($(this).hasClass('toselect')) return true;})
                .addClass('good')
							
        },
        _click: function($obj) {
          $obj.toggleClass('selected');
					$obj.removeClass('bad');
					$obj.removeClass('good');
          //this.$container.find('.bad').removeClass('bad selected');
        },
				_redo : function(){
					var self = this;
          self.tabTextResult = [];
        }
      }
    );
    /**
     * GLISSER DEPOSER LEGENDES
     */
    $.widget(
      'demo.exercice_gdl',
      $.demo.exercice,
      {
        $img : null,
				$img_container : null,
        $captions : null,
        _init : function(){
          $.demo.exercice.prototype._init.call(this);
        },
        _create : function(){
          var self = this;
          $.demo.exercice.prototype._create.call(self);
          if(typeof(this.options.json) == 'undefined')
            return;
					
					this.$container.addClass('no-mobile');
					this.$container.data('cs', -1);
					this.$container.data('ps', -1);
					
					this.$captions = $('<div></div>')
						.appendTo(this.$container)
						.addClass('exercice_captions');
					var $exo_cont_img =  this.$container.parent().parent().find('.field--name-field-exercice-image');
					var $clone_img = $exo_cont_img
						.clone()
						.appendTo(this.$container);
						
					this.$img_container = $clone_img.find('.field--name-field-media-image');
					$exo_cont_img.hide();	
					this.$img = this.$img_container.find('img');
					this.$img_container.addClass('exercice_image');
					this.$myCaption = $('<div></div>')
						.addClass('exercice_mycaption')
						.appendTo(this.$img_container)
						.hide();
					
					var img_owidth = this.$img[0].naturalWidth; 
					var img_oheight = this.$img[0].naturalHeight;
					var img_width = this.$img.width(); 
					var img_height = this.$img.height();
					
					this.nbQ = this.options.json['items'].length;	
					for(var q=0; q<this.nbQ; q++){
						// captions text
						var $cptxt = $('<div></div>')
							.appendTo(self.$captions)
							.addClass('caption caption_' + q)
							.html('<div class="caption_content"><span class="prefix-content">' + (parseInt(q)+1) + '. </span><span class="c-content">' + this.options.json['items'][q]['caption_value'] + '</span></div')
							.data('q', q);
						self._captionClick($cptxt);

						// captions positions	
						var center_pos_top = parseInt(this.options.json['items'][q]['caption_left_top_y']) + ((this.options.json['items'][q]['caption_right_bottom_y'] - this.options.json['items'][q]['caption_left_top_y']) / 2);
						if(typeof(img_height) != 'undefined' && typeof(img_oheight) != 'undefined' && img_oheight != 0) {
							center_pos_top = center_pos_top*img_height/img_oheight;
						}
						center_pos_top = Math.round(center_pos_top);

						var center_pos_left = parseInt(this.options.json['items'][q]['caption_left_top_x']) + ((this.options.json['items'][q]['caption_right_bottom_x'] - this.options.json['items'][q]['caption_left_top_x']) / 2);
						if(typeof(img_width) != 'undefined' && typeof(img_owidth) != 'undefined' && img_owidth != 0) {
							center_pos_left = center_pos_left*img_width/img_owidth;
						}
						center_pos_left = Math.round(center_pos_left);
						
						var pos_decal = (is_mobile?12:30);
						
						
						var $poscpt = $('<div></div>')
							.appendTo(self.$img_container)
							.addClass('caption_layer layer_' + q)
							.data('q', q)
							.css({
								position:'absolute',
								top:(center_pos_top-pos_decal) + 'px',
								left:(center_pos_left-pos_decal) + 'px'
							});
						self._posClick($poscpt);							
					}
					
					// mobile
					if(is_mobile) {
						// add zoom button
						var $zoom = $('<button></button>')
							.insertAfter(self.$container.find('.field--name-field-exercice-image'))
							.html(Drupal.t('zoom'))
							.wrap('<div class="zoom-gdl"></div>')
							.bind('click', function() {
								var $this = $(this);
								var $field_image = self.$container.find('.field--name-field-exercice-image');

								if($field_image.length) {
									var $exercice_image = $field_image.find('.exercice_image');
									if($exercice_image.length) {
										if($field_image.hasClass('zoom')) {
										$field_image.removeClass('zoom');
										$exercice_image.draggable().draggable('destroy');
										$exercice_image.removeAttr('style');
										}
										else {
											$field_image.addClass('zoom');
											var offset_box_left = $field_image.offset().left;
											var offset_box_top = $field_image.offset().top;
											var zoom_width = $exercice_image[0].getBoundingClientRect().width;
											var zoom_height = $exercice_image[0].getBoundingClientRect().height;
											var box_width = $field_image.width();
											var box_height = $field_image.height();
											var x1 = offset_box_left - (zoom_width - box_width);
											var y1 = offset_box_top - (zoom_height - box_height);
											var x2 = offset_box_left;
											var y2 = offset_box_top;

											$exercice_image.draggable({
												containment: [x1, y1, x2, y2]
											});
										}
									}	
								}
							});							
					}	

        },
        _testResponse : function() {
					var nbOk = 0;
					$('.caption_layer').each(function(i) {
						var $this = $(this)
						var cid = $this.data('cid');
						var qid = $this.data('q');
						if(typeof(cid) != 'undefined') {
							// good
							if(cid === qid) {
								$this.addClass('good');
								$this.unbind('click');
								$('.caption.caption_' + cid).addClass('good');
								$('.caption.caption_' + cid).unbind('click');
								nbOk++;
							}
							// bad
							else {
								$this.addClass('bad');
								$('.caption.caption_' + cid).addClass('bad');
							}
						}
					});	
					
          if (nbOk == this.nbQ) {
            this._showResult('ok', {nbOk:nbOk, nb:this.nbQ});
          } else {
            this._showResult('ko', {nbOk:nbOk, nb:this.nbQ, solution_type:'hover'});
          }
        },
        _solution: function() {
          var self = this;
					self.$container.addClass('solution');
					$('.caption:not(.selected)').unbind('click');
					
					$('.caption_layer').each(function(i) {
						var $this = $(this)
						var cid = $this.data('cid');
						var qid = $this.data('q');
						// with response
						if(typeof(cid) != 'undefined') {
							// bad
							if(cid !== qid) {
								$this.unbind('mouseenter');
								$this.unbind('mouseleave');
								$('.caption.caption_' + cid + ' .remove-link').unbind('click');
								var $bclone = $this.clone();
								$bclone.appendTo(self.$img_container).addClass('clone');
								var $field_image = self.$container.find('.field--name-field-exercice-image');
								var clone_pos_left = $bclone.position().left;
								if($field_image.length && $field_image.hasClass('zoom')) {
									clone_pos_left = Math.round(clone_pos_left/1.8);
								}
								
								var pos_decal = (is_mobile?32:60);
								
								$bclone.css('left', clone_pos_left + pos_decal);
								$bclone.hide();
								$this.addClass('solution');
								$this.html(qid + 1);
								
								$this.bind({
									mouseenter:function(){
										var $this = $(this);
										self._showCaption($this, $('.caption_' + $this.data('q') + ' .c-content').html(), {valign:'bottom', align:'center'});
										$('.caption_layer.clone.layer_' + $this.data('q')).show();
										return false;
									},
									mouseleave:function(){
										self._hideCaption();
										$('.caption_layer.clone.layer_' + $this.data('q')).hide();
										return false;
									}
								});
							}	
						}
						// no response
						else {
							$this.unbind('click');
							$this.addClass('solution');
							$this.html(qid + 1);
							$this.bind({
								mouseenter:function(){
									var $this = $(this);
									self._showCaption($this, $('.caption_' + $this.data('q') + ' .c-content').html(), {valign:'bottom', align:'center'});
									return false;
								},
								mouseleave:function(){
									self._hideCaption();
									return false;
								}
							});
						}
					});
        },
        _replay: function() {
					var self = this;
					self.$container.removeClass('solution');
					self._captionClick($('.caption:not(.selected)'));
					
					$('.caption_layer').each(function(i) {
						var $this = $(this)
						var cid = $this.data('cid');
						var qid = $this.data('q');
						// with response
						if(typeof(cid) != 'undefined') {
							// bad
							if(cid !== qid) {
								$('.caption_layer.clone.layer_' + $this.data('q')).remove();
								$this.removeClass('solution');
								$('.caption.caption_' + cid + ' .remove-link').bind('click', function() {
									var $this = $(this);
									$this.parent().removeClass('selected bad');
									$('.caption_layer.layer_' + $this.parent().data('pid')).removeClass('selected bad');													
									$('.caption_layer.layer_' + $this.parent().data('pid')).removeData('cid');
									$('.caption_layer.layer_' + $this.parent().data('pid')).html('');
									$this.parent().removeData('pid');
									$this.remove();

									return false;
								});
								$this.unbind('mouseenter');
								$this.unbind('mouseleave');
								$this.bind({
									mouseenter:function(){
										self._showCaption($(this), $('.caption_' + $(this).data('cid') + ' .c-content').html(), {valign:'bottom', align:'center'});
										return false;
									},
									mouseleave:function(){
										self._hideCaption();
										return false;
									}
								});
								$this.html($('.caption.caption_' + cid).data('q') + 1);	
							}	
						}
						// no response
						else {
							self._posClick($this);
							$this.unbind('mouseenter');
							$this.unbind('mouseleave');
							$this.removeClass('solution');
							$this.html('');
						}
					});
        },
				_redo : function(){
					var self = this;
          self.$img = null;
					self.$img_container = null;
					self.$captions = null;
					self.$myCaption = null;
					$('.field--name-field-exercice-image').show();					
        },
				_captionClick:function($obj){
					var self = this;
					$obj.unbind('click').bind('click', function() {
						var $this = $(this);
						if(!$this.hasClass('selected')) {
							var pos_selected = self.$container.data('ps');
							// position selected (text or position)
							if(pos_selected != -1) {
								$this.addClass('selected');
								self.$container.data('ps', -1);
								$this.data('pid', pos_selected);
								$('.caption_layer.layer_' + pos_selected).removeClass('pre-selected');
								$('.caption_layer.layer_' + pos_selected).addClass('selected');
								$('.caption_layer.layer_' + pos_selected).data('cid', $this.data('q'));
								$('.caption_layer.layer_' + pos_selected).html(parseInt($this.data('q')) + 1);
								
								$('.caption_layer.layer_' + pos_selected).bind({
									mouseenter:function(){
										self._showCaption($(this), $('.caption_' + $(this).data('cid') + ' .c-content').html(), {valign:'bottom', align:'center'});
										return false;
									},
									mouseleave:function(){
										self._hideCaption();
										return false;
									}
								});

								// remove link btn
								var $remove_link = $('<div></div>')
									.addClass('remove-link')
									.appendTo($this)
									.bind('click', function() {
										var $this = $(this);
										$this.parent().removeClass('selected bad');
										$('.caption_layer.layer_' + $this.parent().data('pid')).removeClass('selected bad');													
										$('.caption_layer.layer_' + $this.parent().data('pid')).removeData('cid');
										$('.caption_layer.layer_' + $this.parent().data('pid')).html('');
										$this.parent().removeData('pid');
										$this.remove();

										return false;
									});
								
							}
							// no caption selected
							else {
								if($this.hasClass('pre-selected')) {
									$this.removeClass('pre-selected');
									self.$container.data('cs', -1);
								}
								else {
									$('.exercice_captions .caption').removeClass('pre-selected');
									$this.addClass('pre-selected');
									self.$container.data('cs', $this.data('q'));
								}
							}
						}		
					})
				},
				_posClick:function($obj){
					var self = this;
					$obj.unbind('click').bind('click', function() {
						var $this = $(this);
						if(!$this.hasClass('selected')) {
							var caption_selected = self.$container.data('cs');
							
							// caption selected
							if(caption_selected != -1) {
								$this.addClass('selected');
								self.$container.data('cs', -1);
								$('.caption_' + caption_selected).removeClass('pre-selected');
								$('.caption_' + caption_selected).addClass('selected');
								$('.caption_' + caption_selected).data('pid', $this.data('q'));
								$this.data('cid', $('.caption_' + caption_selected).data('q'));
								$this.html(parseInt($('.caption_' + caption_selected).data('q')) + 1);
								
								$this.bind({
									mouseenter:function(){
										self._showCaption($(this), $('.caption_' + $(this).data('cid') + ' .c-content').html(), {valign:'bottom', align:'center'});
										return false;
									},
									mouseleave:function(){
										self._hideCaption();
										return false;
									}
								});
								
								// remove link btn
								var $remove_link = $('<div></div>')
									.addClass('remove-link')
									.appendTo($('.caption_' + caption_selected))
									.bind('click', function() {
										var $this = $(this);
										$this.parent().removeClass('selected bad');
										$('.caption_layer.layer_' + $this.parent().data('pid')).removeClass('selected bad');													
										$('.caption_layer.layer_' + $this.parent().data('pid')).removeData('cid');
										$('.caption_layer.layer_' + $this.parent().data('pid')).html('');
										$this.parent().removeData('pid');
										$this.remove();

										return false;
									});
							}
							// no caption selected
							else {
								if($this.hasClass('pre-selected')) {
									$this.removeClass('pre-selected');
									self.$container.data('ps', -1);
								}
								else {
									$('.caption_layer').removeClass('pre-selected');
									$this.addClass('pre-selected');
									self.$container.data('ps', $this.data('q'));
								}
							}
						}	
					});
				},
				_showCaption:function($obj, myCaption, params){
					var self = this;
          if(!$obj.length || myCaption == null || myCaption == '')
            return false;
          var params = $.extend({
            valign:'top'
          },params);
					var $field_image = self.$container.find('.field--name-field-exercice-image');
          var pos = $obj.position();
          var left = pos.left
          var top = pos.top;
					var o_pos_left = pos.left;
					if($field_image.length && $field_image.hasClass('zoom')) {
						left = Math.round(left/1.8);
						top = Math.round(top/1.8);
						o_pos_left = Math.round(o_pos_left/1.8);
					}
					
          self.$myCaption.html('');
					if($obj.hasClass('solution')) {
						self.$myCaption.addClass('solution');
					}
          $('<div></div>').appendTo(self.$myCaption).addClass('exercice_mycaption_content').html(myCaption);
          switch(params.valign){
            case 'bottom':
              top += $obj.outerHeight() + 10;
              self.$myCaption.addClass('bottom');
              break;
          }
          if(typeof(params.top) != 'undefined')
            top += params.top;
          switch(params.align){
            case 'center':
              left = left - self.$myCaption.outerWidth()/2 + $obj.outerWidth()/2;
              this.$myCaption.addClass('center');
              break;	
          }
					if(left<0) {
						left=0;
					}
          self.$myCaption
            .css('position', 'absolute')
            .css('z-index', 100000)
            .css('top', top)
            .css('left', left)
            .show();
						
					var pos_decal = (is_mobile?9:27);	
					
					document.documentElement.style.setProperty('--caption-gdl-after-left', (o_pos_left - left + pos_decal) + 'px');
        },
        _hideCaption:function(){
					var self = this;
          self.$myCaption.hide();
					self.$myCaption.removeClass('solution');
        }
      }
    );
  });
})(Drupal, jQuery);
